---
import '../styles/global.css';
import SeasonalBackground from '../components/SeasonalBackground.astro';
import SeasonalAudio from '../components/SeasonalAudio.astro';
import GhostlyHands from '../components/GhostlyHands.astro';
import { getCurrentMonthKey } from '../lib/seasonalThemes';

interface Props {
  title: string;
  description?: string;
  ogImage?: string;
}

const {
  title,
  description = 'arcadelab — hand-crafted indie mini-games, built in the browser.',
  ogImage = '/og-cover.png',
} = Astro.props;

const canonicalURL = new URL(Astro.url.pathname, Astro.site ?? 'https://arcadelab.vercel.app');
const activeSeason = getCurrentMonthKey();
---

<!doctype html>
<html lang="en" class="antialiased" data-season-theme={activeSeason}>
  <head>
    <!-- ── Core meta ── -->
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover" />
    <meta name="generator" content={Astro.generator} />

    <!-- ── SEO ── -->
    <title>{title} | arcadelab.</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalURL} />

    <!-- ── Open Graph / Social ── -->
    <meta property="og:type"        content="website" />
    <meta property="og:url"         content={canonicalURL} />
    <meta property="og:title"       content={`${title} | arcadelab.`} />
    <meta property="og:description" content={description} />
    <meta property="og:image"       content={ogImage} />
    <meta name="twitter:card"       content="summary_large_image" />
    <meta name="twitter:title"      content={`${title} | arcadelab.`} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image"      content={ogImage} />

    <!-- ── Favicon ── -->
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />

    <!-- ── Google Fonts: Space Grotesk + Orbitron + Cinzel + Outfit + Inter + JetBrains Mono ── -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Cinzel:wght@600;700;800&family=Orbitron:wght@500;700;800&family=Outfit:wght@500;600;700&family=Space+Grotesk:wght@400;500;600;700&family=Inter:wght@400;500;600&family=JetBrains+Mono:wght@400;500&display=swap"
      rel="stylesheet"
    />
  </head>

  <body class="min-h-screen bg-[var(--color-base)] text-[var(--color-text)] relative selection:bg-[var(--color-brand)] selection:text-[#0b0e1b] overflow-x-hidden">

    <!-- Ambient Dynamic Seasonal Background Engine -->
    <SeasonalBackground />

    <!-- Ambient Soft Procedural Seasonal Melody Engine -->
    <SeasonalAudio />

    <!-- Spooky Jump Scare: Creeping Ghostly Hands -->
    <GhostlyHands />

    <!-- ═══════════════════════════════════════════════════════
         HEADER / NAVIGATION
    ═══════════════════════════════════════════════════════ -->
    <header class="border-b border-[var(--color-border)] bg-[var(--color-surface)]/95 sticky top-0 z-50 backdrop-blur-md">
      <div class="max-w-5xl mx-auto px-4 sm:px-6 h-14 flex items-center justify-between gap-3 sm:gap-4">

        <!-- Site wordmark -->
        <a
          href="/"
          id="site-logo"
          class="flex items-center gap-2 group focus-visible:outline-none shrink-0"
          aria-label="arcadelab home"
        >
          <span
            aria-hidden="true"
            class="block w-2 h-2 rounded-sm bg-[var(--color-brand)]
                   group-hover:scale-125 transition-transform duration-200"
          ></span>
          <span
            class="text-[var(--color-brand)] font-heading text-lg leading-none tracking-tight"
            style="font-family: var(--font-heading); font-weight: 700;"
          >
            arcadelab.
          </span>
        </a>

        <!-- Tagline (hidden on mobile) -->
        <p
          class="hidden md:block text-xs text-[var(--color-muted)] tracking-wide font-mono flex-1 text-center"
          style="font-family: var(--font-mono);"
        >
          built by hand.&nbsp;
          <span class="text-[var(--color-brand)] opacity-75">instant browser adrenaline.</span>
        </p>

        <!-- Desktop Nav links -->
        <nav aria-label="Main navigation" class="hidden sm:block">
          <ul class="flex items-center gap-1 list-none m-0 p-0">
            <li>
              <a
                href="/"
                id="nav-home"
                class="px-3 py-1.5 rounded text-sm text-[var(--color-muted)]
                       hover:text-[var(--color-text)] hover:bg-[var(--color-surface-2)]
                       transition-colors duration-150"
              >
                arcade
              </a>
            </li>
            <li>
              <a
                href="/games/space-dodge"
                id="nav-space-dodge"
                class="px-3 py-1.5 rounded text-sm text-[var(--color-muted)]
                       hover:text-[var(--color-text)] hover:bg-[var(--color-surface-2)]
                       transition-colors duration-150"
              >
                games
              </a>
            </li>
          </ul>
        </nav>

        <!-- Hamburger button (mobile only) -->
        <button
          id="mobile-menu-btn"
          aria-label="Toggle menu"
          aria-expanded="false"
          aria-controls="mobile-menu"
          class="sm:hidden flex items-center justify-center w-9 h-9 rounded-lg
                 text-[var(--color-muted)] hover:text-[var(--color-text)]
                 hover:bg-[var(--color-surface-2)] transition-colors duration-150
                 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-[var(--color-brand)]"
        >
          <!-- Hamburger icon -->
          <svg id="icon-menu" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <line x1="3" y1="6" x2="21" y2="6"/>
            <line x1="3" y1="12" x2="21" y2="12"/>
            <line x1="3" y1="18" x2="21" y2="18"/>
          </svg>
          <!-- Close icon (hidden by default) -->
          <svg id="icon-close" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="hidden">
            <line x1="18" y1="6" x2="6" y2="18"/>
            <line x1="6" y1="6" x2="18" y2="18"/>
          </svg>
        </button>

      </div>

      <!-- Mobile Drawer Menu -->
      <div
        id="mobile-menu"
        class="sm:hidden hidden border-t border-[var(--color-border)] bg-[var(--color-surface)] px-4 py-3 space-y-1"
        aria-label="Mobile navigation"
      >
        <a
          href="/"
          class="flex items-center gap-3 px-3 py-2.5 rounded-lg text-sm text-[var(--color-muted)]
                 hover:text-[var(--color-text)] hover:bg-[var(--color-surface-2)]
                 transition-colors duration-150"
        >
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M3 9l9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"/><polyline points="9 22 9 12 15 12 15 22"/></svg>
          Home
        </a>
        <a
          href="/games/space-dodge"
          class="flex items-center gap-3 px-3 py-2.5 rounded-lg text-sm text-[var(--color-muted)]
                 hover:text-[var(--color-text)] hover:bg-[var(--color-surface-2)]
                 transition-colors duration-150"
        >
          <span>🚀</span>
          Space Dodge
        </a>
        <a
          href="/games/shadow-protocol"
          class="flex items-center gap-3 px-3 py-2.5 rounded-lg text-sm text-[var(--color-muted)]
                 hover:text-[var(--color-text)] hover:bg-[var(--color-surface-2)]
                 transition-colors duration-150"
        >
          <span>⚔️</span>
          Shadow Protocol
        </a>
        <a
          href="/games/chroma-bloom"
          class="flex items-center gap-3 px-3 py-2.5 rounded-lg text-sm text-[var(--color-muted)]
                 hover:text-[var(--color-text)] hover:bg-[var(--color-surface-2)]
                 transition-colors duration-150"
        >
          <span>🌸</span>
          Chroma Bloom
        </a>
        <a
          href="/games/memory"
          class="flex items-center gap-3 px-3 py-2.5 rounded-lg text-sm text-[var(--color-muted)]
                 hover:text-[var(--color-text)] hover:bg-[var(--color-surface-2)]
                 transition-colors duration-150"
        >
          <span>🃏</span>
          Memory Match
        </a>
      </div>
    </header>

    <script is:inline>
      const btn = document.getElementById('mobile-menu-btn');
      const menu = document.getElementById('mobile-menu');
      const iconMenu = document.getElementById('icon-menu');
      const iconClose = document.getElementById('icon-close');
      if (btn && menu) {
        btn.addEventListener('click', () => {
          const isOpen = !menu.classList.contains('hidden');
          menu.classList.toggle('hidden', isOpen);
          iconMenu.classList.toggle('hidden', !isOpen);
          iconClose.classList.toggle('hidden', isOpen);
          btn.setAttribute('aria-expanded', String(!isOpen));
        });
      }
    </script>

    <!-- ═══════════════════════════════════════════════════════
         PAGE SLOT
    ═══════════════════════════════════════════════════════ -->
    <slot />

    <!-- ═══════════════════════════════════════════════════════
         FOOTER
    ═══════════════════════════════════════════════════════ -->
    <footer class="mt-24 border-t border-[var(--color-border)] py-8 px-4">
      <div class="max-w-4xl mx-auto flex flex-col sm:flex-row items-start sm:items-center justify-between gap-3">
        <p class="text-xs text-[var(--color-muted)]" style="font-family: var(--font-mono);">
          © {new Date().getFullYear()} arcadelab. — all games hand-coded.
        </p>
        <p class="text-xs text-[var(--color-muted)]">
          built with <a href="https://astro.build" target="_blank" rel="noopener" class="hover:text-[var(--color-brand)] transition-colors">Astro</a>
          + vanilla JS canvas.
        </p>
      </div>
    </footer>

  </body>
</html>

<style is:global>
  :root {
    --color-base:        #0d0814;
    --color-surface:     #170f24;
    --color-surface-2:   #211534;
    --color-text:        #f3eef8;
    --color-muted:       #9d8ea8;
    --color-brand:       #f59e0b;
    --color-accent:      #f97316;
    --color-border:      #35234d;

    --font-heading: 'Space Grotesk', 'Outfit', system-ui, sans-serif;
    --font-body:    'Inter', system-ui, sans-serif;
    --font-mono:    'JetBrains Mono', 'Fira Code', monospace;

    --headline-gradient: linear-gradient(135deg, #ffffff 0%, #fef08a 35%, #fbbf24 70%, #f59e0b 100%);
  }
</style>

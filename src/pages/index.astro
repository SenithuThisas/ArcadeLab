---
import Layout from '../layouts/Layout.astro';
---

<Layout
  title="Arcade"
  description="arcadelab — hand-crafted indie mini-games, built entirely in the browser with vanilla JavaScript and HTML5 Canvas."
>

  <main class="max-w-4xl mx-auto px-4 sm:px-6 py-12 space-y-16">

    <!-- ══════════════════════════════════════════════════════
         HERO — 16:9 video teaser placeholder
    ══════════════════════════════════════════════════════ -->
    <section aria-label="Featured teaser" class="space-y-4">
      <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-[var(--color-surface-2)] border border-[var(--color-border)]">
        <span class="relative flex h-2 w-2">
          <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-[var(--color-accent)] opacity-75"></span>
          <span class="relative inline-flex rounded-full h-2 w-2 bg-[var(--color-accent)]"></span>
        </span>
        <span class="text-xs font-mono text-[var(--color-muted)]" style="font-family:var(--font-mono);">
          arcade is live
        </span>
      </div>

      <h1 class="text-3xl sm:text-4xl text-[var(--color-text)]" style="font-family:var(--font-heading); font-weight:700;">
        hand-crafted games,<br />
        <span class="text-[var(--color-brand)]">no engines. no frameworks.</span>
      </h1>

      <p class="text-[var(--color-muted)] max-w-xl leading-relaxed">
        every pixel pushed manually. pure canvas, pure JS.
        new games drop regularly — follow along on YouTube.
      </p>

      <!-- 16:9 arcade-cabinet screen placeholder -->
      <div
        id="hero-teaser"
        class="relative w-full rounded-xl overflow-hidden border border-[var(--color-surface-2)]"
        style="aspect-ratio: 16/9;"
        role="img"
        aria-label="Game teaser video — coming soon"
      >
        <!-- Simulated scanlines + CRT glow -->
        <div class="absolute inset-0 bg-[var(--color-surface)]"></div>

        <!-- Grid pattern overlay -->
        <div
          class="absolute inset-0 opacity-[0.04]"
          style="background-image: linear-gradient(var(--color-muted) 1px, transparent 1px),
                                   linear-gradient(90deg, var(--color-muted) 1px, transparent 1px);
                 background-size: 32px 32px;"
        ></div>

        <!-- CRT inner shadow -->
        <div
          class="absolute inset-0 rounded-xl pointer-events-none"
          style="box-shadow: inset 0 0 80px rgba(0,0,0,0.7), inset 0 0 20px rgba(0,0,0,0.5);"
        ></div>

        <!-- Scanlines animation -->
        <div
          aria-hidden="true"
          class="absolute inset-0 pointer-events-none rounded-xl"
          style="background: repeating-linear-gradient(
            to bottom,
            transparent,
            transparent 3px,
            rgba(0,0,0,0.07) 3px,
            rgba(0,0,0,0.07) 4px
          );"
        ></div>

        <!-- Centre content -->
        <div class="absolute inset-0 flex flex-col items-center justify-center gap-4 text-center px-4">
          <div
            class="w-16 h-16 rounded-2xl border-2 border-[var(--color-brand)] flex items-center justify-center"
            style="box-shadow: 0 0 24px rgba(242,184,75,0.25);"
          >
            <!-- Play icon -->
            <svg width="24" height="24" viewBox="0 0 24 24" fill="none" aria-hidden="true">
              <path d="M8 5.14v14l11-7-11-7z" fill="var(--color-brand)"/>
            </svg>
          </div>
          <p class="text-[var(--color-muted)] text-sm font-mono" style="font-family:var(--font-mono);">
            gameplay teaser — uploading soon
          </p>
        </div>

        <!-- Corner accents -->
        <span aria-hidden="true" class="absolute top-3 left-3 w-4 h-4 border-t-2 border-l-2 border-[var(--color-brand)] opacity-60 rounded-tl"></span>
        <span aria-hidden="true" class="absolute top-3 right-3 w-4 h-4 border-t-2 border-r-2 border-[var(--color-brand)] opacity-60 rounded-tr"></span>
        <span aria-hidden="true" class="absolute bottom-3 left-3 w-4 h-4 border-b-2 border-l-2 border-[var(--color-brand)] opacity-60 rounded-bl"></span>
        <span aria-hidden="true" class="absolute bottom-3 right-3 w-4 h-4 border-b-2 border-r-2 border-[var(--color-brand)] opacity-60 rounded-br"></span>
      </div>
    </section>

    <!-- ══════════════════════════════════════════════════════
         GAME GRID
    ══════════════════════════════════════════════════════ -->
    <section aria-label="Game catalogue" class="space-y-6">
      <div class="flex items-center justify-between">
        <h2 class="text-xl text-[var(--color-text)]" style="font-family:var(--font-heading); font-weight:700;">
          the arcade
        </h2>
        <span class="text-xs font-mono text-[var(--color-muted)]" style="font-family:var(--font-mono);">
          2 games available
        </span>
      </div>

      <ul
        id="game-grid"
        class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 gap-4 list-none m-0 p-0"
        role="list"
      >
        <!-- ── CARD 1: Space Dodge (active) ───────────────────── -->
        <li role="listitem">
          <a
            href="/games/space-dodge"
            id="card-space-dodge"
            class="group block h-full rounded-xl border border-[var(--color-border)]
                   bg-[var(--color-surface)] p-5 space-y-4
                   transition-all duration-200 ease-out
                   hover:scale-[1.03] hover:border-[var(--color-accent)]
                   hover:shadow-[0_0_32px_rgba(77,217,240,0.12)]
                   focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-[var(--color-accent)]"
            aria-label="Play Space Dodge"
          >
            <!-- Game thumbnail placeholder -->
            <div
              class="w-full rounded-lg overflow-hidden"
              style="aspect-ratio:16/9; background: linear-gradient(135deg, #05070f 0%, #0d1326 50%, #05070f 100%);"
            >
              <div class="w-full h-full flex items-center justify-center relative">
                <!-- Particle dots -->
                <div class="absolute inset-0 flex items-center justify-center" aria-hidden="true">
                  <svg width="100%" height="100%" viewBox="0 0 160 90" preserveAspectRatio="xMidYMid slice">
                    <defs>
                      <linearGradient id="space-bg" x1="0" y1="0" x2="0" y2="1">
                        <stop offset="0" stop-color="#05070f"/>
                        <stop offset="1" stop-color="#0d1326"/>
                      </linearGradient>
                    </defs>
                    <rect width="160" height="90" fill="url(#space-bg)"/>
                    <!-- Stars -->
                    <g fill="#fff">
                      <circle cx="25" cy="18" r="1"/>
                      <circle cx="57" cy="9" r="1.6"/>
                      <circle cx="104" cy="22" r="1"/>
                      <circle cx="140" cy="12" r="1.6"/>
                      <circle cx="18" cy="55" r="1.6"/>
                      <circle cx="70" cy="60" r="1"/>
                      <circle cx="128" cy="50" r="1"/>
                      <circle cx="45" cy="76" r="1"/>
                    </g>
                    <!-- Distant planet -->
                    <circle cx="137" cy="88" r="30" fill="#1a2238"/>
                    <circle cx="130" cy="82" r="22" fill="#151c2e"/>
                    <!-- Asteroids -->
                    <ellipse cx="38" cy="22" rx="14" ry="10" fill="#56586a"/>
                    <ellipse cx="33" cy="19" rx="3" ry="2" fill="#13141c" opacity="0.8"/>
                    <ellipse cx="44" cy="26" rx="2.5" ry="1.8" fill="#13141c" opacity="0.7"/>
                    <ellipse cx="120" cy="64" rx="11" ry="8" fill="#47495b"/>
                    <ellipse cx="116" cy="62" rx="2.5" ry="1.8" fill="#13141c" opacity="0.7"/>
                    <!-- Player ship -->
                    <g transform="translate(80,52)">
                      <polygon points="0,-26 10,4 10,20 -10,20 -10,4" fill="#dde2f5"/>
                      <ellipse cx="0" cy="-8" rx="4.5" ry="6" fill="#2aa6c9"/>
                      <polygon points="-9,4 -17,19 -9,18" fill="#4dd9f0"/>
                      <polygon points="9,4 17,19 9,18" fill="#4dd9f0"/>
                      <polygon points="-5,19 0,30 5,19" fill="#ff8c42"/>
                    </g>
                  </svg>
                </div>
              </div>
            </div>

            <!-- Card body -->
            <div class="space-y-2">
              <div class="flex items-center gap-2">
                <span
                  class="text-[10px] font-mono px-2 py-0.5 rounded-full bg-[var(--color-surface-2)] border border-[var(--color-accent)] text-[var(--color-accent)]"
                  style="font-family:var(--font-mono);"
                >
                  playable
                </span>
              </div>

              <h3
                class="text-base text-[var(--color-text)] transition-colors duration-200
                       group-hover:text-[var(--color-accent)]"
                style="font-family:var(--font-heading); font-weight:700;"
              >
                Space Dodge
              </h3>

              <p class="text-xs text-[var(--color-muted)] leading-relaxed">
                pilot your ship through a procedural asteroid belt, dodge debris, and chase the deepest run. pure canvas, zero deps.
              </p>
            </div>

            <!-- Footer row -->
            <div class="flex items-center justify-between pt-1 border-t border-[var(--color-border)]">
              <span class="text-[10px] font-mono text-[var(--color-muted)]" style="font-family:var(--font-mono);">
                canvas · vanilla js
              </span>
              <svg
                width="14" height="14" viewBox="0 0 24 24" fill="none"
                class="text-[var(--color-accent)] opacity-0 group-hover:opacity-100 transition-opacity duration-200 -translate-x-1 group-hover:translate-x-0 transition-transform"
                aria-hidden="true"
              >
                <path d="M5 12h14M12 5l7 7-7 7" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
              </svg>
            </div>
          </a>
        </li>

        <!-- ── CARD 2: Shadow Fight: Arena of Shadows (active) ───────── -->
        <li role="listitem">
          <a
            href="/games/shadow-protocol"
            id="card-shadow-protocol"
            class="group block h-full rounded-xl border border-[var(--color-border)]
                   bg-[var(--color-surface)] p-5 space-y-4
                   transition-all duration-200 ease-out
                   hover:scale-[1.03] hover:border-[#f5b942]
                   hover:shadow-[0_0_32px_rgba(245,185,66,0.18)]
                   focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-[#f5b942]"
            aria-label="Play Shadow Fight: Arena of Shadows"
          >
            <!-- Game thumbnail -->
            <div
              class="w-full rounded-lg overflow-hidden"
              style="aspect-ratio:16/9; background: linear-gradient(180deg, #10040c 0%, #300a18 55%, #080a12 100%);"
            >
              <div class="w-full h-full flex items-center justify-center relative">
                <svg width="100%" height="100%" viewBox="0 0 160 90" preserveAspectRatio="xMidYMid slice">
                  <defs>
                    <linearGradient id="bg-sf-japan" x1="0" y1="0" x2="0" y2="1">
                      <stop offset="0%" stop-color="#120417"/>
                      <stop offset="45%" stop-color="#4a0e28"/>
                      <stop offset="75%" stop-color="#962d22"/>
                      <stop offset="90%" stop-color="#e67e22"/>
                      <stop offset="100%" stop-color="#fad390"/>
                    </linearGradient>
                    <linearGradient id="blade-glow" x1="0" y1="0" x2="1" y2="1">
                      <stop offset="0%" stop-color="#ffffff"/>
                      <stop offset="100%" stop-color="#00ff9d"/>
                    </linearGradient>
                  </defs>

                  <!-- 1. Sunset Sky Gradient -->
                  <rect width="160" height="90" fill="url(#bg-sf-japan)"/>

                  <!-- 2. Glowing Golden Sun -->
                  <circle cx="80" cy="36" r="22" fill="#ffeaa7" opacity="0.85"/>
                  <circle cx="80" cy="36" r="32" fill="none" stroke="#f39c12" stroke-width="1.2" opacity="0.35"/>

                  <!-- 3. Mt. Fuji Volcano & Snowcap -->
                  <polygon points="40,70 80,26 120,70" fill="#240c2e"/>
                  <polygon points="72,35 80,26 88,35 85,38 80,34 75,38" fill="#f8fafc"/>

                  <!-- 4. Five-Story Pagoda Silhouette (Far Left) -->
                  <g transform="translate(18, 70) scale(0.45)" fill="#0d0514">
                    <rect x="-12" y="-10" width="24" height="10"/>
                    <rect x="-8" y="-22" width="16" height="12"/>
                    <polygon points="-16,-22 0,-28 16,-22 14,-20 0,-25 -14,-20"/>
                    <rect x="-7" y="-34" width="14" height="12"/>
                    <polygon points="-14,-34 0,-39 14,-34 12,-32 0,-36 -12,-32"/>
                    <rect x="-6" y="-46" width="12" height="12"/>
                    <polygon points="-12,-46 0,-50 12,-46 10,-44 0,-47 -10,-44"/>
                    <line x1="0" y1="-50" x2="0" y2="-62" stroke="#f5b942" stroke-width="1.5"/>
                  </g>

                  <!-- 5. Shinto Torii Gate Silhouette (Far Right) -->
                  <g transform="translate(142, 70) scale(0.4)" fill="#b71540">
                    <rect x="-14" y="-36" width="28" height="3" rx="1"/>
                    <polygon points="-16,-40 0,-38 16,-40 14,-37 0,-35 -14,-37"/>
                    <rect x="-9" y="-36" width="3" height="36"/>
                    <rect x="6" y="-36" width="3" height="36"/>
                  </g>

                  <!-- 6. Ground Dojo Platform -->
                  <rect x="0" y="70" width="160" height="20" fill="#060912"/>
                  <line x1="0" y1="70" x2="160" y2="70" stroke="#f5b942" stroke-width="1" opacity="0.6"/>

                  <!-- 7. Ambient Sakura Petals -->
                  <circle cx="32" cy="24" r="1" fill="#ff76a6" opacity="0.8"/>
                  <circle cx="68" cy="18" r="1.3" fill="#ff9ebb" opacity="0.9"/>
                  <circle cx="125" cy="28" r="1.2" fill="#ff76a6" opacity="0.75"/>
                  <circle cx="95" cy="52" r="1" fill="#ffb8d1" opacity="0.85"/>

                  <!-- 8. Player: Navy Blue Anime Martial Arts Warrior (Left) -->
                  <g transform="translate(52, 70)">
                    <!-- Back Leg -->
                    <rect x="-8" y="-14" width="5" height="14" rx="2" fill="#0b1b38"/>
                    <rect x="-9" y="-4" width="6" height="4" fill="#2563eb"/>
                    <!-- Front Leg in dynamic lunge stance -->
                    <rect x="2" y="-12" width="5" height="12" rx="2" fill="#0b1b38" transform="rotate(20)"/>
                    <rect x="5" y="-3" width="7" height="4" fill="#2563eb"/>
                    <!-- Torso with Navy Blue Gi & Royal Blue Collar -->
                    <polygon points="-6,-13 6,-13 4,-26 -4,-26" fill="#0b1b38"/>
                    <line x1="-4" y1="-26" x2="1" y2="-17" stroke="#2563eb" stroke-width="1.2"/>
                    <polygon points="-2,-26 2,-26 0,-20" fill="#ffd5aa"/>
                    <!-- Navy Blue Sash Belt -->
                    <rect x="-5" y="-15" width="10" height="2.5" fill="#1d4ed8"/>
                    <!-- Head, Spiky Navy Hair & Glowing Cyan Eye -->
                    <circle cx="0" cy="-30" r="4.5" fill="#ffd5aa"/>
                    <path d="M-4,-29 L-6,-35 L-2,-34 L0,-38 L3,-33 L5,-34 L4,-29 Z" fill="#070f22"/>
                    <rect x="-4" y="-31" width="8" height="1.8" fill="#2563eb"/>
                    <!-- Headband Ribbon -->
                    <path d="M-4,-30 Q-9,-31 -13,-28" stroke="#2563eb" stroke-width="1.2" fill="none"/>
                    <circle cx="2" cy="-30" r="0.8" fill="#38bdf8"/>
                    <!-- Arms & Glowing Katana Blade Slash -->
                    <rect x="-2" y="-25" width="3.5" height="8" rx="1.5" fill="#0b1b38" transform="rotate(35)"/>
                    <circle cx="8" cy="-21" r="2" fill="#ffd5aa"/>
                    <!-- Katana Blade -->
                    <line x1="8" y1="-21" x2="26" y2="-34" stroke="#e2e8f0" stroke-width="1.8" stroke-linecap="round"/>
                    <line x1="9" y1="-21" x2="27" y2="-34" stroke="#00ff9d" stroke-width="1" stroke-linecap="round"/>
                  </g>

                  <!-- 9. Opponent: Master Ronin with Straw Hat & Naginata (Right) -->
                  <g transform="translate(108, 70) scale(-1, 1)">
                    <!-- Back Leg -->
                    <rect x="-8" y="-14" width="5" height="14" rx="2" fill="#1e3a2b"/>
                    <!-- Front Leg in martial arts combat stance -->
                    <rect x="2" y="-12" width="5" height="12" rx="2" fill="#1e3a2b" transform="rotate(18)"/>
                    <!-- Torso with Bamboo Green Robes -->
                    <polygon points="-6,-13 6,-13 4,-26 -4,-26" fill="#1e3a2b"/>
                    <polygon points="-2,-26 2,-26 0,-20" fill="#eec59a"/>
                    <!-- Brown Sash -->
                    <rect x="-5" y="-15" width="10" height="2.5" fill="#78350f"/>
                    <!-- Head & Conical Bamboo Straw Hat (Kasa) -->
                    <circle cx="0" cy="-30" r="4.5" fill="#eec59a"/>
                    <polygon points="-8,-30 0,-37 8,-30" fill="#78350f"/>
                    <line x1="-8" y1="-30" x2="8" y2="-30" stroke="#d97706" stroke-width="0.8"/>
                    <circle cx="2" cy="-30" r="0.8" fill="#ff0055"/>
                    <!-- Arms & Naginata Polearm Strike -->
                    <rect x="-2" y="-25" width="3.5" height="8" rx="1.5" fill="#1e3a2b" transform="rotate(30)"/>
                    <circle cx="8" cy="-21" r="2" fill="#eec59a"/>
                    <!-- Naginata Long Shaft & Curved Blade -->
                    <line x1="2" y1="-14" x2="26" y2="-33" stroke="#451a03" stroke-width="1.4" stroke-linecap="round"/>
                    <path d="M26,-33 Q31,-37 34,-34 L32,-32 Q28,-34 26,-33 Z" fill="#f1f5f9" stroke="#f5b942" stroke-width="0.8"/>
                  </g>

                  <!-- 10. Central Blade Clash Spark Burst -->
                  <circle cx="80" cy="40" r="3.5" fill="#ffffff"/>
                  <circle cx="80" cy="40" r="7" fill="none" stroke="#ffeaa7" stroke-width="1" opacity="0.8"/>
                  <line x1="72" y1="40" x2="88" y2="40" stroke="#ffd700" stroke-width="1.8"/>
                  <line x1="80" y1="32" x2="80" y2="48" stroke="#00ff9d" stroke-width="1.8"/>
                  <line x1="74" y1="34" x2="86" y2="46" stroke="#fff" stroke-width="1"/>
                </svg>
              </div>
            </div>

            <!-- Card body -->
            <div class="space-y-2">
              <div class="flex items-center gap-2">
                <span
                  class="text-[10px] font-mono px-2 py-0.5 rounded-full bg-[var(--color-surface-2)] border border-[#f5b942] text-[#f5b942]"
                  style="font-family:var(--font-mono);"
                >
                  playable
                </span>
              </div>

              <h3
                class="text-base text-[var(--color-text)] transition-colors duration-200
                       group-hover:text-[#f5b942]"
                style="font-family:var(--font-heading); font-weight:700;"
              >
                Shadow Fight: Arena
              </h3>

              <p class="text-xs text-[var(--color-muted)] leading-relaxed">
                2D 1v1 shadow martial arts duel. master punches, roundhouse kicks, katana slashes, and kusarigama chains.
              </p>
            </div>

            <!-- Footer row -->
            <div class="flex items-center justify-between pt-1 border-t border-[var(--color-border)]">
              <span class="text-[10px] font-mono text-[var(--color-muted)]" style="font-family:var(--font-mono);">
                canvas · 1v1 martial arts
              </span>
              <svg
                width="14" height="14" viewBox="0 0 24 24" fill="none"
                class="text-[#f5b942] opacity-0 group-hover:opacity-100 transition-opacity duration-200 -translate-x-1 group-hover:translate-x-0 transition-transform"
                aria-hidden="true"
              >
                <path d="M5 12h14M12 5l7 7-7 7" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
              </svg>
            </div>
          </a>
        </li>

        <!-- ── CARD 3: Coming Soon ─────────────────────────────── -->
        <li role="listitem" aria-hidden="true">
          <article
            id="card-coming-soon-2"
            class="h-full rounded-xl border border-dashed border-[var(--color-border)]
                   bg-[var(--color-surface)] p-5 space-y-4 opacity-50 pointer-events-none
                   select-none"
            aria-label="Coming soon game slot"
          >
            <div
              class="w-full rounded-lg"
              style="aspect-ratio:16/9; background:var(--color-surface-2);"
            ></div>
            <div class="space-y-2">
              <span class="text-[10px] font-mono px-2 py-0.5 rounded-full bg-[var(--color-surface-2)] border border-[var(--color-border)] text-[var(--color-muted)]"
                style="font-family:var(--font-mono);">
                soon
              </span>
              <h3 class="text-base text-[var(--color-muted)]" style="font-family:var(--font-heading); font-weight:700;">
                ??? — classified
              </h3>
              <p class="text-xs text-[var(--color-muted)] leading-relaxed">
                new game in development. stay tuned.
              </p>
            </div>
          </article>
        </li>
      </ul>
    </section>

  </main>

</Layout>

    <!-- ══════════════════════════════════════════════════════
         INTERACTIVE ARCADE PLAYGROUND SHOWCASE (Bottom Section)
    ══════════════════════════════════════════════════════ -->
    <section aria-label="Interactive arcade playground" class="space-y-3 pt-4">
      <div class="flex items-center justify-between">
        <div>
          <div class="text-xs font-mono text-[var(--color-brand)] uppercase tracking-wider">Canvas Engine Lab</div>
          <h3 class="text-lg sm:text-xl font-heading font-bold text-[var(--color-text)]">Interactive Particle Cosmos</h3>
        </div>
        <div class="text-[11px] font-mono text-[var(--color-muted)]">
          <span class="hidden sm:inline">💡 Click or drag cursor to spawn starbursts</span>
          <span class="sm:hidden">👆 Tap to interact</span>
        </div>
      </div>

      <div class="relative rounded-2xl overflow-hidden border border-[var(--color-border)] shadow-2xl bg-[var(--color-surface)] group">
        <div class="relative w-full aspect-[2/1] sm:aspect-[16/9] lg:aspect-[21/9] min-h-[180px] sm:min-h-[260px] overflow-hidden">
          <canvas id="heroCanvas" class="absolute inset-0 w-full h-full block cursor-pointer" style="touch-action: none;"></canvas>

          <!-- Floating Overlaid Game Showcase Pill -->
          <div class="absolute bottom-3 left-3 right-3 sm:bottom-4 sm:left-6 sm:right-auto flex items-center gap-2 sm:gap-3 p-2 sm:p-3 rounded-xl bg-[var(--color-base)]/90 backdrop-blur-md border border-[var(--color-border)] text-left shadow-lg">

  <!-- ══════════════════════════════════════════════════════
       INTERACTIVE HERO CANVAS SCRIPT
  ══════════════════════════════════════════════════════ -->
  <script is:inline>
    document.addEventListener('DOMContentLoaded', () => {
      // 1. Random Game Button
      const games = ['/games/chroma-bloom', '/games/shadow-protocol', '/games/space-dodge'];
      const btnRandom = document.getElementById('btn-random-game');
      const btnRandomMobile = document.getElementById('btn-random-game-mobile');
      function goRandomGame() {
        const target = games[Math.floor(Math.random() * games.length)];
        window.location.href = target;
      }
      if (btnRandom) btnRandom.addEventListener('click', goRandomGame);
      if (btnRandomMobile) btnRandomMobile.addEventListener('click', goRandomGame);

      // 2. Simulated Live Online Counter
      const onlineEl = document.getElementById('online-count');
      if (onlineEl) {
        let base = 38 + Math.floor(Math.random() * 75); // realistic 38–113 range
        onlineEl.textContent = base;
        setInterval(() => {
          base += Math.floor(Math.random() * 9) - 4; // drift ±4
          base = Math.max(18, Math.min(210, base));
          onlineEl.textContent = base;
        }, 5000);
      }

      // 3. Interactive Hero Canvas Particle & Simulation Loop
      const canvas = document.getElementById('heroCanvas');
      if (!canvas) return;
      const ctx = canvas.getContext('2d');
      let w = 0, h = 0;
      let dpr = 1;

      function resize() {
        const rect = canvas.getBoundingClientRect();
        dpr = Math.min(window.devicePixelRatio || 1, 2);
        w = rect.width;
        h = rect.height;
        canvas.width = Math.round(w * dpr);
        canvas.height = Math.round(h * dpr);
        ctx.scale(dpr, dpr);
      }
      resize();
      window.addEventListener('resize', resize);

      // Mouse tracking
      const mouse = { x: w * 0.5, y: h * 0.5, targetX: w * 0.5, targetY: h * 0.5, isOver: false };
      canvas.addEventListener('mousemove', (e) => {
        const r = canvas.getBoundingClientRect();
        mouse.targetX = e.clientX - r.left;
        mouse.targetY = e.clientY - r.top;
        mouse.isOver = true;
      });
      canvas.addEventListener('mouseleave', () => {
        mouse.isOver = false;
      });

      // Sparks & Particles with Dynamic Theme Palette
      let themePalette = ['#f2b84b', '#ff8c42', '#38dbf5', '#9d8df1', '#80ffdb'];
      const particles = [];
      for (let i = 0; i < 60; i++) {
        particles.push({
          x: Math.random() * (w || 800),
          y: Math.random() * (h || 350),
          vx: (Math.random() - 0.5) * 0.8,
          vy: (Math.random() - 0.5) * 0.8,
          radius: 1 + Math.random() * 2.5,
          color: themePalette[Math.floor(Math.random() * themePalette.length)],
          alpha: 0.2 + Math.random() * 0.6
        });
      }

      window.addEventListener('arcadelab-theme-change', () => {
        const brand = getComputedStyle(document.documentElement).getPropertyValue('--color-brand').trim();
        const accent = getComputedStyle(document.documentElement).getPropertyValue('--color-accent').trim();
        if (brand) themePalette = [brand, accent, '#ffffff', brand + 'cc', accent + 'cc'];
        particles.forEach(p => {
          p.color = themePalette[Math.floor(Math.random() * themePalette.length)];
        });
      });

      // Click ripple explosion
      canvas.addEventListener('click', (e) => {
        const r = canvas.getBoundingClientRect();
        const clickX = e.clientX - r.left;
        const clickY = e.clientY - r.top;
        for (let i = 0; i < 18; i++) {
          const angle = Math.random() * Math.PI * 2;
          const speed = 2 + Math.random() * 4;
          particles.push({
            x: clickX,
            y: clickY,
            vx: Math.cos(angle) * speed,
            vy: Math.sin(angle) * speed,
            radius: 2 + Math.random() * 2,
            color: themePalette[Math.floor(Math.random() * themePalette.length)],
            alpha: 1.0,
            decay: 0.025
          });
        }
      });

      // Animation Loop
      function render() {
        ctx.fillStyle = '#0a0d18';
        ctx.fillRect(0, 0, w, h);

        // Smooth mouse follow
        mouse.x += (mouse.targetX - mouse.x) * 0.1;
        mouse.y += (mouse.targetY - mouse.y) * 0.1;

        // Draw ambient glow under cursor
        const glow = ctx.createRadialGradient(mouse.x, mouse.y, 10, mouse.x, mouse.y, 180);
        glow.addColorStop(0, 'rgba(157, 141, 241, 0.22)');
        glow.addColorStop(0.5, 'rgba(242, 184, 75, 0.08)');
        glow.addColorStop(1, 'rgba(10, 13, 24, 0)');
        ctx.fillStyle = glow;
        ctx.fillRect(0, 0, w, h);

        // Grid lines
        ctx.strokeStyle = 'rgba(255, 255, 255, 0.03)';
        ctx.lineWidth = 1;
        for (let x = 0; x < w; x += 40) {
          ctx.beginPath(); ctx.moveTo(x, 0); ctx.lineTo(x, h); ctx.stroke();
        }
        for (let y = 0; y < h; y += 40) {
          ctx.beginPath(); ctx.moveTo(0, y); ctx.lineTo(w, y); ctx.stroke();
        }

        // Draw particles & links
        for (let i = 0; i < particles.length; i++) {
          const p = particles[i];
          p.x += p.vx;
          p.y += p.vy;

          if (p.decay) {
            p.alpha -= p.decay;
            if (p.alpha <= 0) {
              particles.splice(i, 1);
              i--;
              continue;
            }
          } else {
            if (p.x < 0) p.x = w;
            if (p.x > w) p.x = 0;
            if (p.y < 0) p.y = h;
            if (p.y > h) p.y = 0;
          }

          // Gravitate slightly to cursor
          if (mouse.isOver) {
            const dx = mouse.x - p.x;
            const dy = mouse.y - p.y;
            const d = Math.hypot(dx, dy);
            if (d < 140) {
              p.x += (dx / d) * 0.8;
              p.y += (dy / d) * 0.8;
            }
          }

          ctx.fillStyle = p.color;
          ctx.globalAlpha = p.alpha;
          ctx.beginPath();
          ctx.arc(p.x, p.y, p.radius, 0, Math.PI * 2);
          ctx.fill();
        }

        // Connecting lines between nearby particles
        for (let i = 0; i < particles.length; i++) {
          for (let j = i + 1; j < particles.length; j++) {
            const p1 = particles[i];
            const p2 = particles[j];
            const d = Math.hypot(p2.x - p1.x, p2.y - p1.y);
            if (d < 85) {
              ctx.strokeStyle = '#9d8df1';
              ctx.globalAlpha = (1 - d / 85) * 0.15;
              ctx.beginPath();
              ctx.moveTo(p1.x, p1.y);
              ctx.lineTo(p2.x, p2.y);
              ctx.stroke();
            }
          }
        }
        ctx.globalAlpha = 1.0;

        requestAnimationFrame(render);
      }
      requestAnimationFrame(render);
    });
  </script>

</Layout>

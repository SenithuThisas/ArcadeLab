---
import Layout from '../layouts/Layout.astro';
import { getCurrentTheme } from '../lib/seasonalThemes';

const currentTheme = getCurrentTheme();
---

<Layout
  title="ArcadeLab — Handcrafted Indie Browser Games"
  description="Instant, zero-install indie browser games crafted in pure JavaScript & HTML5 Canvas. Fast, beautiful, and ad-free."
>

  <main class="max-w-6xl mx-auto px-4 sm:px-6 py-8 sm:py-14 space-y-12 sm:space-y-20">

    <!-- ══════════════════════════════════════════════════════
         HERO SECTION: High-Energy, Interactive, Live Showcase
    ══════════════════════════════════════════════════════ -->
    <section aria-label="Arcade Hero Showcase" class="relative overflow-hidden pt-2 sm:pt-6 pb-2">

      <!-- Ambient Glow Blobs -->
      <div class="hidden lg:block absolute top-0 left-1/2 -translate-x-1/2 w-full max-w-3xl h-64 bg-gradient-to-r from-[#9d8df1]/15 via-[#f2b84b]/15 to-[#38dbf5]/15 blur-3xl pointer-events-none -z-10"></div>

      <div class="space-y-4 sm:space-y-6 text-center max-w-3xl mx-auto px-1">
        
        <!-- Live Seasonal & Status Badge -->
        <div class="inline-flex flex-wrap items-center justify-center gap-2 max-w-full">
          <div class="inline-flex items-center gap-1.5 sm:gap-2 px-3 py-1 sm:px-3.5 sm:py-1.5 rounded-full bg-[var(--color-surface)]/85 backdrop-blur-md border border-[var(--color-border)] shadow-sm hover:border-[var(--color-brand)]/50 transition-colors">
            <span class="relative flex h-2 w-2 flex-shrink-0">
              <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-[var(--color-brand)] opacity-75"></span>
              <span class="relative inline-flex rounded-full h-2 w-2 bg-[var(--color-brand)]"></span>
            </span>
            <span class="seasonal-badge-text text-[10px] sm:text-xs font-mono font-semibold tracking-wide text-[var(--color-brand)]">
              {currentTheme.badge}
            </span>
          </div>

          <div class="hidden sm:inline-flex items-center gap-2 px-3 py-1.5 rounded-full bg-[var(--color-surface-2)]/60 backdrop-blur-md border border-[var(--color-border)] text-[11px] font-mono text-[var(--color-muted)]">
            <span>3 Handcrafted Games</span>
            <span class="text-[var(--color-muted)] opacity-50">·</span>
            <span>60 FPS Native</span>
          </div>
        </div>

        <!-- Catchy Main Heading -->
        <h1 class="text-2xl xs:text-3xl sm:text-5xl md:text-6xl font-bold tracking-tight text-white leading-[1.18] sm:leading-[1.1] font-heading drop-shadow-[0_4px_24px_rgba(0,0,0,0.95)]">
          Hand-crafted games.<br />
          <span class="theme-headline-gradient">
            Instant adrenaline in your browser.
          </span>
        </h1>

        <!-- Subtitle -->
        <p class="text-zinc-200 text-xs sm:text-base md:text-lg max-w-xl mx-auto leading-relaxed drop-shadow-[0_2px_14px_rgba(0,0,0,0.95)] font-normal px-2">
          No heavy engines or bloated setups. Just pure HTML5 canvas physics, responsive controls, and silky smooth 60 FPS gameplay.
        </p>

        <!-- Quick CTAs -->
        <div class="pt-1 sm:pt-2 w-full">

          <!-- ─── MOBILE LAYOUT (<640px) ─── -->
          <div class="flex flex-col items-center gap-2 w-full max-w-xs xs:max-w-sm mx-auto sm:hidden">
            <!-- Primary Action: Full-width vibrant pill with clear CTA -->
            <a
              href="/games/space-dodge"
              id="hero-cta-featured-mobile"
              class="w-full py-2.5 px-4 rounded-full font-semibold text-xs xs:text-sm bg-gradient-to-r from-[#38dbf5] to-[#f2b84b] text-[#05070f] shadow-lg shadow-[#38dbf5]/20 active:scale-[0.98] transition-all flex items-center justify-center gap-2 whitespace-nowrap"
            >
              <span>🚀 Play Space Dodge</span>
              <span class="text-[9px] uppercase font-mono px-1.5 py-0.5 rounded bg-black/20 font-bold">Featured</span>
            </a>

            <!-- Secondary Actions: Balanced 2-column tactile buttons -->
            <div class="grid grid-cols-2 gap-2 w-full">
              <a
                href="/games/chroma-bloom"
                class="flex items-center justify-center gap-1 py-2 px-2.5 rounded-full bg-[var(--color-surface)] border border-[var(--color-border)] active:border-[#9d8df1]/60 text-[11px] xs:text-xs font-medium text-[var(--color-text)] active:scale-[0.98] transition-all whitespace-nowrap"
              >
                <span>🌸 Chroma Bloom</span>
                <span class="text-[8px] uppercase font-mono px-1 py-0.5 rounded bg-[#9d8df1]/20 text-[#9d8df1] font-bold">New</span>
              </a>

              <button
                id="btn-random-game-mobile"
                class="flex items-center justify-center gap-1 py-2 px-2.5 rounded-full bg-[var(--color-surface)] border border-[var(--color-border)] active:border-[var(--color-brand)]/60 text-[11px] xs:text-xs font-medium text-[var(--color-text)] active:scale-[0.98] transition-all whitespace-nowrap"
              >
                <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                  <path d="M21.5 2v6h-6M21.34 15.57a10 10 0 1 1-.57-8.38l5.67-5.67"/>
                </svg>
                <span>Surprise Me</span>
              </button>
            </div>
          </div>

          <!-- ─── DESKTOP / TABLET LAYOUT (≥640px) ─── -->
          <div class="hidden sm:flex flex-wrap items-center justify-center gap-3">
            <a
              href="/games/space-dodge"
              id="hero-cta-featured"
              class="px-6 py-3 rounded-full font-semibold text-sm bg-gradient-to-r from-[#38dbf5] to-[#f2b84b] text-[#05070f] shadow-lg shadow-[#38dbf5]/25 hover:shadow-xl hover:shadow-[#38dbf5]/40 hover:scale-[1.03] active:scale-[0.98] transition-all duration-200 inline-flex items-center gap-2"
            >
              <span>🚀 Play Space Dodge</span>
              <span class="text-[10px] uppercase font-mono px-1.5 py-0.5 rounded bg-black/20 font-bold">Featured</span>
            </a>

            <a
              href="/games/chroma-bloom"
              class="px-5 py-3 rounded-full font-semibold text-sm bg-[var(--color-surface)] border border-[var(--color-border)] hover:border-[#9d8df1] text-[var(--color-text)] hover:text-[#9d8df1] hover:scale-[1.03] active:scale-[0.98] transition-all duration-200 inline-flex items-center gap-2"
            >
              <span>🌸 Chroma Bloom</span>
              <span class="text-[10px] uppercase font-mono px-1.5 py-0.5 rounded bg-[#9d8df1]/20 text-[#9d8df1] font-bold">New</span>
            </a>

            <button
              id="btn-random-game"
              class="px-4 py-3 rounded-full font-semibold text-sm bg-[var(--color-surface)] border border-[var(--color-border)] hover:border-[var(--color-brand)] text-[var(--color-text)] hover:text-[var(--color-brand)] hover:scale-[1.03] active:scale-[0.98] transition-all duration-200 inline-flex items-center gap-2"
            >
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <path d="M21.5 2v6h-6M21.34 15.57a10 10 0 1 1-.57-8.38l5.67-5.67"/>
              </svg>
              <span>Surprise Me</span>
            </button>
          </div>

        </div>

        <!-- Trust Badges: single compact row -->
        <div class="flex flex-wrap items-center justify-center gap-3 sm:gap-6 pt-1 text-[10px] sm:text-xs font-mono text-[var(--color-muted)]">
          <div class="inline-flex items-center gap-1">
            <svg width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="var(--color-brand)" stroke-width="2"><polygon points="13 2 3 14 12 14 11 22 21 10 12 10 13 2"/></svg>
            <span>60 FPS Native</span>
          </div>
          <div class="inline-flex items-center gap-1">
            <svg width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="#48eed6" stroke-width="2"><circle cx="12" cy="12" r="10"/><polygon points="10 8 16 12 10 16 10 8"/></svg>
            <span>Pure Vanilla JS</span>
          </div>
          <div class="inline-flex items-center gap-1">
            <svg width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="#ff7597" stroke-width="2"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/></svg>
            <span>Instant Load (&lt;1s)</span>
          </div>
        </div>

      </div>

    </section>

    <!-- ══════════════════════════════════════════════════════
         GAME CATALOGUE GRID
    ══════════════════════════════════════════════════════ -->
    <section aria-label="Game catalogue" class="space-y-8" id="catalogue">
      
      <div class="flex flex-col sm:flex-row sm:items-end justify-between gap-4 border-b border-[var(--color-border)] pb-4">
        <div>
          <div class="text-xs font-mono text-[var(--color-brand)] uppercase tracking-wider">Play In Browser</div>
          <h2 class="text-2xl sm:text-3xl text-[var(--color-text)] font-heading font-bold mt-1">
            Featured Arcade Vault
          </h2>
        </div>
        <div class="flex items-center gap-2 text-xs font-mono text-[var(--color-muted)]">
          <span class="w-2 h-2 rounded-full bg-emerald-400"></span>
          <span>All 3 games updated & ready</span>
        </div>
      </div>

      <ul
        id="game-grid"
        class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 gap-6 list-none m-0 p-0"
        role="list"
      >
        <!-- ── CARD 1: Space Dodge (Retro High-Speed Arcade) ─────────── -->
        <li role="listitem">
          <a
            href="/games/space-dodge"
            id="card-space-dodge"
            class="group flex flex-col h-full rounded-2xl border border-[var(--color-border)]
                   bg-[var(--color-surface)] p-5 space-y-4
                   transition-all duration-300 ease-out
                   hover:scale-[1.03] hover:border-[#38dbf5]
                   hover:shadow-[0_12px_40px_rgba(56,219,245,0.22)]
                   focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-[#38dbf5]"
            aria-label="Play Space Dodge"
          >
            <!-- Thumbnail -->
            <div
              class="w-full rounded-xl overflow-hidden relative"
              style="aspect-ratio:16/9; background: linear-gradient(135deg, #05070f 0%, #0d1326 50%, #05070f 100%);"
            >
              <div class="w-full h-full flex items-center justify-center relative">
                <svg width="100%" height="100%" viewBox="0 0 160 90" preserveAspectRatio="xMidYMid slice">
                  <g fill="#fff">
                    <circle cx="25" cy="18" r="1"/>
                    <circle cx="57" cy="9" r="1.6"/>
                    <circle cx="104" cy="22" r="1"/>
                    <circle cx="140" cy="12" r="1.6"/>
                    <circle cx="18" cy="55" r="1.6"/>
                  </g>
                  <ellipse cx="38" cy="22" rx="14" ry="10" fill="#56586a"/>
                  <ellipse cx="120" cy="64" rx="11" ry="8" fill="#47495b"/>
                  <!-- Starfighter -->
                  <g transform="translate(80,52)">
                    <polygon points="0,-24 9,4 9,18 -9,18 -9,4" fill="#dde2f5"/>
                    <polygon points="-8,4 -15,17 -8,16" fill="#4dd9f0"/>
                    <polygon points="8,4 15,17 8,16" fill="#4dd9f0"/>
                    <polygon points="-4,17 0,26 4,17" fill="#ff8c42"/>
                  </g>
                </svg>
              </div>

              <!-- Quick Play Overlay on Hover -->
              <div class="absolute inset-0 bg-black/40 backdrop-blur-xs opacity-0 group-hover:opacity-100 transition-opacity flex items-center justify-center">
                <span class="px-4 py-2 rounded-full font-bold text-xs bg-[#38dbf5] text-[#03050b] shadow-lg transform translate-y-2 group-hover:translate-y-0 transition-transform">
                  Engage Thrusters →
                </span>
              </div>
            </div>

            <!-- Body -->
            <div class="space-y-2 flex-1">
              <div class="flex items-center justify-between gap-2">
                <span class="text-[10px] font-mono px-2.5 py-0.5 rounded-full bg-[#38dbf5]/10 border border-[#38dbf5]/30 text-[#38dbf5] font-semibold">
                  🚀 High-Speed Arcade
                </span>
                <span class="text-[10px] font-mono text-[var(--color-muted)]">Procedural</span>
              </div>

              <h3 class="text-lg text-[var(--color-text)] font-heading font-bold group-hover:text-[#38dbf5] transition-colors">
                Space Dodge
              </h3>

              <p class="text-xs text-[var(--color-muted)] leading-relaxed">
                Pilot an agile starfighter through procedural asteroid belts, rogue defense drones, and laser hazard gates.
              </p>
            </div>

            <!-- Card Footer -->
            <div class="flex items-center justify-between pt-3 border-t border-[var(--color-border)] text-[11px] font-mono text-[var(--color-muted)]">
              <span>Infinite Survival</span>
              <span class="text-[#38dbf5] group-hover:translate-x-1 transition-transform">Dodge →</span>
            </div>
          </a>
        </li>

        <!-- ── CARD 2: Shadow Fight: Arena (Action Martial Arts) ───────── -->
        <li role="listitem">
          <a
            href="/games/shadow-protocol"
            id="card-shadow-protocol"
            class="group flex flex-col h-full rounded-2xl border border-[var(--color-border)]
                   bg-[var(--color-surface)] p-5 space-y-4
                   transition-all duration-300 ease-out
                   hover:scale-[1.03] hover:border-[#f5b942]
                   hover:shadow-[0_12px_40px_rgba(245,185,66,0.22)]
                   focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-[#f5b942]"
            aria-label="Play Shadow Fight: Arena of Shadows"
          >
            <!-- Thumbnail -->
            <div
              class="w-full rounded-xl overflow-hidden relative"
              style="aspect-ratio:16/9; background: linear-gradient(180deg, #10040c 0%, #300a18 55%, #080a12 100%);"
            >
              <div class="w-full h-full flex items-center justify-center relative">
                <svg width="100%" height="100%" viewBox="0 0 160 90" preserveAspectRatio="xMidYMid slice">
                  <defs>
                    <linearGradient id="bg-sf-japan" x1="0" y1="0" x2="0" y2="1">
                      <stop offset="0%" stop-color="#120417"/>
                      <stop offset="60%" stop-color="#5a122e"/>
                      <stop offset="100%" stop-color="#f5b942"/>
                    </linearGradient>
                  </defs>

                  <rect width="160" height="90" fill="url(#bg-sf-japan)"/>
                  <circle cx="80" cy="36" r="20" fill="#ffeaa7" opacity="0.9"/>

                  <!-- Ground -->
                  <rect x="0" y="70" width="160" height="20" fill="#060912"/>
                  <line x1="0" y1="70" x2="160" y2="70" stroke="#f5b942" stroke-width="1"/>

                  <!-- Player Figure Left -->
                  <g transform="translate(54, 70)">
                    <rect x="-6" y="-14" width="4" height="14" rx="2" fill="#0b1b38"/>
                    <rect x="2" y="-12" width="4" height="12" rx="2" fill="#0b1b38" transform="rotate(20)"/>
                    <polygon points="-5,-13 5,-13 3,-25 -3,-25" fill="#0b1b38"/>
                    <circle cx="0" cy="-29" r="4" fill="#ffd5aa"/>
                    <line x1="6" y1="-20" x2="24" y2="-32" stroke="#00ff9d" stroke-width="1.8" stroke-linecap="round"/>
                  </g>

                  <!-- Opponent Figure Right -->
                  <g transform="translate(106, 70) scale(-1, 1)">
                    <rect x="-6" y="-14" width="4" height="14" rx="2" fill="#1e3a2b"/>
                    <rect x="2" y="-12" width="4" height="12" rx="2" fill="#1e3a2b" transform="rotate(18)"/>
                    <polygon points="-5,-13 5,-13 3,-25 -3,-25" fill="#1e3a2b"/>
                    <circle cx="0" cy="-29" r="4" fill="#eec59a"/>
                    <polygon points="-7,-29 0,-35 7,-29" fill="#78350f"/>
                    <line x1="2" y1="-14" x2="24" y2="-32" stroke="#f5b942" stroke-width="1.6" stroke-linecap="round"/>
                  </g>
                </svg>
              </div>

              <!-- Quick Play Overlay on Hover -->
              <div class="absolute inset-0 bg-black/40 backdrop-blur-xs opacity-0 group-hover:opacity-100 transition-opacity flex items-center justify-center">
                <span class="px-4 py-2 rounded-full font-bold text-xs bg-[#f5b942] text-[#0b0e1b] shadow-lg transform translate-y-2 group-hover:translate-y-0 transition-transform">
                  Enter Arena →
                </span>
              </div>
            </div>

            <!-- Body -->
            <div class="space-y-2 flex-1">
              <div class="flex items-center justify-between gap-2">
                <span class="text-[10px] font-mono px-2.5 py-0.5 rounded-full bg-[#f5b942]/10 border border-[#f5b942]/30 text-[#f5b942] font-semibold">
                  ⚔️ Martial Arts Duel
                </span>
                <span class="text-[10px] font-mono text-[var(--color-muted)]">Combos</span>
              </div>

              <h3 class="text-lg text-[var(--color-text)] font-heading font-bold group-hover:text-[#f5b942] transition-colors">
                Shadow Fight: Arena
              </h3>

              <p class="text-xs text-[var(--color-muted)] leading-relaxed">
                2D anime shadow warrior combat. Master katana slashes, roundhouse kicks, kusarigama chains, and ultimate shadow surges.
              </p>
            </div>

            <!-- Card Footer -->
            <div class="flex items-center justify-between pt-3 border-t border-[var(--color-border)] text-[11px] font-mono text-[var(--color-muted)]">
              <span>1v1 Fighting Engine</span>
              <span class="text-[#f5b942] group-hover:translate-x-1 transition-transform">Fight →</span>
            </div>
          </a>
        </li>

        <!-- ── CARD 3: Chroma Bloom (Soft Zen) ─────────────────────────── -->
        <li role="listitem">
          <a
            href="/games/chroma-bloom"
            id="card-chroma-bloom"
            class="group flex flex-col h-full rounded-2xl border border-[var(--color-border)]
                   bg-[var(--color-surface)] p-5 space-y-4
                   transition-all duration-300 ease-out
                   hover:scale-[1.03] hover:border-[#9d8df1]
                   hover:shadow-[0_12px_40px_rgba(157,141,241,0.22)]
                   focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-[#9d8df1]"
            aria-label="Play Chroma Bloom"
          >
            <!-- Thumbnail -->
            <div
              class="w-full rounded-xl overflow-hidden relative"
              style="aspect-ratio:16/9; background: radial-gradient(circle at center, #1b1638 0%, #0c0e1c 100%);"
            >
              <div class="w-full h-full flex items-center justify-center relative">
                <svg width="100%" height="100%" viewBox="0 0 160 90" preserveAspectRatio="xMidYMid slice">
                  <defs>
                    <radialGradient id="cb-glow-1" cx="50%" cy="50%" r="50%">
                      <stop offset="0%" stop-color="#ffffff"/>
                      <stop offset="40%" stop-color="#9d8df1" stop-opacity="0.8"/>
                      <stop offset="100%" stop-color="#9d8df1" stop-opacity="0"/>
                    </radialGradient>
                    <radialGradient id="cb-glow-2" cx="50%" cy="50%" r="50%">
                      <stop offset="0%" stop-color="#ffffff"/>
                      <stop offset="45%" stop-color="#ff9a76" stop-opacity="0.85"/>
                      <stop offset="100%" stop-color="#ff9a76" stop-opacity="0"/>
                    </radialGradient>
                  </defs>

                  <g stroke="rgba(255,255,255,0.06)" stroke-width="0.5">
                    <line x1="0" y1="20" x2="160" y2="20"/>
                    <line x1="0" y1="45" x2="160" y2="45"/>
                    <line x1="0" y1="70" x2="160" y2="70"/>
                  </g>

                  <circle cx="80" cy="42" r="28" fill="none" stroke="#9d8df1" stroke-width="0.8" stroke-dasharray="2,3" opacity="0.4"/>
                  <circle cx="80" cy="42" r="14" fill="url(#cb-glow-1)"/>
                  <circle cx="80" cy="42" r="6" fill="#ffffff"/>

                  <circle cx="36" cy="30" r="8" fill="#48eed6" opacity="0.7"/>
                  <circle cx="36" cy="30" r="3" fill="#ffffff"/>

                  <circle cx="124" cy="55" r="9" fill="url(#cb-glow-2)"/>
                  <circle cx="124" cy="55" r="4" fill="#ffffff"/>

                  <path d="M 80 78 Q 62 60 74 48 T 88 34 T 120 45" fill="none" stroke="#ffffff" stroke-width="1.8" stroke-linecap="round" opacity="0.9"/>
                  <circle cx="120" cy="45" r="3" fill="#ffffff"/>
                </svg>
              </div>

              <!-- Quick Play Overlay on Hover -->
              <div class="absolute inset-0 bg-black/40 backdrop-blur-xs opacity-0 group-hover:opacity-100 transition-opacity flex items-center justify-center">
                <span class="px-4 py-2 rounded-full font-bold text-xs bg-[#9d8df1] text-[#0b0e1b] shadow-lg transform translate-y-2 group-hover:translate-y-0 transition-transform">
                  Launch Game →
                </span>
              </div>
            </div>

            <!-- Body -->
            <div class="space-y-2 flex-1">
              <div class="flex items-center justify-between gap-2">
                <span class="text-[10px] font-mono px-2.5 py-0.5 rounded-full bg-[#9d8df1]/10 border border-[#9d8df1]/30 text-[#9d8df1] font-semibold">
                  🌸 Zen Cascade
                </span>
                <span class="text-[10px] font-mono text-[var(--color-muted)]">Web Audio</span>
              </div>

              <h3 class="text-lg text-[var(--color-text)] font-heading font-bold group-hover:text-[#9d8df1] transition-colors">
                Chroma Bloom
              </h3>

              <p class="text-xs text-[var(--color-muted)] leading-relaxed">
                Launch light orbs into orbital gravity wells, triggering harmonic ripple cascades and procedural crystal bell chords.
              </p>
            </div>

            <!-- Card Footer -->
            <div class="flex items-center justify-between pt-3 border-t border-[var(--color-border)] text-[11px] font-mono text-[var(--color-muted)]">
              <span>Frosted Soft UI</span>
              <span class="text-[#9d8df1] group-hover:translate-x-1 transition-transform">Play →</span>
            </div>
          </a>
        </li>
      </ul>

      <!-- ── In The Lab / Upcoming Drops Hint ── -->
      <div class="mt-8 rounded-2xl border border-dashed border-[var(--color-border)] bg-gradient-to-r from-[var(--color-surface)]/80 via-[var(--color-surface-2)]/40 to-[var(--color-surface)]/80 backdrop-blur-md p-6 sm:p-7 flex flex-col sm:flex-row items-start sm:items-center justify-between gap-5 transition-all duration-300 hover:border-[var(--color-brand)]/50 shadow-lg">
        <div class="flex items-start gap-4">
          <div class="w-11 h-11 rounded-xl bg-[var(--color-surface-2)] border border-[var(--color-border)] flex items-center justify-center text-xl shrink-0">
            🧪
          </div>
          <div class="space-y-1">
            <div class="flex items-center gap-2">
              <span class="text-[10px] font-mono font-bold uppercase tracking-wider px-2 py-0.5 rounded bg-[var(--color-brand)]/15 text-[var(--color-brand)] border border-[var(--color-brand)]/25">
                In The Lab
              </span>
              <span class="text-xs font-mono text-[var(--color-muted)]">Phase 2 Dropping Soon</span>
            </div>
            <h3 class="text-base font-heading font-bold text-[var(--color-text)]">
              More Handcrafted Games in Active Development
            </h3>
            <p class="text-xs text-[var(--color-muted)] leading-relaxed max-w-xl">
              These 3 initial titles are just the beginning of ArcadeLab. We're actively building new physics-driven puzzles, rhythm experiments, and arcade survival games in pure vanilla Canvas.
            </p>
          </div>
        </div>


              id="hero-spotlight-btn"
              href="/games/space-dodge"
              class="flex-shrink-0 px-3 py-1.5 rounded-lg text-xs font-bold bg-[var(--color-brand)] text-[#0b0e1b] hover:opacity-90 transition-opacity"

---
const title = 'Dig Deep';
const description = 'Pilot your rocket through asteroid fields. 5 lives. 3 difficulty levels. Pure canvas.';
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover" />
    <title>{title} | arcadelab.</title>
    <meta name="description" content={description} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@400;600;700&family=Inter:wght@400;500&family=JetBrains+Mono:wght@400;600&display=swap" rel="stylesheet" />
    <style>
      *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }
      :root {
        --color-base:    #0d0f14;
        --color-surface: #171a21;
        --color-text:    #eef1f5;
        --color-muted:   #8b93a1;
        --color-brand:   #f2b84b;
        --color-accent:  #ff8c42;
        --color-border:  #2a2f3d;
      }
      html, body {
        background: var(--color-base);
        color: var(--color-text);
        font-family: 'Inter', system-ui, sans-serif;
        min-height: 100dvh;
        -webkit-font-smoothing: antialiased;
      }
      .page { max-width: 900px; margin: 0 auto; padding: 16px; }
      nav a {
        color: var(--color-brand);
        font-size: 14px;
        text-decoration: none;
        display: inline-flex;
        align-items: center;
        gap: 4px;
        margin-bottom: 16px;
      }
      nav a:hover { text-decoration: underline; }

      /* ── game wrapper ── */
      #game-wrapper {
        position: relative;
        width: 100%;
        aspect-ratio: 16/9;
        border-radius: 14px;
        overflow: hidden;
        background: #05070f;
        box-shadow: 0 0 0 1px #2a2f3d, 0 24px 60px rgba(0,0,0,0.7),
                    0 0 80px rgba(255,140,66,0.08);
      }
      canvas { display: block; width: 100%; height: 100%; }

      /* ── HUD bar ── */
      #hud {
        position: absolute;
        top: 0; left: 0; right: 0;
        display: flex;
        align-items: center;
        justify-content: space-between;
        padding: 6px 12px;
        background: rgba(5,7,16,0.72);
        backdrop-filter: blur(8px);
        -webkit-backdrop-filter: blur(8px);
        border-bottom: 1px solid rgba(255,255,255,0.06);
        font-family: 'JetBrains Mono', monospace;
        font-size: 12px;
        z-index: 10;
        gap: 8px;
      }
      #ui-lives { display: flex; gap: 2px; letter-spacing: 1px; }
      #hud-center { color: var(--color-text); white-space: nowrap; }
      #ui-score { color: var(--color-accent); font-weight: 700; }
      #ui-high  { color: var(--color-muted); }

      select#ui-difficulty {
        background: #1c2030;
        color: var(--color-text);
        border: 1px solid var(--color-border);
        border-radius: 6px;
        padding: 2px 6px;
        font-size: 11px;
        font-family: 'Inter', sans-serif;
        cursor: pointer;
        outline: none;
      }
      select#ui-difficulty:focus { border-color: var(--color-accent); }

      /* ── instructions below canvas ── */
      .instructions {
        margin-top: 12px;
        display: flex;
        gap: 12px;
        flex-wrap: wrap;
        font-size: 12px;
        color: var(--color-muted);
      }
      .instructions span { display: inline-flex; align-items: center; gap: 4px; }

      /* ── mobile: stack nicely ── */
      @media (max-width: 480px) {
        #hud { font-size: 10px; padding: 4px 8px; }
        #hud-center { font-size: 10px; }
      }
    </style>
  </head>
  <body>
    <div class="page">
      <nav><a href="/">← Arcade</a></nav>

      <section id="game-wrapper">
        <!-- HUD -->
        <div id="hud">
          <div id="ui-lives"></div>
          <div id="hud-center">
            🚀 <span id="ui-score">0</span>m alt &nbsp;·&nbsp; 🏆 <span id="ui-high">0</span>m
          </div>
          <select id="ui-difficulty">
            <option value="easy">🟢 Easy</option>
            <option value="medium" selected>🟡 Medium</option>
            <option value="hard">🔴 Hard</option>
          </select>
        </div>
        <canvas id="gameCanvas"></canvas>
      </section>

      <div class="instructions">
        <span>🖱️ Move mouse / drag finger to steer</span>
        <span>🖱️ Hold to thrust down</span>
        <span>💥 Avoid asteroids</span>
        <span>❤️ 5 lives</span>
      </div>
    </div>

    <script src="/dig-deep-engine.js" defer></script>
  </body>
</html>

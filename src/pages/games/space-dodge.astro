---
const title = 'Space Dodge: Starfighter Odyssey';
const description = 'Pilot an advanced starfighter through high-density procedural asteroid belts and rogue drone sectors. Pure canvas, high-performance physics.';
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover, user-scalable=no" />
    <title>{title} | arcadelab.</title>
    <meta name="description" content={description} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Orbitron:wght@500;700;900&family=Space+Grotesk:wght@400;600;700&family=Inter:wght@400;500;600&family=JetBrains+Mono:wght@400;600;700&display=swap" rel="stylesheet" />
    <style is:global>
      *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }

      :root {
        --color-base:    #03050b;
        --color-surface: #0a0e1a;
        --color-surface-2: #141a2d;
        --color-text:    #eef1f5;
        --color-muted:   #8893a7;
        --color-brand:   #f5b942;
        --color-accent:  #38dbf5;
        --color-shield:  #3b82f6;
        --color-danger:  #ff4154;
        --color-energy:  #a855f7;
        --color-success: #10b981;
        --color-border:  rgba(255, 255, 255, 0.1);
        --nav-h: 52px;
      }

      html, body {
        height: 100%;
        background: var(--color-base);
        color: var(--color-text);
        font-family: 'Inter', system-ui, sans-serif;
        -webkit-font-smoothing: antialiased;
        overflow: hidden;
        user-select: none;
        -webkit-user-select: none;
      }

      /* ── slim top nav ── */
      .game-nav {
        height: var(--nav-h);
        display: flex;
        align-items: center;
        justify-content: space-between;
        padding: 0 16px;
        border-bottom: 1px solid rgba(255, 255, 255, 0.08);
        background: rgba(5, 8, 15, 0.88);
        backdrop-filter: blur(20px);
        -webkit-backdrop-filter: blur(20px);
        flex-shrink: 0;
        z-index: 40;
        gap: 12px;
      }

      .game-nav-left {
        display: flex;
        align-items: center;
        gap: 10px;
        min-width: 0;
        flex-wrap: nowrap;
      }

      .back-pill-btn {
        color: var(--color-text);
        font-size: 12px;
        font-weight: 600;
        text-decoration: none;
        display: inline-flex;
        align-items: center;
        gap: 6px;
        padding: 6px 14px;
        border-radius: 9999px;
        background: rgba(255, 255, 255, 0.06);
        backdrop-filter: blur(16px);
        -webkit-backdrop-filter: blur(16px);
        border: 1px solid rgba(255, 255, 255, 0.12);
        box-shadow: inset 0 1px 1px rgba(255, 255, 255, 0.15), 0 2px 8px rgba(0, 0, 0, 0.2);
        white-space: nowrap;
        transition: all 0.22s cubic-bezier(0.16, 1, 0.3, 1);
      }
      .back-pill-btn:hover {
        background: rgba(255, 255, 255, 0.12);
        border-color: rgba(255, 255, 255, 0.25);
        transform: translateX(-2px);
      }

      .sector-badge {
        font-family: 'Orbitron', monospace;
        font-size: 11px;
        font-weight: 700;
        letter-spacing: 0.05em;
        color: #fff;
        background: rgba(255, 255, 255, 0.06);
        border: 1px solid rgba(255, 255, 255, 0.12);
        box-shadow: inset 0 1px 1px rgba(255, 255, 255, 0.15), 0 2px 8px rgba(0, 0, 0, 0.2);
        padding: 5px 12px;
        border-radius: 9999px;
        text-transform: uppercase;
        cursor: pointer;
        transition: all 0.22s cubic-bezier(0.16, 1, 0.3, 1);
        white-space: nowrap;
      }
      .sector-badge:hover {
        background: rgba(56, 219, 245, 0.18);
        border-color: var(--color-accent);
        box-shadow: 0 0 14px rgba(56, 219, 245, 0.35);
        transform: translateY(-1px);
      }

      .nav-actions {
        display: flex;
        align-items: center;
        gap: 8px;
        flex-shrink: 0;
      }

      .nav-btn {
        background: rgba(255, 255, 255, 0.05);
        border: 1px solid rgba(255, 255, 255, 0.1);
        color: var(--color-text);
        padding: 5px 10px;
        border-radius: 9999px;
        font-size: 12px;
        font-weight: 600;
        cursor: pointer;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 5px;
        transition: all 0.2s cubic-bezier(0.16, 1, 0.3, 1);
        white-space: nowrap;
        height: 32px;
      }
      .nav-btn:hover {
        background: rgba(255, 255, 255, 0.12);
        border-color: rgba(255, 255, 255, 0.25);
        transform: translateY(-1px);
      }
      .nav-btn.gold {
        color: var(--color-brand);
        background: rgba(245, 185, 66, 0.08);
        border-color: rgba(245, 185, 66, 0.28);
        padding: 0 12px;
        font-family: 'Orbitron', monospace;
        font-size: 11px;
      }
      .nav-btn.gold:hover {
        background: rgba(245, 185, 66, 0.18);
        border-color: var(--color-brand);
        box-shadow: 0 0 12px rgba(245, 185, 66, 0.3);
      }
      .nav-btn.toggle-mission {
        border-color: rgba(56, 219, 245, 0.3);
        color: var(--color-accent);
        background: rgba(56, 219, 245, 0.08);
        padding: 0 12px;
        font-weight: 600;
      }
      .nav-btn.toggle-mission:hover {
        background: rgba(56, 219, 245, 0.18);
        border-color: var(--color-accent);
        box-shadow: 0 0 12px rgba(56, 219, 245, 0.3);
      }
      .nav-icon-btn {
        width: 32px;
        height: 32px;
        padding: 0;
        border-radius: 9999px;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        font-size: 13px;
      }

      @media (max-width: 640px) {
        .game-nav {
          padding: 0 10px;
          gap: 6px;
        }
        .game-nav-left {
          gap: 6px;
        }
        .back-pill-btn {
          padding: 5px 10px;
          font-size: 11px;
        }
        .nav-btn {
          padding: 4px 8px;
          font-size: 11px;
        }
      }

      /* ── shell: column flex ── */
      .game-shell {
        display: flex;
        flex-direction: column;
        height: calc(100dvh - var(--nav-h));
        position: relative;
      }

      /* ── game wrapper ── */
      #game-wrapper {
        position: relative;
        flex: 1 1 auto;
        min-height: 0;
        overflow: hidden;
        background: #03050b;
      }

      canvas {
        display: block;
        width: 100%;
        height: 100%;
        outline: none;
      }

      /* ── HUD overlay ── */
      #hud {
        position: absolute;
        top: 0; left: 0; right: 0;
        display: flex;
        flex-direction: column;
        padding: 12px 18px 6px;
        background: linear-gradient(180deg, rgba(3, 5, 11, 0.92) 0%, rgba(3, 5, 11, 0.4) 75%, transparent 100%);
        backdrop-filter: blur(8px);
        -webkit-backdrop-filter: blur(8px);
        border-bottom: 1px solid rgba(56, 219, 245, 0.12);
        font-family: 'JetBrains Mono', monospace;
        font-size: 12px;
        z-index: 20;
        pointer-events: none;
        gap: 6px;
      }

      #hud > * { pointer-events: auto; }

      .hud-main-row {
        display: flex;
        align-items: center;
        justify-content: space-between;
        width: 100%;
      }

      .hud-cluster {
        display: flex;
        align-items: center;
        gap: 12px;
      }

      /* Gauges */
      .gauge-box {
        display: flex;
        flex-direction: column;
        gap: 2px;
      }
      .gauge-label {
        font-size: 9px;
        font-weight: 700;
        letter-spacing: 0.05em;
        color: var(--color-muted);
        text-transform: uppercase;
      }
      .gauge-bar-bg {
        width: 68px;
        height: 6px;
        background: rgba(255, 255, 255, 0.08);
        border: 1px solid rgba(255, 255, 255, 0.12);
        border-radius: 3px;
        overflow: hidden;
      }
      .gauge-bar-fill {
        height: 100%;
        width: 100%;
        transition: width 0.15s ease-out;
      }
      .gauge-shield { background: linear-gradient(90deg, #2563eb, #38dbf5); box-shadow: 0 0 8px rgba(56, 219, 245, 0.6); }
      .gauge-boost  { background: linear-gradient(90deg, #f59e0b, #f5b942); box-shadow: 0 0 8px rgba(245, 185, 66, 0.6); }

      #hud-center {
        display: flex;
        align-items: center;
        gap: 14px;
        font-family: 'Orbitron', monospace;
      }
      .hud-metric {
        display: flex;
        align-items: baseline;
        gap: 3px;
      }
      .metric-val {
        font-size: 14px;
        font-weight: 700;
        color: var(--color-text);
      }
      .metric-val.score { color: var(--color-accent); text-shadow: 0 0 10px rgba(56, 219, 245, 0.5); }
      .metric-val.minerals { color: var(--color-brand); }
      .metric-unit { font-size: 10px; color: var(--color-muted); }

      .emp-timer {
        font-family: 'Orbitron', monospace;
        font-size: 8px;
        font-weight: 700;
        color: var(--color-energy);
        text-shadow: 0 0 6px rgba(168, 85, 247, 0.6);
        background: rgba(168, 85, 247, 0.15);
        border: 1px solid rgba(168, 85, 247, 0.3);
        border-radius: 3px;
        padding: 0 4px;
        line-height: 12px;
      }

      .emp-pills {
        display: flex;
        gap: 4px;
        align-items: center;
      }
      .emp-icon {
        width: 10px;
        height: 10px;
        border-radius: 50%;
        background: var(--color-energy);
        box-shadow: 0 0 6px rgba(168, 85, 247, 0.8);
        position: relative;
        overflow: hidden;
      }
      .emp-icon.empty {
        background: rgba(255,255,255,0.1);
        box-shadow: none;
      }
      .emp-icon.charging {
        background: rgba(255,255,255,0.12);
        box-shadow: 0 0 4px rgba(168, 85, 247, 0.3);
      }
      .emp-icon-fill {
        position: absolute;
        bottom: 0;
        left: 0;
        width: 100%;
        background: var(--color-energy);
        box-shadow: 0 0 6px rgba(168, 85, 247, 0.8);
      }

      /* Sector Progress Bar */
      .sector-progress-bar-wrap {
        display: flex;
        align-items: center;
        gap: 8px;
        width: 100%;
      }
      .sector-progress-label {
        font-family: 'Orbitron', monospace;
        font-size: 9px;
        font-weight: 700;
        color: var(--color-accent);
        white-space: nowrap;
        letter-spacing: 0.05em;
      }
      .sector-progress-bg {
        flex: 1;
        height: 4px;
        background: rgba(255, 255, 255, 0.06);
        border-radius: 2px;
        overflow: hidden;
        border: 1px solid rgba(56, 219, 245, 0.15);
      }
      .sector-progress-fill {
        height: 100%;
        width: 0%;
        background: linear-gradient(90deg, #38dbf5, #f5b942);
        box-shadow: 0 0 8px rgba(245, 185, 66, 0.6);
        transition: width 0.1s ease-out;
      }

      /* ── Achievement Toast Notifications ── */
      #achievement-toast {
        position: absolute;
        top: 70px;
        right: 16px;
        background: linear-gradient(135deg, rgba(14, 20, 36, 0.95), rgba(8, 12, 24, 0.95));
        border: 1px solid var(--color-brand);
        box-shadow: 0 0 24px rgba(245, 185, 66, 0.35), 0 12px 30px rgba(0,0,0,0.8);
        border-radius: 10px;
        padding: 12px 16px;
        display: flex;
        align-items: center;
        gap: 12px;
        z-index: 60;
        transform: translateX(120%);
        transition: transform 0.4s cubic-bezier(0.175, 0.885, 0.32, 1.275);
        pointer-events: none;
        backdrop-filter: blur(10px);
        max-width: 320px;
      }
      #achievement-toast.show {
        transform: translateX(0);
      }
      .toast-icon {
        font-size: 26px;
        line-height: 1;
        filter: drop-shadow(0 0 8px rgba(245, 185, 66, 0.6));
      }
      .toast-content {
        display: flex;
        flex-direction: column;
        gap: 2px;
      }
      .toast-tag {
        font-family: 'Orbitron', monospace;
        font-size: 9px;
        font-weight: 700;
        color: var(--color-brand);
        letter-spacing: 0.1em;
        text-transform: uppercase;
      }
      .toast-title {
        font-family: 'Space Grotesk', sans-serif;
        font-size: 13px;
        font-weight: 700;
        color: var(--color-text);
      }
      .toast-desc {
        font-size: 11px;
        color: var(--color-muted);
      }

      /* ── hint strip pinned at bottom ── */
      .hints {
        flex-shrink: 0;
        display: flex;
        align-items: center;
        justify-content: space-between;
        padding: 8px 16px;
        font-size: 11px;
        color: var(--color-muted);
        border-top: 1px solid var(--color-border);
        background: var(--color-surface);
        z-index: 20;
      }
      .hints-keys {
        display: flex;
        align-items: center;
        gap: 12px;
        flex-wrap: wrap;
      }
      .hints-keys kbd {
        background: var(--color-surface-2);
        border: 1px solid var(--color-border);
        border-radius: 4px;
        padding: 1px 5px;
        font-family: 'JetBrains Mono', monospace;
        font-size: 10px;
        color: var(--color-text);
      }

      /* Mobile on-screen control overlay (Active on mobile portrait & touch screens) */
      #touch-controls {
        display: flex;
        position: absolute;
        bottom: calc(10px + env(safe-area-inset-bottom, 0px));
        left: 0; right: 0;
        padding: 0 16px;
        justify-content: space-between;
        align-items: flex-end;
        pointer-events: none;
        z-index: 30;
      }
      .touch-action-btn {
        pointer-events: auto;
        width: 58px;
        height: 58px;
        border-radius: 50%;
        background: rgba(10, 14, 26, 0.88);
        border: 2px solid rgba(56, 219, 245, 0.5);
        backdrop-filter: blur(8px);
        -webkit-backdrop-filter: blur(8px);
        color: #fff;
        font-family: 'Orbitron', monospace;
        font-size: 9.5px;
        font-weight: 700;
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        gap: 1px;
        box-shadow: 0 4px 16px rgba(0,0,0,0.6);
        touch-action: manipulation;
        user-select: none;
      }
      .touch-action-btn:active {
        transform: scale(0.92);
        background: rgba(56, 219, 245, 0.3);
      }
      .touch-action-btn.boost {
        border-color: rgba(245, 185, 66, 0.7);
        box-shadow: 0 0 12px rgba(245, 185, 66, 0.3);
      }
      .touch-action-btn.emp {
        width: 50px;
        height: 50px;
        border-color: rgba(168, 85, 247, 0.7);
        font-size: 8.5px;
        box-shadow: 0 0 12px rgba(168, 85, 247, 0.3);
      }

      /* Modals (Achievements, Level Select, Pause, Level Complete) */
      .game-modal {
        display: none;
        position: absolute;
        inset: 0;
        background: rgba(3, 5, 11, 0.88);
        backdrop-filter: blur(12px);
        -webkit-backdrop-filter: blur(12px);
        z-index: 50;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        padding: 16px;
      }
      .game-modal.active { display: flex !important; }

      .modal-card {
        background: var(--color-surface);
        border: 1px solid var(--color-border);
        border-radius: 14px;
        padding: 24px;
        width: 100%;
        max-width: 480px;
        max-height: 85vh;
        overflow-y: auto;
        box-shadow: 0 20px 50px rgba(0, 0, 0, 0.9), 0 0 50px rgba(56, 219, 245, 0.1);
        display: flex;
        flex-direction: column;
        gap: 16px;
      }
      .modal-header {
        display: flex;
        align-items: center;
        justify-content: space-between;
        border-bottom: 1px solid var(--color-border);
        padding-bottom: 12px;
      }
      .modal-title {
        font-family: 'Orbitron', monospace;
        font-size: 18px;
        font-weight: 700;
        color: var(--color-accent);
      }
      .modal-close {
        background: transparent;
        border: none;
        color: var(--color-muted);
        font-size: 20px;
        cursor: pointer;
      }
      .modal-close:hover { color: var(--color-text); }

      /* Level Complete Modal Specifics */
      .level-complete-stars {
        display: flex;
        justify-content: center;
        gap: 10px;
        font-size: 32px;
        filter: drop-shadow(0 0 12px rgba(245, 185, 66, 0.8));
        margin: 4px 0;
      }
      .level-complete-stats-grid {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 10px;
      }
      .stat-card {
        background: var(--color-surface-2);
        border: 1px solid var(--color-border);
        border-radius: 8px;
        padding: 10px;
        text-align: center;
      }
      .stat-label {
        font-size: 10px;
        color: var(--color-muted);
        text-transform: uppercase;
        font-family: 'Orbitron', monospace;
      }
      .stat-number {
        font-size: 16px;
        font-weight: 700;
        color: var(--color-text);
        margin-top: 2px;
        font-family: 'Orbitron', monospace;
      }
      .stat-number.gold { color: var(--color-brand); }
      .stat-number.accent { color: var(--color-accent); }
      .stat-number.green { color: var(--color-success); }

      /* Achievements Grid */
      .achievements-list {
        display: flex;
        flex-direction: column;
        gap: 10px;
      }
      .achievement-item {
        display: flex;
        align-items: center;
        gap: 12px;
        background: var(--color-surface-2);
        border: 1px solid var(--color-border);
        border-radius: 10px;
        padding: 12px;
        transition: border-color 0.2s;
      }
      .achievement-item.unlocked {
        border-color: rgba(245, 185, 66, 0.5);
        background: linear-gradient(90deg, rgba(245, 185, 66, 0.08), var(--color-surface-2));
      }
      .achievement-item.locked {
        opacity: 0.55;
      }
      .ach-icon {
        font-size: 26px;
        width: 40px;
        height: 40px;
        display: flex;
        align-items: center;
        justify-content: center;
        border-radius: 8px;
        background: rgba(0,0,0,0.3);
      }
      .ach-info {
        flex: 1;
        display: flex;
        flex-direction: column;
        gap: 2px;
      }
      .ach-name {
        font-family: 'Space Grotesk', sans-serif;
        font-size: 13px;
        font-weight: 700;
        color: var(--color-text);
      }
      .ach-desc {
        font-size: 11px;
        color: var(--color-muted);
      }
      .ach-status {
        font-family: 'Orbitron', monospace;
        font-size: 10px;
        font-weight: 700;
        padding: 3px 8px;
        border-radius: 4px;
      }
      .ach-status.unlocked {
        background: rgba(245, 185, 66, 0.15);
        color: var(--color-brand);
        border: 1px solid rgba(245, 185, 66, 0.3);
      }
      .ach-status.locked {
        background: rgba(255, 255, 255, 0.05);
        color: var(--color-muted);
      }

      /* Level Select Grid */
      .level-grid {
        display: grid;
        grid-template-columns: 1fr;
        gap: 10px;
      }
      .level-card {
        background: var(--color-surface-2);
        border: 1px solid var(--color-border);
        border-radius: 10px;
        padding: 14px;
        display: flex;
        align-items: center;
        justify-content: space-between;
        cursor: pointer;
        transition: all 0.2s;
      }
      .level-card:hover:not(.locked) {
        border-color: var(--color-accent);
        transform: translateY(-2px);
      }
      .level-card.locked {
        opacity: 0.5;
        cursor: not-allowed;
      }
      .level-card.current {
        border-color: var(--color-brand);
        background: linear-gradient(90deg, rgba(245, 185, 66, 0.1), var(--color-surface-2));
      }
      .level-meta h4 {
        font-family: 'Orbitron', monospace;
        font-size: 13px;
        color: var(--color-text);
      }
      .level-meta p {
        font-size: 11px;
        color: var(--color-muted);
        margin-top: 2px;
      }

      .modal-btn {
        display: block;
        width: 100%;
        padding: 12px;
        margin-top: 6px;
        border-radius: 8px;
        background: var(--color-surface-2);
        border: 1px solid var(--color-border);
        color: var(--color-text);
        font-family: 'Orbitron', sans-serif;
        font-size: 13px;
        font-weight: 700;
        cursor: pointer;
        transition: all 0.2s;
        letter-spacing: 0.05em;
      }
      .modal-btn.primary {
        background: linear-gradient(90deg, #f5b942, #f59e0b);
        color: #03050b;
        border: none;
        box-shadow: 0 0 20px rgba(245, 185, 66, 0.4);
      }
      .modal-btn.accent {
        background: linear-gradient(90deg, #38dbf5, #2563eb);
        color: #03050b;
        border: none;
      }
      .modal-btn:hover {
        transform: translateY(-1px);
        filter: brightness(1.15);
      }

      /* ── Left Sidebar: Mission Control Deck ── */
      .sidebar-backdrop {
        display: none;
        position: fixed;
        inset: 0;
        background: rgba(0, 0, 0, 0.75);
        backdrop-filter: blur(4px);
        -webkit-backdrop-filter: blur(4px);
        z-index: 50;
      }
      .sidebar-backdrop.active { display: block; }

      .game-container-grid {
        display: flex;
        flex-direction: column;
        width: 100%;
        height: 100%;
        position: relative;
        overflow: hidden;
      }

      .game-viewport-wrap {
        display: flex;
        flex-direction: column;
        width: 100%;
        height: 100%;
        position: relative;
        overflow: hidden;
      }

      .game-sidebar-left {
        position: fixed;
        top: 0;
        left: 0;
        bottom: 0;
        width: min(320px, 86vw);
        background: rgba(10, 14, 26, 0.98);
        border-right: 1px solid rgba(56, 219, 245, 0.25);
        padding: 16px 14px;
        display: flex;
        flex-direction: column;
        gap: 10px;
        box-shadow: 0 0 40px rgba(0, 0, 0, 0.9);
        backdrop-filter: blur(16px);
        -webkit-backdrop-filter: blur(16px);
        z-index: 60;
        transform: translateX(-100%);
        transition: transform 0.28s cubic-bezier(0.16, 1, 0.3, 1);
        overflow-y: auto;
      }
      .game-sidebar-left.drawer-open {
        transform: translateX(0);
      }

      .sidebar-header {
        display: flex;
        align-items: center;
        justify-content: space-between;
        padding-bottom: 8px;
        border-bottom: 1px solid rgba(255, 255, 255, 0.08);
      }
      .sidebar-title {
        font-family: 'Orbitron', monospace;
        font-size: 11.5px;
        font-weight: 800;
        letter-spacing: 0.1em;
        color: var(--color-brand);
        text-transform: uppercase;
      }
      .sidebar-status-tag {
        font-family: 'Orbitron', monospace;
        font-size: 9.5px;
        font-weight: 700;
        padding: 3px 8px;
        border-radius: 4px;
        background: rgba(56, 219, 245, 0.12);
        color: var(--color-accent);
        border: 1px solid rgba(56, 219, 245, 0.25);
      }
      .sidebar-status-tag.all-unlocked {
        background: rgba(245, 185, 66, 0.15);
        color: var(--color-brand);
        border-color: rgba(245, 185, 66, 0.4);
      }

      .nav-btn.toggle-mission {
        border-color: var(--color-accent);
        color: var(--color-accent);
        background: rgba(56, 219, 245, 0.1);
      }

      /* Endless Mode Hero Tile */
      button.endless-pill-btn {
        all: unset;
        box-sizing: border-box;
        width: 100%;
        padding: 10px 12px;
        border-radius: 8px;
        background: linear-gradient(135deg, rgba(147, 51, 234, 0.25), rgba(56, 219, 245, 0.15));
        border: 1px solid rgba(168, 85, 247, 0.45);
        display: flex;
        align-items: center;
        gap: 10px;
        cursor: pointer;
        transition: all 0.2s cubic-bezier(0.16, 1, 0.3, 1);
        text-align: left;
        box-shadow: 0 4px 14px rgba(147, 51, 234, 0.2);
      }
      button.endless-pill-btn:hover {
        background: linear-gradient(135deg, rgba(147, 51, 234, 0.45), rgba(56, 219, 245, 0.3));
        border-color: #e879f9;
        transform: translateY(-1px);
        box-shadow: 0 6px 20px rgba(168, 85, 247, 0.45);
      }
      button.endless-pill-btn.active {
        background: linear-gradient(135deg, rgba(168, 85, 247, 0.5), rgba(56, 219, 245, 0.35));
        border-color: #e879f9;
        box-shadow: 0 0 20px rgba(232, 121, 249, 0.6);
      }
      .endless-pill-icon {
        font-size: 18px;
        line-height: 1;
        filter: drop-shadow(0 0 6px rgba(168, 85, 247, 0.8));
      }
      .endless-pill-info {
        flex: 1;
        min-width: 0;
        display: flex;
        flex-direction: column;
        gap: 2px;
      }
      .endless-pill-title {
        font-family: 'Orbitron', monospace;
        font-size: 11px;
        font-weight: 800;
        color: #fff;
        letter-spacing: 0.04em;
      }
      .endless-pill-sub {
        font-size: 9px;
        color: #c084fc;
        font-family: 'JetBrains Mono', monospace;
      }
      .endless-pill-badge {
        font-family: 'Orbitron', monospace;
        font-size: 8.5px;
        font-weight: 800;
        padding: 3px 8px;
        border-radius: 4px;
        background: rgba(168, 85, 247, 0.3);
        color: #e879f9;
        border: 1px solid rgba(168, 85, 247, 0.6);
      }

      .sidebar-section-divider {
        display: flex;
        align-items: center;
        justify-content: space-between;
        font-family: 'Orbitron', monospace;
        font-size: 9px;
        font-weight: 700;
        color: var(--color-muted);
        letter-spacing: 0.08em;
        padding: 2px 2px;
      }

      /* Sidebar Levels List */
      .sidebar-levels-list {
        display: flex;
        flex-direction: column;
        gap: 6px;
      }

      button.sector-tile-btn {
        all: unset;
        box-sizing: border-box;
        width: 100%;
        background: rgba(20, 26, 45, 0.65);
        border: 1px solid rgba(255, 255, 255, 0.08);
        border-radius: 8px;
        padding: 8px 10px;
        display: flex;
        align-items: center;
        gap: 9px;
        cursor: pointer;
        transition: all 0.18s cubic-bezier(0.16, 1, 0.3, 1);
        text-align: left;
      }
      button.sector-tile-btn:hover:not(.locked) {
        background: rgba(56, 219, 245, 0.12);
        border-color: rgba(56, 219, 245, 0.5);
        transform: translateX(3px);
      }
      button.sector-tile-btn.active {
        background: linear-gradient(90deg, rgba(245, 185, 66, 0.2), rgba(20, 26, 45, 0.85));
        border-color: var(--color-brand);
        box-shadow: 0 0 14px rgba(245, 185, 66, 0.3);
      }
      button.sector-tile-btn.locked {
        opacity: 0.4;
        cursor: not-allowed;
      }

      .sector-tile-num {
        font-family: 'Orbitron', monospace;
        font-size: 10px;
        font-weight: 800;
        width: 22px;
        height: 22px;
        display: flex;
        align-items: center;
        justify-content: center;
        border-radius: 4px;
        background: rgba(0, 0, 0, 0.4);
        border: 1px solid rgba(255, 255, 255, 0.1);
        color: var(--color-muted);
        flex-shrink: 0;
      }
      button.sector-tile-btn.active .sector-tile-num {
        background: rgba(245, 185, 66, 0.25);
        border-color: var(--color-brand);
        color: var(--color-brand);
      }

      .sector-tile-info {
        flex: 1;
        min-width: 0;
        display: flex;
        flex-direction: column;
        gap: 2px;
      }
      .sector-tile-title {
        font-family: 'Orbitron', monospace;
        font-size: 11px;
        font-weight: 700;
        color: #fff;
        white-space: nowrap;
        overflow: hidden;
        text-overflow: ellipsis;
      }
      .sector-tile-gun {
        font-family: 'JetBrains Mono', monospace;
        font-size: 9px;
        white-space: nowrap;
        overflow: hidden;
        text-overflow: ellipsis;
      }

      .sector-tile-action {
        font-family: 'Orbitron', monospace;
        font-size: 8.5px;
        font-weight: 800;
        padding: 3px 8px;
        border-radius: 4px;
        letter-spacing: 0.05em;
        flex-shrink: 0;
      }
      .sector-tile-action.active {
        background: var(--color-brand);
        color: #03050b;
      }
      .sector-tile-action.play {
        background: rgba(56, 219, 245, 0.15);
        color: var(--color-accent);
        border: 1px solid rgba(56, 219, 245, 0.35);
      }
      .sector-tile-action.locked {
        color: var(--color-muted);
      }

      /* ══════════════════════════════════════════════════════
         DESKTOP (≥960px AND landscape)
         ══════════════════════════════════════════════════════ */
      @media (min-width: 960px) and (min-aspect-ratio: 1/1) {
        html, body { overflow: auto; }

        .game-shell {
          max-width: 1360px;
          margin: 0 auto;
          padding: 14px 16px 0;
          height: auto;
        }

        .game-container-grid {
          display: grid;
          grid-template-columns: 290px 1fr;
          gap: 16px;
          align-items: start;
        }

        .game-sidebar-left {
          position: static;
          width: 100%;
          transform: none;
          box-shadow: 0 12px 36px rgba(0, 0, 0, 0.65);
          height: fit-content;
          border-right: none;
          border: 1px solid rgba(56, 219, 245, 0.16);
          border-radius: 12px;
        }

        .btn-sidebar-close {
          display: none !important;
        }

        .sidebar-backdrop {
          display: none !important;
        }

        #btn-toggle-mission {
          display: none;
        }

        #game-wrapper {
          flex: none;
          aspect-ratio: 16 / 9;
          border-radius: 14px;
          border: 1px solid var(--color-border);
          box-shadow:
            0 0 0 1px rgba(255, 255, 255, 0.05),
            0 24px 60px rgba(0, 0, 0, 0.85),
            0 0 100px rgba(56, 219, 245, 0.12);
        }

        .hints {
          display: flex;
          background: transparent;
          border-top: none;
          padding: 12px 0 24px;
        }
      }

      #game-wrapper:fullscreen,
      #game-wrapper:-webkit-full-screen {
        width: 100vw !important;
        height: 100vh !important;
        max-width: none !important;
        border-radius: 0 !important;
        border: none !important;
        aspect-ratio: auto !important;
      }

      @media (pointer: coarse) {
        #touch-controls { display: flex; }
      }
    </style>
  </head>
  <body>

    <nav class="game-nav">
      <div class="game-nav-left">
        <a href="/" class="back-pill-btn" aria-label="Return to Arcade">
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
            <line x1="19" y1="12" x2="5" y2="12"></line>
            <polyline points="12 19 5 12 12 5"></polyline>
          </svg>
          arcade
        </a>
        <button id="btn-toggle-mission" class="nav-btn toggle-mission" title="Open Mission Control Drawer">🚀 Sectors</button>
        <button id="btn-select-sector" class="sector-badge" title="Select Sector / Level">SECTOR 1 ▾</button>
      </div>

      <div class="nav-actions">
        <button id="btn-achievements" class="nav-btn gold" title="View Achievements">🏆 <span id="ach-count">0/10</span></button>
        <button id="btn-fullscreen" class="nav-btn nav-icon-btn" title="Toggle Fullscreen (F)">⛶</button>
        <button id="btn-pause" class="nav-btn nav-icon-btn" title="Pause Game (ESC / P)">⏸</button>
        <button id="btn-vol-mute" class="nav-btn nav-icon-btn" title="Toggle Audio">🔊</button>
      </div>
    </nav>

    <!-- Mobile Drawer Backdrop -->
    <div class="sidebar-backdrop" id="sidebar-backdrop"></div>

    <div class="game-shell">
      <div class="game-container-grid">
        <!-- Left Sidebar: Level Cards & Endless Mode -->
        <aside class="game-sidebar-left" id="game-sidebar-left">
          <div class="sidebar-header">
            <span class="sidebar-title">MISSION SELECT</span>
            <div style="display: flex; align-items: center; gap: 8px;">
              <span class="sidebar-status-tag" id="sidebar-progress-tag">SECTOR 1/5</span>
              <button id="btn-sidebar-close" class="btn-sidebar-close" style="all:unset; cursor:pointer; color:var(--color-muted); font-size:16px; padding:2px 6px;">✕</button>
            </div>
          </div>

          <!-- Endless Mode Button -->
          <button class="endless-pill-btn" id="btn-sidebar-endless">
            <span class="endless-pill-icon">⚡</span>
            <div class="endless-pill-info">
              <span class="endless-pill-title">INFINITY ENDLESS</span>
              <span class="endless-pill-sub">Auto-Cycling Guns & Sectors</span>
            </div>
            <span class="endless-pill-badge" id="endless-badge-status">RUN</span>
          </button>

          <!-- Campaign Divider -->
          <div class="sidebar-section-divider">
            <span>CAMPAIGN</span>
            <span id="sidebar-unlocked-pill">1/5</span>
          </div>

          <!-- Level Buttons Container -->
          <div class="sidebar-levels-list" id="sidebar-levels-list">
            <!-- Populated cleanly by JS -->
          </div>
        </aside>

        <!-- Right / Main Viewport -->
        <div class="game-viewport-wrap">
          <section id="game-wrapper">
        <!-- Holographic Cockpit HUD -->
        <div id="hud">
          <div class="hud-main-row">
            <!-- Left: Shield & Thruster Energy Bars -->
            <div class="hud-cluster">
              <div class="gauge-box">
                <span class="gauge-label">SHIELD <span id="val-shield">100</span>%</span>
                <div class="gauge-bar-bg">
                  <div id="bar-shield" class="gauge-bar-fill gauge-shield" style="width: 100%;"></div>
                </div>
              </div>

              <div class="gauge-box">
                <span class="gauge-label">BOOST <span id="val-boost">100</span>%</span>
                <div class="gauge-bar-bg">
                  <div id="bar-boost" class="gauge-bar-fill gauge-boost" style="width: 100%;"></div>
                </div>
              </div>
            </div>

            <!-- Center: Distance & Mineral Counters -->
            <div id="hud-center">
              <div class="hud-metric">
                <span class="metric-val score" id="ui-score">0</span>
                <span class="metric-unit">M</span>
              </div>
              <div class="hud-metric">
                <span class="metric-unit">💎</span>
                <span class="metric-val minerals" id="ui-minerals">0</span>
              </div>
              <div class="hud-metric">
                <span class="metric-unit">💥</span>
                <span class="metric-val" id="ui-destroyed">0</span>
              </div>
            </div>

            <!-- Right: EMP Bombs & Top Highscore -->
            <div class="hud-cluster">
              <div class="gauge-box" style="align-items: flex-end;">
                <div style="display: flex; align-items: center; justify-content: flex-end; gap: 5px;">
                  <span class="gauge-label">EMP BOMBS</span>
                  <span id="ui-emp-timer" class="emp-timer">FULL</span>
                </div>
                <div class="emp-pills" id="emp-icons">
                  <div class="emp-icon"></div>
                  <div class="emp-icon"></div>
                  <div class="emp-icon"></div>
                </div>
              </div>

              <div class="gauge-box" style="align-items: flex-end;">
                <span class="gauge-label">TOP RUN</span>
                <span style="font-size:12px; font-weight:700; color:var(--color-brand); font-family:'Orbitron', monospace;" id="ui-high">0m</span>
              </div>
            </div>
          </div>

          <!-- Sector Completion Progress Bar -->
          <div class="sector-progress-bar-wrap">
            <span class="sector-progress-label" id="sector-progress-label">WARP GATE: 0%</span>
            <div class="sector-progress-bg">
              <div id="sector-progress-fill" class="sector-progress-fill"></div>
            </div>
          </div>
        </div>

        <!-- Achievement Unlock Toast -->
        <div id="achievement-toast">
          <div class="toast-icon" id="toast-icon">🏆</div>
          <div class="toast-content">
            <span class="toast-tag">ACHIEVEMENT UNLOCKED</span>
            <span class="toast-title" id="toast-title">First Flight</span>
            <span class="toast-desc" id="toast-desc">Launch your first starfighter mission</span>
          </div>
        </div>

        <!-- Canvas Game Screen -->
        <canvas id="gameCanvas" tabindex="0"></canvas>

        <!-- Mobile Touch Controls -->
        <div id="touch-controls">
          <button id="btn-touch-emp" class="touch-action-btn emp" aria-label="Trigger EMP">
            <span>⚡</span>
            <span>EMP</span>
          </button>
          <div style="display: flex; gap: 12px;">
            <button id="btn-touch-boost" class="touch-action-btn boost" aria-label="Afterburner Boost">
              <span>🚀</span>
              <span>BOOST</span>
            </button>
            <button id="btn-touch-fire" class="touch-action-btn fire" aria-label="Fire Plasma Cannons">
              <span>🔥</span>
              <span>FIRE</span>
            </button>
          </div>
        </div>

        <!-- Level Completed Modal -->
        <div id="modal-level-complete" class="game-modal">
          <div class="modal-card" style="text-align: center;">
            <div class="modal-header" style="justify-content: center; border-bottom: none; padding-bottom: 0;">
              <h2 class="modal-title" id="lc-title" style="font-size: 22px; color: var(--color-brand);">SECTOR 1 CLEARED!</h2>
            </div>
            
            <div class="level-complete-stars" id="lc-stars">
              <span>⭐</span><span>⭐</span><span>⭐</span>
            </div>
            <p id="lc-subtitle" style="color: var(--color-muted); font-size: 13px; margin-top: -6px;">
              Hyperdrive Gate Reached. Starfighter Systems Optimal.
            </p>

            <div class="level-complete-stats-grid">
              <div class="stat-card">
                <div class="stat-label">Sector Distance</div>
                <div class="stat-number accent" id="lc-distance">500m</div>
              </div>
              <div class="stat-card">
                <div class="stat-label">Minerals Gathered</div>
                <div class="stat-number gold" id="lc-minerals">💎 +80</div>
              </div>
              <div class="stat-card">
                <div class="stat-label">Hazards Destroyed</div>
                <div class="stat-number" id="lc-destroyed">💥 18</div>
              </div>
              <div class="stat-card">
                <div class="stat-label">Shield Rating</div>
                <div class="stat-number green" id="lc-shield">100%</div>
              </div>
            </div>

            <div style="display: flex; flex-direction: column; gap: 8px; margin-top: 8px;">
              <button id="btn-next-level" class="modal-btn primary">🚀 ENGAGE NEXT SECTOR</button>
              <button id="btn-replay-level" class="modal-btn">🔄 REPLAY SECTOR</button>
              <button id="btn-sector-select" class="modal-btn">🌌 SECTOR MAP</button>
            </div>
          </div>
        </div>

        <!-- Achievements Modal -->
        <div id="modal-achievements" class="game-modal">
          <div class="modal-card">
            <div class="modal-header">
              <h3 class="modal-title">🏆 FLIGHT TROPHIES</h3>
              <button class="modal-close" id="btn-close-ach">✕</button>
            </div>
            <div class="achievements-list" id="achievements-container">
              <!-- Rendered dynamically by engine -->
            </div>
          </div>
        </div>

        <!-- Level Select Modal -->
        <div id="modal-levels" class="game-modal">
          <div class="modal-card">
            <div class="modal-header">
              <h3 class="modal-title">🚀 SECTOR NAVIGATION</h3>
              <button class="modal-close" id="btn-close-levels">✕</button>
            </div>
            <div class="level-grid" id="levels-container">
              <!-- Rendered dynamically by engine -->
            </div>
          </div>
        </div>

        <!-- Pause Modal -->
        <div id="pause-modal" class="game-modal">
          <div class="modal-card" style="text-align: center; max-width: 380px;">
            <h2 class="modal-title">TACTICAL PAUSE</h2>
            <p style="color:var(--color-muted); font-size:13px;">
              Systems on standby. Adjust trajectory or resume flight.
            </p>
            <button id="btn-resume" class="modal-btn accent">Resume Flight</button>
            <button id="btn-pause-fullscreen" class="modal-btn">⛶ Toggle Fullscreen</button>
            <button id="btn-restart" class="modal-btn">Restart Mission</button>
          </div>
        </div>
      </section>

      <!-- Keybinding & Control Hints -->
      <div class="hints">
            <div class="hints-keys">
              <span><kbd>W</kbd><kbd>A</kbd><kbd>S</kbd><kbd>D</kbd> or <kbd>Mouse</kbd> Maneuver</span>
              <span><kbd>Space</kbd> / <kbd>Click</kbd> Blasters</span>
              <span><kbd>Shift</kbd> / <kbd>Right Click</kbd> Boost</span>
              <span><kbd>B</kbd> / <kbd>E</kbd> EMP Nova Bomb</span>
              <span><kbd>F</kbd> Fullscreen</span>
              <span><kbd>P</kbd> / <kbd>ESC</kbd> Pause</span>
            </div>
            <div style="font-family:'JetBrains Mono', monospace; font-size:11px; color:var(--color-muted);">
              60 FPS Pure Canvas Engine
            </div>
          </div>
        </div> <!-- /.game-viewport-wrap -->
      </div> <!-- /.game-container-grid -->
    </div> <!-- /.game-shell -->

    <script>
      // Mobile Drawer Toggle Wiring
      const btnToggleMission = document.getElementById('btn-toggle-mission');
      const btnSidebarClose = document.getElementById('btn-sidebar-close');
      const sidebar = document.getElementById('game-sidebar-left');
      const backdrop = document.getElementById('sidebar-backdrop');

      function openSidebar() {
        if (sidebar) sidebar.classList.add('drawer-open');
        if (backdrop) backdrop.classList.add('active');
      }

      function closeSidebar() {
        if (sidebar) sidebar.classList.remove('drawer-open');
        if (backdrop) backdrop.classList.remove('active');
      }

      if (btnToggleMission) btnToggleMission.addEventListener('click', openSidebar);
      if (btnSidebarClose) btnSidebarClose.addEventListener('click', closeSidebar);
      if (backdrop) backdrop.addEventListener('click', closeSidebar);

      // Auto close drawer when selecting a mission on mobile
      document.addEventListener('click', (e) => {
        if (window.innerWidth < 960) {
          if (e.target.closest('.sector-tile-btn') || e.target.closest('#btn-sidebar-endless')) {
            closeSidebar();
          }
        }
      });
    </script>

    <script src="/space-dodge-engine.js" defer></script>
  </body>
</html>
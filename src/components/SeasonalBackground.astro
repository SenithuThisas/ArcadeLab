        else if (p.type === 'floating_lotus_bank') drawFloatingLotusBank(ctx, width, height, p.alpha, now);
        else if (p.type === 'oil_lamps_shore') drawOilLampsShore(ctx, width, height, p.alpha, now);
        else if (p.type === 'torii_gate') drawToriiGate(ctx, p.x, p.y, p.size, p.alpha);
        else if (p.type === 'palm_tree') drawPalmTree(ctx, p.x, p.y, p.size, p.alpha);
        else if (p.type === 'coral') drawCoral(ctx, p.x, p.y, p.size, p.alpha);
        else if (p.type === 'mushroom') drawMushroom(ctx, p.x, p.y, p.size, p.alpha);
        else if (p.type === 'pumpkin') drawJackOLantern(ctx, p.x, p.y, p.size, p.glow);

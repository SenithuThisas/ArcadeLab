      // Lower Main Bough
      ctx.strokeStyle = '#21101b';
      ctx.lineWidth = 7.5;
      ctx.beginPath();
      ctx.moveTo(w * 0.08, -h * 0.35);
      ctx.quadraticCurveTo(w * 0.22, -h * 0.38, w * 0.45, -h * 0.40);
      ctx.stroke();

      // Lower Sub-branches
      ctx.lineWidth = 4.2;
      ctx.beginPath();

          ctx.moveTo(-bS * 0.2, -bS * 0.1);
          ctx.quadraticCurveTo(-bS * 0.7, -bS * (0.8 + flap * 0.5), -bS * 1.4, -bS * (0.2 + flap * 0.8));
          ctx.quadraticCurveTo(-bS * 0.9, bS * (0.2 - flap * 0.4), -bS * 0.5, bS * 0.2);
          ctx.quadraticCurveTo(-bS * 0.3, bS * 0.4, -bS * 0.1, bS * 0.3);
          ctx.closePath();
          ctx.fill();

          ctx.beginPath();
          ctx.moveTo(bS * 0.2, -bS * 0.1);
          ctx.quadraticCurveTo(bS * 0.7, -bS * (0.8 + flap * 0.5), bS * 1.4, -bS * (0.2 + flap * 0.8));
          ctx.quadraticCurveTo(bS * 0.9, bS * (0.2 - flap * 0.4), bS * 0.5, bS * 0.2);
          ctx.quadraticCurveTo(bS * 0.3, bS * 0.4, bS * 0.1, bS * 0.3);

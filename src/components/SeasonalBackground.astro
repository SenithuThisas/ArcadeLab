              streakGrad.addColorStop(0, 'transparent');
              streakGrad.addColorStop(0.6, e.color + '44');
              streakGrad.addColorStop(0.9, e.color);
              streakGrad.addColorStop(1, '#ffffff');

              ctx.strokeStyle = streakGrad;
              ctx.lineWidth = e.thick;
              ctx.lineCap = 'round';
              ctx.beginPath();
              ctx.moveTo(-e.len, 0);
              ctx.lineTo(0, 0);
              ctx.stroke();

              ctx.fillStyle = '#ffffff';
              ctx.shadowColor = e.color;
              ctx.shadowBlur = 10;
              ctx.beginPath();
              ctx.arc(0, 0, e.thick * 1.3, 0, Math.PI * 2);
              ctx.fill();
              ctx.shadowBlur = 0;

              ctx.restore();
            }
          }
        } else if (e.type === 'sky_lantern') {
          e.y += e.vy;
          e.sway += e.swaySpeed;
          e.x += e.vx + Math.sin(e.sway) * 0.4;
          e.flicker += 0.05;
          if (e.y < -50) {
            e.y = height + 30;
            e.x = width * 0.08 + Math.random() * (width * 0.84);
          }
          ctx.save();
          ctx.translate(e.x, e.y);
          ctx.globalAlpha = e.alpha;

          const s = e.size;
          const fPulse = 0.85 + Math.sin(e.flicker) * 0.15;

          // Glowing Core Aura
          const slGlow = ctx.createRadialGradient(0, s * 0.2, 1, 0, s * 0.2, s * 2.2);
          slGlow.addColorStop(0, 'rgba(254, 240, 138, 0.85)');
          slGlow.addColorStop(0.4, 'rgba(251, 191, 36, 0.4)');
          slGlow.addColorStop(0.8, 'rgba(249, 115, 22, 0.12)');
          slGlow.addColorStop(1, 'transparent');
          ctx.fillStyle = slGlow;
          ctx.beginPath();
          ctx.arc(0, s * 0.2, s * 2.2, 0, Math.PI * 2);
          ctx.fill();

          // Translucent Paper Lantern Body
          const pGrad = ctx.createLinearGradient(0, -s * 0.8, 0, s * 0.5);
          pGrad.addColorStop(0, '#fef08a');
          pGrad.addColorStop(0.4, e.color);
          pGrad.addColorStop(1, '#ea580c');
          ctx.fillStyle = pGrad;
          ctx.globalAlpha = e.alpha * 0.9 * fPulse;

          ctx.beginPath();
          ctx.moveTo(-s * 0.35, s * 0.4);
          ctx.lineTo(-s * 0.48, -s * 0.4);
          ctx.quadraticCurveTo(-s * 0.48, -s * 0.85, 0, -s * 0.85);
          ctx.quadraticCurveTo(s * 0.48, -s * 0.85, s * 0.48, -s * 0.4);
          ctx.lineTo(s * 0.35, s * 0.4);
          ctx.closePath();
          ctx.fill();

          // Base Wire Rim
          ctx.strokeStyle = '#78350f';
          ctx.lineWidth = 1.0;
          ctx.beginPath();
          ctx.ellipse(0, s * 0.4, s * 0.35, s * 0.08, 0, 0, Math.PI * 2);
          ctx.stroke();

          // Candle Flame at bottom
          ctx.fillStyle = '#ffffff';
          ctx.beginPath();
          ctx.arc(0, s * 0.32, 1.8 * fPulse, 0, Math.PI * 2);
          ctx.fill();

          ctx.restore();
        } else if (e.type === 'floating_water_lotus') {
          e.bob += 0.025;
          e.x += e.drift;
          if (e.x > width + 40) e.x = -30;
          if (e.x < -40) e.x = width + 30;
          drawVesakLotusFlower(ctx, e.x, e.baseY, e.size, e.alpha, now, e.bob);
        }
      });

      // 4. Render Gentle Particles
      for (let i = particles.length - 1; i >= 0; i--) {
        const p = particles[i];
        p.sway += p.swaySpeed;
        p.rot += p.rotSpeed;
        p.tilt += p.tiltSpeed;
        p.x += p.vx + Math.sin(p.sway) * 0.5;
        p.y += p.vy;

        if (mouse.isOver) {
          const dx = p.x - mouse.x;
          const dy = p.y - mouse.y;
          const dist = Math.hypot(dx, dy);
          if (dist < 120 && dist > 0) {
            const force = (120 - dist) / 120;
            p.x += (dx / dist) * force * 1.8;
            p.y += (dy / dist) * force * 1.8;
          }
        }

        if (p.isBurst) {
          p.alpha -= p.decay;
          if (p.alpha <= 0) {
            particles.splice(i, 1);
            continue;
          }
        } else {
          if (p.y > height + 20) {
            p.y = -15;
            if (p.type === 'sakura') {
              p.x = Math.random() * (width * 0.35);
              p.y = height * 0.25 + Math.random() * (height * 0.45);
            } else if (p.type === 'autumn') {
              p.x = Math.random() > 0.5 ? Math.random() * (width * 0.35) : width - Math.random() * (width * 0.35);
              p.y = height * 0.25 + Math.random() * (height * 0.45);
            } else {
              p.x = Math.random() * width;
            }
          }
          if (p.y < -20) { p.y = height + 15; p.x = Math.random() * width; }
          if (p.x > width + 20) {
            if (p.type === 'sakura') {
              p.x = Math.random() * (width * 0.35);
              p.y = height * 0.25 + Math.random() * (height * 0.5);
            } else if (p.type === 'autumn') {
              p.x = Math.random() * (width * 0.35);
              p.y = height * 0.25 + Math.random() * (height * 0.45);
            } else {
              p.x = -15;
            }
          }
          if (p.x < -20) {
            if (p.type === 'autumn') {
              p.x = width - Math.random() * (width * 0.35);
              p.y = height * 0.25 + Math.random() * (height * 0.45);
            } else {
              p.x = width + 15;
            }
          }
        }

        ctx.save();
        ctx.globalAlpha = p.alpha;
        if (p.type === 'sakura') {
          ctx.translate(p.x, p.y);
          ctx.rotate(p.rot);
          if (p.particleShape === 'sakura_flower') {
            drawOpenSakuraFlower(ctx, 0, 0, p.size * 0.16, 0, 0.95);
          } else {
            ctx.scale(Math.cos(p.tilt), 1.0);
            drawSakuraPetalShape(ctx, p.size, p.size * 0.65, p.color, '#fff1f2');
          }
        } else if (p.type === 'frost') {
          ctx.translate(p.x, p.y);
          ctx.rotate(p.rot);
          if (p.particleShape === 'ice_crystal' || p.particleShape === 'cross_star') {
            drawCrossStar(ctx, 0, 0, p.size * 1.1, '#ffffff', p.color, 0.95);
          } else if (p.particleShape === 'frost_diamond') {
            drawRetroDiamond(ctx, p.size * 0.85, p.color);
          } else {
            const spGlow = ctx.createRadialGradient(0, 0, 1, 0, 0, p.size);
            spGlow.addColorStop(0, '#ffffff');
            spGlow.addColorStop(0.4, p.color);
            spGlow.addColorStop(1, 'transparent');
            ctx.fillStyle = spGlow;
            ctx.beginPath();
            ctx.arc(0, 0, p.size, 0, Math.PI * 2);
            ctx.fill();
          }
        } else if (p.type === 'autumn') {
          ctx.translate(p.x, p.y);
          ctx.rotate(p.rot);
          ctx.scale(Math.cos(p.tilt), 1.0);
          drawMapleLeafShape(ctx, p.size, p.color, 'rgba(80, 20, 10, 0.45)');
        } else if (p.type === 'hearts') {
          ctx.translate(p.x, p.y);
          ctx.rotate(p.rot);
          if (p.particleShape === 'cross_star') {
            drawCrossStar(ctx, 0, 0, p.size * 1.1, '#ffffff', p.color, 0.95);
          } else if (p.particleShape === 'heart') {
            drawHeartShape(ctx, p.size * 0.9, p.color);
          } else {
            ctx.fillStyle = p.color;
            ctx.beginPath();
            ctx.arc(0, 0, p.size * 0.6, 0, Math.PI * 2);
            ctx.fill();
          }
        } else if (p.type === 'abyss') {
          ctx.translate(p.x, p.y);
          if (p.particleShape === 'bubble') {
            drawAirBubble(ctx, p.size * 0.85, p.color);
          } else {
            // Bioluminescent Marine Snow / Plankton
            const plGlow = ctx.createRadialGradient(0, 0, 1, 0, 0, p.size);
            plGlow.addColorStop(0, '#ffffff');
            plGlow.addColorStop(0.5, p.color);
            plGlow.addColorStop(1, 'transparent');
            ctx.fillStyle = plGlow;
            ctx.beginPath();
            ctx.arc(0, 0, p.size, 0, Math.PI * 2);
            ctx.fill();
          }
        } else if (p.type === 'emerald') {
          ctx.translate(p.x, p.y);
          ctx.rotate(p.rot);
          if (p.particleShape === 'clover') {
            drawCloverShape(ctx, p.size * 0.9, p.color);
          } else if (p.particleShape === 'sprout') {
            drawLeafSproutShape(ctx, p.size * 0.85, p.color);
          } else {
            // Glowing Firefly / Pollen Mote
            const sparkGlow = ctx.createRadialGradient(0, 0, 1, 0, 0, p.size);
            sparkGlow.addColorStop(0, '#ffffff');
            sparkGlow.addColorStop(0.4, p.color);
            sparkGlow.addColorStop(1, 'transparent');
            ctx.fillStyle = sparkGlow;
            ctx.beginPath();
            ctx.arc(0, 0, p.size, 0, Math.PI * 2);
            ctx.fill();
          }
        } else if (p.type === 'synthwave') {
          ctx.translate(p.x, p.y);
          ctx.rotate(p.rot);
          if (p.particleShape === 'retro_diamond') {
            drawRetroDiamond(ctx, p.size * 1.1, p.color);
          } else if (p.particleShape === 'grid_square') {
            drawGridSquare(ctx, p.size * 0.9, p.color);
          } else {
            ctx.fillStyle = p.color;
            ctx.fillRect(-p.size * 0.5, -1, p.size, 2);
          }
        } else if (p.type === 'meteor') {
          ctx.translate(p.x, p.y);
          ctx.rotate(p.rot);
          if (p.particleShape === 'cross_star') {
            drawCrossStar(ctx, 0, 0, p.size * 1.2, '#ffffff', p.color, 0.95);
          } else if (p.particleShape === 'sparkle') {
            ctx.fillStyle = p.color;
            ctx.shadowColor = '#fcd34d';
            ctx.shadowBlur = 6;
            ctx.beginPath();
            ctx.arc(0, 0, p.size * 0.7, 0, Math.PI * 2);
            ctx.fill();
            ctx.shadowBlur = 0;
          } else {
            const stGlow = ctx.createRadialGradient(0, 0, 1, 0, 0, p.size);
            stGlow.addColorStop(0, '#ffffff');
            stGlow.addColorStop(0.5, p.color);
            stGlow.addColorStop(1, 'transparent');
            ctx.fillStyle = stGlow;
            ctx.beginPath();
            ctx.arc(0, 0, p.size, 0, Math.PI * 2);
            ctx.fill();
          }
        } else if (p.type === 'halloween') {
          ctx.translate(p.x, p.y);
          ctx.rotate(p.rot);
          if (p.particleShape === 'pumpkin_ember') {
            ctx.fillStyle = p.color;
            ctx.shadowColor = '#f97316';
            ctx.shadowBlur = 8;
            ctx.beginPath();
            ctx.arc(0, 0, p.size * 0.7, 0, Math.PI * 2);
            ctx.fill();
            ctx.shadowBlur = 0;
          } else if (p.particleShape === 'magic_orb') {
            const mgGlow = ctx.createRadialGradient(0, 0, 1, 0, 0, p.size);
            mgGlow.addColorStop(0, '#ffffff');
            mgGlow.addColorStop(0.4, p.color);
            mgGlow.addColorStop(1, 'transparent');
            ctx.fillStyle = mgGlow;
            ctx.beginPath();
            ctx.arc(0, 0, p.size, 0, Math.PI * 2);
            ctx.fill();
          } else {
            drawCrossStar(ctx, 0, 0, p.size * 0.9, '#ffffff', p.color, 0.9);
          }
        } else if (p.type === 'vesak' || p.type === 'solar') {
          ctx.translate(p.x, p.y);
          ctx.rotate(p.rot);
          if (p.particleShape === 'lotus_petal') {
            ctx.scale(Math.cos(p.tilt), 1.0);
            drawLotusPetal(ctx, p.size * 1.1, p.size * 0.65, '#f43f5e', '#fff1f2');
          } else if (p.particleShape === 'flame_ember') {
            ctx.fillStyle = p.color;
            ctx.shadowColor = '#fbbf24';
            ctx.shadowBlur = 8;
            ctx.beginPath();
            ctx.arc(0, 0, p.size * 0.65, 0, Math.PI * 2);
            ctx.fill();
            ctx.shadowBlur = 0;
          } else {
            const blGlow = ctx.createRadialGradient(0, 0, 1, 0, 0, p.size);
            blGlow.addColorStop(0, '#ffffff');
            blGlow.addColorStop(0.4, p.color);
            blGlow.addColorStop(1, 'transparent');
            ctx.fillStyle = blGlow;
            ctx.beginPath();
            ctx.arc(0, 0, p.size, 0, Math.PI * 2);
            ctx.fill();
          }
        } else {
          ctx.fillStyle = p.color;
          ctx.beginPath();
          ctx.arc(p.x, p.y, p.size * 0.6, 0, Math.PI * 2);
          ctx.fill();
        }
        ctx.restore();
      }

      animId = requestAnimationFrame(render);
    }

    animId = requestAnimationFrame(render);

    document.addEventListener('visibilitychange', () => {
      if (document.hidden) cancelAnimationFrame(animId);
      else animId = requestAnimationFrame(render);
    });
  })();
</script>

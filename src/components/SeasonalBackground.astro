          ctx.fill();
          ctx.fillStyle = '#10b981';
          ctx.shadowColor = '#10b981';
          ctx.shadowBlur = 4;
          ctx.fillRect(-17.5, -1.8, 1, 1);
          ctx.shadowBlur = 0;

          ctx.restore();
        } else if (e.type === 'spooky_ghost' || e.type === 'ghost') {
          e.x += e.vx;
          e.hover = (e.hover || 0) + 0.03;

      ctx.quadraticCurveTo(w * 0.38, -h * 0.28, w * 0.52, -h * 0.30);
      ctx.moveTo(w * 0.45, -h * 0.40);
      ctx.quadraticCurveTo(w * 0.55, -h * 0.42, w * 0.65, -h * 0.38);
      ctx.stroke();

      // Mid Main Canopy Bough
      ctx.lineWidth = 6.5;
      ctx.beginPath();
      ctx.moveTo(w * 0.08, -h * 0.60);
      ctx.bezierCurveTo(w * 0.22, -h * 0.68, w * 0.40, -h * 0.72, w * 0.58, -h * 0.68);
      ctx.stroke();

      // Crown Bough Reaching Up
      ctx.lineWidth = 5.0;
      ctx.beginPath();
      ctx.moveTo(w * 0.10, -h * 0.78);
      ctx.bezierCurveTo(w * 0.16, -h * 0.88, w * 0.20, -h * 0.95, w * 0.24, -h * 1.02);

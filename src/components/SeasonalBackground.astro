          ctx.fillStyle = '#ef4444';
          ctx.fillRect(-1.5, -bS * 0.3, 0.9, 0.9);
          ctx.fillRect(0.6, -bS * 0.3, 0.9, 0.9);

          ctx.restore();
        } else if (e.type === 'neon_butterfly') {
          e.x += e.vx;
          e.y += e.vy + Math.sin(now * 0.003 + e.x * 0.01) * 0.6;
          e.wing = (e.wing || 0) + (e.wingSpeed || 0.14);

          if (e.x > width + 40) e.x = -40;
          if (e.x < -40) e.x = width + 40;
          if (e.y < height * 0.2) e.y = height * 0.75;
          if (e.y > height * 0.85) e.y = height * 0.3;

          ctx.save();
          ctx.translate(e.x, e.y);
          ctx.globalAlpha = e.alpha;

          const flap = Math.cos(e.wing);
          const bS = e.size;

          ctx.fillStyle = e.color;
          ctx.shadowColor = e.color;
          ctx.shadowBlur = 8;

          ctx.beginPath();
          ctx.ellipse(-bS * 0.45 * Math.abs(flap), -bS * 0.2, bS * 0.5 * Math.abs(flap), bS * 0.7, -0.35, 0, Math.PI * 2);
          ctx.fill();

          ctx.beginPath();
          ctx.ellipse(bS * 0.45 * Math.abs(flap), -bS * 0.2, bS * 0.5 * Math.abs(flap), bS * 0.7, 0.35, 0, Math.PI * 2);
          ctx.fill();

          ctx.fillStyle = '#ffffff';
          ctx.beginPath();
          ctx.ellipse(0, 0, 1.8, bS * 0.45, 0, 0, Math.PI * 2);
          ctx.fill();
          ctx.shadowBlur = 0;

          ctx.strokeStyle = '#ffffff';
          ctx.lineWidth = 0.8;
          ctx.beginPath();
          ctx.moveTo(0, -bS * 0.4); ctx.lineTo(-2.5, -bS * 0.7);
          ctx.moveTo(0, -bS * 0.4); ctx.lineTo(2.5, -bS * 0.7);
          ctx.stroke();

          ctx.restore();
        } else if (e.type === 'jellyfish') {
          e.y += e.vy;
          e.pulse += 0.03;
          if (e.y < height * 0.2) e.y = height * 0.8;
          ctx.save();
          ctx.translate(e.x, e.y);
          ctx.fillStyle = '#00f2fe';
          ctx.globalAlpha = e.alpha * (0.6 + Math.sin(e.pulse) * 0.4);
          ctx.beginPath();
          ctx.arc(0, 0, e.size * 0.7, Math.PI, 0);
          ctx.closePath();
          ctx.fill();
          ctx.restore();
        } else if (e.type === 'santas_sleigh') {
          e.x += e.vx;
          e.hover = (e.hover || 0) + 0.02;
          if (e.x > width + 100) e.x = -80;
          ctx.save();
          const sy = e.y + Math.sin(e.hover) * 6;
          ctx.translate(e.x, sy);
          ctx.globalAlpha = 0.82;

          // Golden Stardust Trail behind sleigh
          const trailGrad = ctx.createLinearGradient(-45, 0, 0, 0);
          trailGrad.addColorStop(0, 'transparent');
          trailGrad.addColorStop(0.5, 'rgba(251, 191, 36, 0.35)');
          trailGrad.addColorStop(1, 'rgba(254, 240, 138, 0.8)');
          ctx.strokeStyle = trailGrad;
          ctx.lineWidth = 2.2;
          ctx.beginPath();
          ctx.moveTo(-45, 4);
          ctx.quadraticCurveTo(-20, 2, 0, 0);
          ctx.stroke();

          // Sleigh body
          ctx.fillStyle = '#b91c1c';
          ctx.beginPath();
          ctx.moveTo(-15, -4);
          ctx.quadraticCurveTo(-18, 5, -8, 6);
          ctx.lineTo(8, 6);
          ctx.quadraticCurveTo(14, 5, 12, -2);
          ctx.quadraticCurveTo(6, 2, -6, 2);
          ctx.closePath();
          ctx.fill();

          // Sleigh Golden Runner / Skid
          ctx.strokeStyle = '#fbbf24';
          ctx.lineWidth = 1.2;
          ctx.beginPath();
          ctx.moveTo(-18, 9);
          ctx.lineTo(12, 9);
          ctx.quadraticCurveTo(18, 8, 16, 2);
          ctx.stroke();

          // Santa Silhouette
          ctx.fillStyle = '#dc2626';
          ctx.beginPath();
          ctx.arc(-4, -4, 4.5, 0, Math.PI * 2);
          ctx.fill();
          // Santa Hat puff
          ctx.fillStyle = '#ffffff';
          ctx.beginPath();
          ctx.arc(-8, -8, 2, 0, Math.PI * 2);
          ctx.fill();

          // Reindeer Team
          const deerOffsets = [24, 40];
          deerOffsets.forEach(dx => {
            // Harness line
            ctx.strokeStyle = 'rgba(251, 191, 36, 0.5)';
            ctx.lineWidth = 0.8;
            ctx.beginPath();
            ctx.moveTo(10, 3);
            ctx.lineTo(dx, 0);
            ctx.stroke();

            // Reindeer body
            ctx.fillStyle = '#78350f';
            ctx.beginPath();
            ctx.ellipse(dx, 0, 5.5, 3, -0.15, 0, Math.PI * 2);
            ctx.fill();
            // Reindeer neck & head
            ctx.beginPath();
            ctx.arc(dx + 4, -4, 2.5, 0, Math.PI * 2);
            ctx.fill();
            // Antlers
            ctx.strokeStyle = '#451a03';
            ctx.lineWidth = 0.8;
            ctx.beginPath();
            ctx.moveTo(dx + 4, -5); ctx.lineTo(dx + 3, -9);
            ctx.moveTo(dx + 4, -5); ctx.lineTo(dx + 6, -8);
            ctx.stroke();
            // Rudolf red nose on front deer
            if (dx === 40) {
              ctx.fillStyle = '#ef4444';
              ctx.beginPath();
              ctx.arc(dx + 6.5, -4, 1.2, 0, Math.PI * 2);
              ctx.fill();
            }
          });

          ctx.restore();
        } else if (e.type === 'cyber_spinner') {
          e.x += e.vx;
          if (e.x > width + 80) e.x = -80;
          ctx.save();
          ctx.translate(e.x, e.y + Math.sin(now * 0.003) * 4);
          ctx.globalAlpha = 0.90;

          // Dual Magenta Thruster Jet Trails
          const jetGrad = ctx.createLinearGradient(-35, 0, 0, 0);
          jetGrad.addColorStop(0, 'transparent');
          jetGrad.addColorStop(0.6, 'rgba(236, 72, 153, 0.45)');
          jetGrad.addColorStop(1, 'rgba(244, 114, 182, 0.95)');
          ctx.strokeStyle = jetGrad;
          ctx.lineWidth = 2.4;
          ctx.beginPath();
          ctx.moveTo(-35, -2); ctx.lineTo(-10, -2);
          ctx.moveTo(-35, 2); ctx.lineTo(-10, 2);
          ctx.stroke();

          // Spinner Wedge Body
          ctx.fillStyle = '#0e061c';
          ctx.strokeStyle = '#06b6d4';
          ctx.lineWidth = 1.0;
          ctx.beginPath();
          ctx.moveTo(14, 0);
          ctx.lineTo(-10, -5);
          ctx.lineTo(-12, 5);
          ctx.closePath();
          ctx.fill();
          ctx.stroke();

          // Cyan Glowing Cockpit / Headlight
          ctx.fillStyle = '#00f2fe';
          ctx.shadowColor = '#00f2fe';
          ctx.shadowBlur = 6;
          ctx.beginPath();
          ctx.arc(8, 0, 2.0, 0, Math.PI * 2);
          ctx.fill();
          ctx.shadowBlur = 0;

          ctx.restore();
        } else if (e.type === 'jellyfish_abyss') {
          e.y += e.vy;
          e.pulse = (e.pulse || 0) + 0.025;
          if (e.y < -30) e.y = height + 30;
          ctx.save();
          ctx.translate(e.x + Math.sin(e.pulse * 0.8) * 12, e.y);
          ctx.globalAlpha = e.alpha;

          const pCon = 0.85 + Math.sin(e.pulse) * 0.25;
          const jR = e.size * 0.6;

          // Bioluminescent Translucent Bell
          const jGrad = ctx.createRadialGradient(0, -jR * 0.3, 1, 0, 0, jR);
          jGrad.addColorStop(0, '#ffffff');
          jGrad.addColorStop(0.35, 'rgba(0, 242, 254, 0.75)');
          jGrad.addColorStop(0.75, 'rgba(56, 189, 248, 0.45)');
          jGrad.addColorStop(1, 'rgba(12, 74, 110, 0.15)');

          ctx.fillStyle = jGrad;
          ctx.beginPath();
          ctx.ellipse(0, 0, jR, jR * 0.85 * pCon, 0, Math.PI, 0);
          ctx.closePath();
          ctx.fill();

          // Bioluminescent Inner Organs
          ctx.fillStyle = '#38bdf8';
          ctx.shadowColor = '#00f2fe';
          ctx.shadowBlur = 8;
          ctx.beginPath();
          ctx.arc(0, -jR * 0.25, 2.5, 0, Math.PI * 2);
          ctx.fill();
          ctx.shadowBlur = 0;

          // Trailing Undulating Tentacles
          const tentacleCount = 5;
          ctx.strokeStyle = 'rgba(0, 242, 254, 0.65)';
          ctx.lineWidth = 1.0;
          for (let t = 0; t < tentacleCount; t++) {
            const tx = ((t - (tentacleCount - 1) * 0.5) / (tentacleCount * 0.5)) * (jR * 0.65);
            ctx.beginPath();
            ctx.moveTo(tx, 0);
            for (let seg = 1; seg <= 6; seg++) {
              const segY = seg * (e.size * 0.45);
              const wave = Math.sin(e.pulse + t * 0.7 + seg * 0.8) * (4 + seg * 1.5);
              ctx.lineTo(tx + wave, segY);
            }
            ctx.stroke();
          }

          ctx.restore();
        } else if (e.type === 'perseid_meteor') {
          if (e.delay > 0) {
            e.delay -= 1;
          } else {
            e.x += e.vx;
            e.y += e.vy;
            e.alpha = Math.min(e.alpha + 0.08, 0.95);

            if (e.x < -150 || e.y > height + 80) {
              e.x = width * 0.25 + Math.random() * (width * 0.8);
              e.y = -30 - Math.random() * (height * 0.3);
              e.delay = 30 + Math.random() * 140;
              e.alpha = 0;
              e.vx = -7.5 - Math.random() * 5.0;
              e.vy = 6.0 + Math.random() * 4.0;
              e.len = 70 + Math.random() * 95;

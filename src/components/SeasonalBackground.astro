    // Overarching High Top-Edge Foliage Canopy (Kept at very top border)
    function drawAutumnCanopyTunnel(ctx, width, height, alpha) {
      ctx.save();
      ctx.globalAlpha = alpha;

      const topY = Math.min(height * 0.10, 80);

      // High Top Branch Arching across the Header
      ctx.strokeStyle = '#23140e';
      ctx.lineCap = 'round';
      ctx.lineJoin = 'round';

      // Left Top Arch
      ctx.lineWidth = 7.0;
      ctx.beginPath();
      ctx.moveTo(-10, topY * 0.4);
      ctx.quadraticCurveTo(width * 0.22, topY * 0.9, width * 0.42, topY * 0.6);
      ctx.stroke();

      // Right Top Arch
      ctx.beginPath();
      ctx.moveTo(width + 10, topY * 0.4);
      ctx.quadraticCurveTo(width * 0.78, topY * 0.9, width * 0.58, topY * 0.6);
      ctx.stroke();

      // Top Edge Leaves (Plentiful lush canopy at header border)
      const topLeaves = [
        { x: width * 0.06, y: topY * 0.4, s: 15, a: 0.2, col: '#f59e0b' },
        { x: width * 0.12, y: topY * 0.6, s: 16, a: 0.4, col: '#ea580c' },
        { x: width * 0.18, y: topY * 0.75, s: 14, a: -0.3, col: '#dc2626' },
        { x: width * 0.22, y: topY * 0.9, s: 16, a: -0.5, col: '#f59e0b' },
        { x: width * 0.28, y: topY * 0.85, s: 15, a: 0.8, col: '#fbbf24' },
        { x: width * 0.32, y: topY * 0.8, s: 14, a: 1.1, col: '#d97706' },
        { x: width * 0.38, y: topY * 0.7, s: 14, a: -0.6, col: '#ea580c' },
        { x: width * 0.42, y: topY * 0.6, s: 13, a: -0.8, col: '#f59e0b' },
        { x: width * 0.58, y: topY * 0.6, s: 13, a: 0.8, col: '#ea580c' },
        { x: width * 0.62, y: topY * 0.7, s: 14, a: 0.6, col: '#f59e0b' },
        { x: width * 0.68, y: topY * 0.8, s: 15, a: -1.1, col: '#fbbf24' },
        { x: width * 0.72, y: topY * 0.85, s: 14, a: -0.4, col: '#dc2626' },
        { x: width * 0.78, y: topY * 0.9, s: 16, a: 0.5, col: '#f59e0b' },
        { x: width * 0.82, y: topY * 0.75, s: 15, a: 0.3, col: '#d97706' },
        { x: width * 0.88, y: topY * 0.6, s: 16, a: -0.4, col: '#ea580c' },
        { x: width * 0.94, y: topY * 0.4, s: 15, a: -0.2, col: '#f59e0b' }
      ];

      topLeaves.forEach(tl => {
        ctx.save();
        ctx.translate(tl.x, tl.y);
        ctx.rotate(tl.a);
        drawMapleLeafShape(ctx, tl.s, tl.col, 'rgba(67, 20, 7, 0.5)');
        ctx.restore();
      });

      ctx.restore();
    }

    // Ground Carpet of Fallen Autumn Leaves (Sep)
    function drawFallenLeavesCarpet(ctx, width, height, alpha) {
      ctx.save();
      ctx.globalAlpha = alpha;

      // Base warm ground gradient
      const groundGrad = ctx.createLinearGradient(0, height - 35, 0, height);
      groundGrad.addColorStop(0, 'rgba(180, 83, 9, 0)');
      groundGrad.addColorStop(0.3, 'rgba(146, 64, 14, 0.45)');
      groundGrad.addColorStop(0.7, 'rgba(120, 53, 15, 0.75)');
      groundGrad.addColorStop(1, 'rgba(67, 20, 7, 0.90)');
      ctx.fillStyle = groundGrad;
      ctx.fillRect(0, height - 35, width, 35);

      // Sunlit leaf mound ridges
      const colors = ['#d97706', '#f59e0b', '#b45309', '#ea580c', '#fbbf24', '#92400e', '#dc2626'];
      const numLeaves = Math.min(Math.floor(width / 26), 55);

      for (let i = 0; i < numLeaves; i++) {
        const lx = (i / numLeaves) * width + ((i * 17) % 25);
        const ly = height - 6 - ((i * 13) % 20);
        const lsize = 8 + ((i * 7) % 7);
        const lrot = ((i * 47) % 360) * (Math.PI / 180);
        const lcol = colors[i % colors.length];

        ctx.save();
        ctx.translate(lx, ly);
        ctx.rotate(lrot);
        ctx.scale(1.0, 0.65); // Resting flat on ground
        drawMapleLeafShape(ctx, lsize, lcol, 'rgba(67, 20, 7, 0.5)');
        ctx.restore();
      }

      // Golden Rim-Glow along the carpet top edge
      const edgeGrad = ctx.createLinearGradient(0, height - 20, 0, height);
      edgeGrad.addColorStop(0, 'rgba(251, 191, 36, 0.35)');
      edgeGrad.addColorStop(0.4, 'rgba(245, 158, 11, 0.15)');
      edgeGrad.addColorStop(1, 'transparent');
      ctx.fillStyle = edgeGrad;
      ctx.fillRect(0, height - 20, width, 20);

      ctx.restore();
    }

    // 3. Snowman (Jan & Dec)
    function drawSnowman(ctx, x, y, size, alpha) {
      ctx.save();
      ctx.translate(x, y);
      ctx.fillStyle = '#ffffff';
      ctx.strokeStyle = '#38dbf5';
      ctx.lineWidth = 0.8;
      ctx.globalAlpha = alpha;

      // Bottom snowball
      ctx.beginPath();
      ctx.arc(0, -size * 0.6, size * 0.6, 0, Math.PI * 2);
      ctx.fill();
      ctx.stroke();

      // Head
      ctx.beginPath();
      ctx.arc(0, -size * 1.4, size * 0.42, 0, Math.PI * 2);
      ctx.fill();
      ctx.stroke();

      // Coal Buttons
      ctx.fillStyle = '#111827';
      ctx.beginPath();
      ctx.arc(0, -size * 0.8, 1.8, 0, Math.PI * 2);
      ctx.arc(0, -size * 0.55, 1.8, 0, Math.PI * 2);
      ctx.fill();

      // Top Hat
      ctx.fillStyle = '#111827';
      ctx.fillRect(-size * 0.42, -size * 1.82, size * 0.84, size * 0.1);
      ctx.fillRect(-size * 0.28, -size * 2.22, size * 0.56, size * 0.4);
      ctx.fillStyle = '#dc2626';
      ctx.fillRect(-size * 0.28, -size * 1.9, size * 0.56, size * 0.08);

      // Scarf
      ctx.fillStyle = '#f43f5e';
      ctx.beginPath();
      ctx.roundRect(-size * 0.38, -size * 1.15, size * 0.76, size * 0.2, [3]);
      ctx.fill();
      // Scarf tail
      ctx.fillRect(size * 0.12, -size * 0.95, size * 0.18, size * 0.45);

      // Carrot
      ctx.fillStyle = '#f97316';
      ctx.beginPath();
      ctx.moveTo(0, -size * 1.4);
      ctx.lineTo(size * 0.38, -size * 1.35);
      ctx.lineTo(0, -size * 1.28);
      ctx.closePath();
      ctx.fill();

      // Eyes & Smile
      ctx.fillStyle = '#111827';
      ctx.beginPath();
      ctx.arc(-size * 0.12, -size * 1.48, 1.4, 0, Math.PI * 2);
      ctx.arc(size * 0.12, -size * 1.48, 1.4, 0, Math.PI * 2);
      ctx.fill();

      // Twig Arms
      ctx.strokeStyle = '#451a03';
      ctx.lineWidth = 1.4;
      ctx.beginPath();
      ctx.moveTo(-size * 0.45, -size * 0.75);
      ctx.lineTo(-size * 0.85, -size * 0.95);
      ctx.moveTo(size * 0.45, -size * 0.75);
      ctx.lineTo(size * 0.85, -size * 0.95);
      ctx.stroke();

      ctx.restore();
    }

    // 4. Upgraded Christmas Tree (Dec)
    function drawXmasTree(ctx, x, y, size, alpha) {
      ctx.save();
      ctx.translate(x, y);
      ctx.globalAlpha = alpha;

      // Wooden Trunk
      ctx.fillStyle = '#23140e';
      ctx.fillRect(-size * 0.08, -size * 0.12, size * 0.16, size * 0.12);

      // 4 Tiered Lush Evergreen Pine Boughs
      for (let i = 0; i < 4; i++) {
        const tierY = -size * (0.08 + i * 0.22);
        const tierW = size * (0.62 - i * 0.11);
        const tierH = size * 0.34;

        // Pine Foliage
        const treeGrad = ctx.createLinearGradient(0, tierY - tierH, 0, tierY);
        treeGrad.addColorStop(0, '#062618');
        treeGrad.addColorStop(1, '#0e4429');
        ctx.fillStyle = treeGrad;
        ctx.strokeStyle = '#10b981';
        ctx.lineWidth = 0.8;

        ctx.beginPath();
        ctx.moveTo(-tierW, tierY);
        ctx.lineTo(-tierW * 0.6, tierY - tierH * 0.4);
        ctx.lineTo(0, tierY - tierH);
        ctx.lineTo(tierW * 0.6, tierY - tierH * 0.4);
        ctx.lineTo(tierW, tierY);
        ctx.quadraticCurveTo(0, tierY + 4, -tierW, tierY);
        ctx.closePath();
        ctx.fill();
        ctx.stroke();

        // Snow frosting on branch tips
        ctx.fillStyle = '#ffffff';
        ctx.beginPath();
        ctx.moveTo(-tierW, tierY);
        ctx.quadraticCurveTo(0, tierY - 4, tierW, tierY);
        ctx.lineTo(tierW * 0.8, tierY + 2);
        ctx.quadraticCurveTo(0, tierY + 4, -tierW * 0.8, tierY + 2);
        ctx.closePath();
        ctx.fill();

        // Bauble Ornaments
        const baubleColors = ['#ef4444', '#fbbf24', '#38dbf5', '#ec4899', '#a855f7'];
        for (let b = 0; b < 3; b++) {
          const bx = -tierW * 0.6 + b * (tierW * 0.6);
          const by = tierY - 4;
          const bcol = baubleColors[(i * 3 + b) % baubleColors.length];

          ctx.fillStyle = bcol;
          ctx.shadowColor = bcol;
          ctx.shadowBlur = 4;
          ctx.beginPath();
          ctx.arc(bx, by, 2.6, 0, Math.PI * 2);
          ctx.fill();
          ctx.shadowBlur = 0;
        }
      }

      // Radiant 8-Point Golden Star Topper
      const starY = -size * 0.98;
      const starGlow = ctx.createRadialGradient(0, starY, 1, 0, starY, 18);
      starGlow.addColorStop(0, 'rgba(254, 240, 138, 0.95)');
      starGlow.addColorStop(0.4, 'rgba(245, 158, 11, 0.55)');
      starGlow.addColorStop(1, 'transparent');
      ctx.fillStyle = starGlow;
      ctx.beginPath();
      ctx.arc(0, starY, 18, 0, Math.PI * 2);
      ctx.fill();

      // Sharp golden star points
      ctx.fillStyle = '#fffbeb';
      ctx.strokeStyle = '#f59e0b';
      ctx.lineWidth = 0.8;
      ctx.beginPath();
      for (let s = 0; s < 8; s++) {
        const a = (s * Math.PI * 2) / 8 - Math.PI / 2;
        const r = (s % 2 === 0) ? 7.5 : 3.0;
        const sx = Math.cos(a) * r;
        const sy = starY + Math.sin(a) * r;
        if (s === 0) ctx.moveTo(sx, sy);
        else ctx.lineTo(sx, sy);
      }
      ctx.closePath();
      ctx.fill();
      ctx.stroke();

      ctx.restore();
    }

    // Vintage Winter Streetlamp (Dec)
    function drawStreetLamp(ctx, x, y, size, alpha, now) {
      ctx.save();
      ctx.translate(x, y);
      ctx.globalAlpha = alpha;

      // Iron Lamp Post
      ctx.strokeStyle = '#1a2238';
      ctx.lineWidth = 3.0;
      ctx.beginPath();
      ctx.moveTo(0, 0);
      ctx.lineTo(0, -size);
      ctx.stroke();

      // Post Base
      ctx.fillStyle = '#111827';
      ctx.fillRect(-size * 0.12, -4, size * 0.24, 4);

      // Arching Lantern Bracket
      ctx.lineWidth = 1.8;
      ctx.beginPath();
      ctx.moveTo(0, -size * 0.85);
      ctx.quadraticCurveTo(-size * 0.25, -size * 0.92, -size * 0.2, -size * 0.72);
      ctx.moveTo(0, -size * 0.85);
      ctx.quadraticCurveTo(size * 0.25, -size * 0.92, size * 0.2, -size * 0.72);
      ctx.stroke();

      // Glowing Lanterns
      const lanternPositions = [-size * 0.2, size * 0.2];
      lanternPositions.forEach(lx => {
        const ly = -size * 0.72;

        // Warm Golden Glow
        const glow = ctx.createRadialGradient(lx, ly, 1, lx, ly, 22);
        glow.addColorStop(0, 'rgba(254, 240, 138, 0.75)');
        glow.addColorStop(0.4, 'rgba(245, 158, 11, 0.35)');
        glow.addColorStop(1, 'transparent');
        ctx.fillStyle = glow;
        ctx.beginPath();
        ctx.arc(lx, ly, 22, 0, Math.PI * 2);
        ctx.fill();

        // Glass Lamp
        ctx.fillStyle = '#fef08a';
        ctx.fillRect(lx - 3.5, ly - 5, 7, 10);

        // Snow on hood
        ctx.fillStyle = '#ffffff';
        ctx.beginPath();
        ctx.arc(lx, ly - 6, 4.5, Math.PI, 0);
        ctx.fill();
      });

      ctx.restore();
    }

    // Cozy Snow-Covered Cottage (Dec)
    function drawCozyCottage(ctx, x, y, size, alpha) {
      ctx.save();
      ctx.translate(x, y);
      ctx.globalAlpha = alpha;

      const w = size;
      const h = size * 0.65;

      // Log walls
      ctx.fillStyle = '#1c1524';
      ctx.fillRect(-w * 0.5, -h, w, h);

      // Warm Glowing Honey Windows
      ctx.fillStyle = '#fef08a';
      ctx.shadowColor = '#f59e0b';
      ctx.shadowBlur = 8;
      ctx.fillRect(-w * 0.3, -h * 0.65, w * 0.22, h * 0.38);
      ctx.fillRect(w * 0.1, -h * 0.65, w * 0.22, h * 0.38);
      ctx.shadowBlur = 0;

      // Window Muntins
      ctx.strokeStyle = '#1c1524';
      ctx.lineWidth = 1.0;
      ctx.strokeRect(-w * 0.3, -h * 0.65, w * 0.22, h * 0.38);
      ctx.strokeRect(w * 0.1, -h * 0.65, w * 0.22, h * 0.38);

      // Chimney
      ctx.fillStyle = '#2b1b17';
      ctx.fillRect(w * 0.25, -h * 1.35, w * 0.14, h * 0.55);

      // Snow-covered Gabled Roof
      ctx.fillStyle = '#ffffff';
      ctx.beginPath();
      ctx.moveTo(-w * 0.62, -h * 0.95);
      ctx.quadraticCurveTo(0, -h * 1.45, w * 0.62, -h * 0.95);
      ctx.lineTo(w * 0.52, -h * 0.85);
      ctx.quadraticCurveTo(0, -h * 1.32, -w * 0.52, -h * 0.85);
      ctx.closePath();
      ctx.fill();

      ctx.restore();
    }

    // Cute Gingerbread Man (Dec)
    function drawGingerbreadMan(ctx, x, y, size, alpha) {
      ctx.save();
      ctx.translate(x, y);
      ctx.globalAlpha = alpha;

      // Golden baked cookie body
      ctx.fillStyle = '#b45309';
      ctx.strokeStyle = '#78350f';
      ctx.lineWidth = 1.2;

      // Head
      ctx.beginPath();
      ctx.arc(0, -size * 1.2, size * 0.35, 0, Math.PI * 2);
      ctx.fill();
      ctx.stroke();

      // Torso
      ctx.beginPath();
      ctx.roundRect(-size * 0.28, -size * 0.9, size * 0.56, size * 0.65, [4]);
      ctx.fill();
      ctx.stroke();

      // Arms
      ctx.beginPath();
      ctx.ellipse(-size * 0.45, -size * 0.72, size * 0.25, size * 0.12, -0.4, 0, Math.PI * 2);
      ctx.ellipse(size * 0.45, -size * 0.72, size * 0.25, size * 0.12, 0.4, 0, Math.PI * 2);
      ctx.fill();
      ctx.stroke();

      // Legs
      ctx.beginPath();
      ctx.ellipse(-size * 0.2, -size * 0.18, size * 0.14, size * 0.25, -0.15, 0, Math.PI * 2);
      ctx.ellipse(size * 0.2, -size * 0.18, size * 0.14, size * 0.25, 0.15, 0, Math.PI * 2);
      ctx.fill();
      ctx.stroke();

      // White Frosting Details (Smile)
      ctx.fillStyle = '#ffffff';
      ctx.strokeStyle = '#ffffff';
      ctx.lineWidth = 1.2;
      ctx.beginPath();
      ctx.arc(0, -size * 1.18, size * 0.15, 0.2, Math.PI - 0.2);
      ctx.stroke();

      // Candy Buttons
      ctx.fillStyle = '#ef4444';
      ctx.beginPath();
      ctx.arc(0, -size * 0.75, 2, 0, Math.PI * 2);
      ctx.fill();
      ctx.fillStyle = '#10b981';
      ctx.beginPath();
      ctx.arc(0, -size * 0.55, 2, 0, Math.PI * 2);
      ctx.fill();

      // Mini Santa Hat
      ctx.fillStyle = '#dc2626';
      ctx.beginPath();
      ctx.moveTo(-size * 0.28, -size * 1.45);
      ctx.lineTo(size * 0.25, -size * 1.45);
      ctx.lineTo(size * 0.1, -size * 1.85);
      ctx.closePath();
      ctx.fill();

      ctx.fillStyle = '#ffffff';
      ctx.fillRect(-size * 0.32, -size * 1.48, size * 0.64, size * 0.1);
      ctx.beginPath();
      ctx.arc(size * 0.1, -size * 1.85, 2.5, 0, Math.PI * 2);
      ctx.fill();

      ctx.restore();
    }

    // 5. Torii Gate (Mar)
    function drawToriiGate(ctx, x, y, size, alpha) {
      ctx.save();
      ctx.translate(x, y);
      ctx.fillStyle = '#ff5e8a';
      ctx.strokeStyle = '#31101e';
      ctx.lineWidth = 0.8;
      ctx.globalAlpha = alpha;

      ctx.fillRect(-size * 0.35, -size, size * 0.08, size);
      ctx.fillRect(size * 0.27, -size, size * 0.08, size);

      ctx.beginPath();
      ctx.moveTo(-size * 0.5, -size * 1.05);
      ctx.quadraticCurveTo(0, -size * 1.12, size * 0.5, -size * 1.05);
      ctx.lineTo(size * 0.48, -size * 0.95);
      ctx.quadraticCurveTo(0, -size * 1.02, -size * 0.48, -size * 0.95);
      ctx.closePath();
      ctx.fill();
      ctx.stroke();
      ctx.restore();
    }

    // 6. Palm Tree (Jun)
    function drawPalmTree(ctx, x, y, size, alpha) {
      ctx.save();
      ctx.translate(x, y);
      ctx.strokeStyle = '#22112e';
      ctx.lineWidth = 3.0;
      ctx.globalAlpha = alpha;
      ctx.beginPath();
      ctx.moveTo(0, 0);
      ctx.quadraticCurveTo(size * 0.2, -size * 0.5, size * 0.15, -size);
      ctx.stroke();

      ctx.strokeStyle = '#06b6d4';
      ctx.lineWidth = 1.0;
      const topX = size * 0.15, topY = -size;
      for (let f = 0; f < 5; f++) {
        const a = (f * Math.PI) / 3 - Math.PI / 6;
        ctx.beginPath();
        ctx.moveTo(topX, topY);
        ctx.quadraticCurveTo(topX + Math.cos(a) * (size * 0.45), topY + Math.sin(a) * (size * 0.35), topX + Math.cos(a) * (size * 0.55), topY + Math.sin(a) * (size * 0.45) + 8);
        ctx.stroke();
      }
      ctx.restore();
    }

    // 7. Coral (Jul)
    function drawCoral(ctx, x, y, size, alpha) {
      ctx.save();
      ctx.translate(x, y);
      ctx.fillStyle = '#00f2fe';
      ctx.strokeStyle = '#4facfe';
      ctx.lineWidth = 0.8;
      ctx.globalAlpha = alpha * 0.7;
      ctx.beginPath();
      ctx.moveTo(-size * 0.3, 0);
      ctx.quadraticCurveTo(-size * 0.4, -size * 0.6, -size * 0.2, -size * 0.9);
      ctx.quadraticCurveTo(0, -size * 0.5, 0, -size * 0.95);
      ctx.quadraticCurveTo(size * 0.2, -size * 0.5, size * 0.3, -size * 0.85);
      ctx.quadraticCurveTo(size * 0.4, -size * 0.4, size * 0.3, 0);
      ctx.closePath();
      ctx.fill();
      ctx.stroke();
      ctx.restore();
    }

    // 8. Mushroom (Apr)
    function drawMushroom(ctx, x, y, size, alpha) {
      ctx.save();
      ctx.translate(x, y);
      ctx.fillStyle = '#064e3b';
      ctx.globalAlpha = alpha;
      ctx.fillRect(-size * 0.1, -size * 0.7, size * 0.2, size * 0.7);
      ctx.fillStyle = '#34d399';
      ctx.shadowColor = '#10b981';
      ctx.shadowBlur = 8;
      ctx.beginPath();
      ctx.arc(0, -size * 0.7, size * 0.45, Math.PI, 0);
      ctx.closePath();
      ctx.fill();
      ctx.restore();
    }

    // 9. Jack-o'-Lantern & Grave (Oct)
    function drawJackOLantern(ctx, x, y, size, glowIntensity) {
      ctx.save();
      ctx.translate(x, y);
      ctx.fillStyle = '#ea580c';
      ctx.beginPath();
      ctx.ellipse(0, 0, size, size * 0.82, 0, 0, Math.PI * 2);
      ctx.fill();
      ctx.fillStyle = '#fef08a';
      ctx.shadowColor = '#f59e0b';
      ctx.shadowBlur = 6 * glowIntensity;
      ctx.beginPath();
      ctx.moveTo(-size * 0.4, -size * 0.15); ctx.lineTo(-size * 0.15, -size * 0.15); ctx.lineTo(-size * 0.25, -size * 0.4); ctx.closePath(); ctx.fill();
      ctx.beginPath();
      ctx.moveTo(size * 0.15, -size * 0.15); ctx.lineTo(size * 0.4, -size * 0.15); ctx.lineTo(size * 0.25, -size * 0.4); ctx.closePath(); ctx.fill();
      ctx.beginPath();
      ctx.moveTo(-size * 0.5, size * 0.15); ctx.lineTo(-size * 0.2, size * 0.35); ctx.lineTo(0, size * 0.15); ctx.lineTo(size * 0.2, size * 0.35); ctx.lineTo(size * 0.5, size * 0.15); ctx.lineTo(0, size * 0.5); ctx.closePath(); ctx.fill();
      ctx.restore();
    }

    function drawGrave(ctx, x, y, width, height, alpha) {
      ctx.save();
      ctx.translate(x, y);
      ctx.fillStyle = '#1c1226';
      ctx.strokeStyle = '#a855f7';
      ctx.lineWidth = 0.8;
      ctx.globalAlpha = alpha;
      ctx.beginPath();
      ctx.moveTo(-width * 0.5, 0);
      ctx.lineTo(-width * 0.5, -height * 0.7);
      ctx.quadraticCurveTo(0, -height * 1.05, width * 0.5, -height * 0.7);
      ctx.lineTo(width * 0.5, 0);
      ctx.closePath();
      ctx.fill();
      ctx.stroke();
      ctx.fillStyle = '#c084fc';
      ctx.font = 'bold 7px serif';
      ctx.textAlign = 'center';
      ctx.fillText('R.I.P', 0, -height * 0.5);
      ctx.restore();
    }

    // 10. Cosmic 4-Point Diamond Cross Star (Feb & Nov)
    function drawCrossStar(ctx, x, y, size, coreColor, outerColor, alpha = 1.0) {
      ctx.save();
      ctx.translate(x, y);
      ctx.globalAlpha = alpha;

      // 4-point tapered diamond rays
      ctx.fillStyle = outerColor;
      ctx.beginPath();
      ctx.moveTo(0, -size);
      ctx.quadraticCurveTo(0, 0, size * 0.75, 0);
      ctx.quadraticCurveTo(0, 0, 0, size);
      ctx.quadraticCurveTo(0, 0, -size * 0.75, 0);
      ctx.quadraticCurveTo(0, 0, 0, -size);
      ctx.closePath();
      ctx.fill();

      // Bright white central star core
      ctx.fillStyle = coreColor;
      ctx.beginPath();
      ctx.arc(0, 0, size * 0.28, 0, Math.PI * 2);
      ctx.fill();

      ctx.restore();
    }

    // 11. Glowing Heart Shape (Feb)
    function drawHeartShape(ctx, size, color) {
      ctx.fillStyle = color;
      ctx.beginPath();
      const topCurveHeight = size * 0.3;
      ctx.moveTo(0, topCurveHeight);
      ctx.bezierCurveTo(-size * 0.55, -topCurveHeight, -size * 1.05, size * 0.35, 0, size * 1.05);
      ctx.bezierCurveTo(size * 1.05, size * 0.35, size * 0.55, -topCurveHeight, 0, topCurveHeight);
      ctx.closePath();
      ctx.fill();
    }

    // 12. Cosmic Nebula Aurora Waves & Twinkling Celestial Constellation (Feb)
    function drawNebulaCosmicSky(ctx, width, height, alpha, now) {
      ctx.save();
      ctx.globalAlpha = alpha;

      // Interstellar Ribbon Aurora Glow across upper celestial dome
      const time = now * 0.0006;
      ctx.beginPath();
      ctx.moveTo(0, height * 0.18 + Math.sin(time) * 15);
      ctx.bezierCurveTo(
        width * 0.35, height * 0.08 + Math.sin(time + 1) * 25,
        width * 0.65, height * 0.32 + Math.cos(time + 2) * 25,
        width, height * 0.15 + Math.sin(time + 3) * 15
      );
      ctx.lineTo(width, height * 0.38);
      ctx.bezierCurveTo(
        width * 0.65, height * 0.52 + Math.cos(time + 2) * 20,
        width * 0.35, height * 0.26 + Math.sin(time + 1) * 20,
        0, height * 0.32
      );
      ctx.closePath();

      const nebGrad = ctx.createLinearGradient(0, height * 0.08, width, height * 0.45);
      nebGrad.addColorStop(0, 'rgba(147, 51, 234, 0.18)');
      nebGrad.addColorStop(0.35, 'rgba(236, 72, 153, 0.24)');
      nebGrad.addColorStop(0.70, 'rgba(6, 182, 212, 0.18)');
      nebGrad.addColorStop(1, 'rgba(168, 85, 247, 0.15)');
      ctx.fillStyle = nebGrad;
      ctx.fill();

      // Scattered Twinkling 4-Point Diamond Cross Stars
      const celestialStars = [
        { x: width * 0.18, y: height * 0.12, s: 6.0, p: 0.2 },
        { x: width * 0.28, y: height * 0.22, s: 4.5, p: 1.8 },
        { x: width * 0.42, y: height * 0.09, s: 5.5, p: 3.4 },
        { x: width * 0.58, y: height * 0.16, s: 7.0, p: 0.9 },
        { x: width * 0.70, y: height * 0.10, s: 4.0, p: 2.5 },
        { x: width * 0.88, y: height * 0.14, s: 6.5, p: 4.1 },
        { x: width * 0.94, y: height * 0.32, s: 4.8, p: 1.2 },
        { x: width * 0.10, y: height * 0.28, s: 5.0, p: 5.0 },
        { x: width * 0.48, y: height * 0.28, s: 4.2, p: 2.1 }
      ];

      celestialStars.forEach(st => {
        const pulse = 0.55 + Math.sin(now * 0.003 + st.p) * 0.45;
        drawCrossStar(ctx, st.x, st.y, st.s * (0.8 + pulse * 0.3), '#ffffff', '#ff94b8', pulse * 0.9);
      });

      ctx.restore();
    }

    // 13. Majestic Ringed Celestial Planet (Feb)
    function drawRingedPlanet(ctx, x, y, size, alpha) {
      ctx.save();
      ctx.translate(x, y);
      ctx.globalAlpha = alpha;

      const r = size * 0.45;
      const ringTilt = -0.32;
      const rx = size * 1.15;
      const ry = size * 0.32;

      // 1. Back Arc of Planetary Ring (Passing Behind Sphere)
      ctx.save();
      ctx.rotate(ringTilt);
      ctx.beginPath();
      ctx.ellipse(0, 0, rx, ry, 0, Math.PI, Math.PI * 2);
      ctx.strokeStyle = 'rgba(244, 114, 182, 0.65)';
      ctx.lineWidth = size * 0.18;
      ctx.stroke();

      ctx.beginPath();
      ctx.ellipse(0, 0, rx * 1.14, ry * 1.14, 0, Math.PI, Math.PI * 2);
      ctx.strokeStyle = 'rgba(165, 243, 252, 0.45)';
      ctx.lineWidth = 1.8;
      ctx.stroke();
      ctx.restore();

      // 2. Main Planetary Sphere
      const sphereGrad = ctx.createRadialGradient(-r * 0.35, -r * 0.35, r * 0.1, 0, 0, r);
      sphereGrad.addColorStop(0, '#fbcfe8');
      sphereGrad.addColorStop(0.35, '#ec4899');
      sphereGrad.addColorStop(0.75, '#831843');
      sphereGrad.addColorStop(1, '#1e0521');

      ctx.fillStyle = sphereGrad;
      ctx.beginPath();
      ctx.arc(0, 0, r, 0, Math.PI * 2);
      ctx.fill();

      // Atmospheric Rim Light Crescent
      ctx.strokeStyle = 'rgba(255, 255, 255, 0.7)';
      ctx.lineWidth = 1.6;
      ctx.beginPath();
      ctx.arc(0, 0, r - 0.8, -Math.PI * 0.7, Math.PI * 0.2);
      ctx.stroke();

      // 3. Front Arc of Planetary Ring (Passing in Front of Sphere)
      ctx.save();
      ctx.rotate(ringTilt);
      ctx.beginPath();
      ctx.ellipse(0, 0, rx, ry, 0, 0, Math.PI);
      ctx.strokeStyle = 'rgba(244, 114, 182, 0.75)';
      ctx.lineWidth = size * 0.18;
      ctx.stroke();

      ctx.beginPath();
      ctx.ellipse(0, 0, rx * 0.90, ry * 0.90, 0, 0, Math.PI);
      ctx.strokeStyle = 'rgba(251, 207, 232, 0.55)';
      ctx.lineWidth = 1.4;
      ctx.stroke();

      ctx.beginPath();
      ctx.ellipse(0, 0, rx * 1.14, ry * 1.14, 0, 0, Math.PI);
      ctx.strokeStyle = 'rgba(165, 243, 252, 0.55)';
      ctx.lineWidth = 1.8;
      ctx.stroke();
      ctx.restore();

      // Companion Crescent Moon orbiting nearby
      ctx.save();
      ctx.translate(-size * 1.25, size * 0.45);
      ctx.fillStyle = '#fef08a';
      ctx.shadowColor = '#f472b6';
      ctx.shadowBlur = 6;
      ctx.beginPath();
      ctx.arc(0, 0, 4.5, 0, Math.PI * 2);
      ctx.fill();
      ctx.fillStyle = '#1c0f24';
      ctx.beginPath();
      ctx.arc(2.0, -1.0, 3.8, 0, Math.PI * 2);
      ctx.fill();
      ctx.restore();

      ctx.restore();
    }

    // 14. Anime Stargazer Silhouette with Rising Cosmic Stardust Stream (Feb)
    function drawNebulaStargazer(ctx, x, y, size, alpha, now) {
      ctx.save();
      ctx.translate(x, y);
      ctx.globalAlpha = alpha;

      const h = size;
      const w = size * 1.4;

      // 1. Grassy Mound Hill Crest Silhouette
      ctx.fillStyle = '#150921';
      ctx.beginPath();
      ctx.moveTo(-w * 0.8, 0);
      ctx.quadraticCurveTo(0, -h * 0.35, w * 0.8, 0);
      ctx.closePath();
      ctx.fill();

      // Subtle grass blades on crest
      ctx.strokeStyle = '#220e36';
      ctx.lineWidth = 1.5;
      for (let g = -10; g <= 10; g++) {
        const gx = g * 6;
        const gy = -h * 0.33 + Math.abs(g) * 1.5;
        ctx.beginPath();
        ctx.moveTo(gx, gy);
        ctx.lineTo(gx + Math.sin(now * 0.002 + g) * 3, gy - 8 - ((g * 3) % 5));
        ctx.stroke();
      }

      // 2. Anime Stargazer Silhouette Standing on Crest
      ctx.save();
      ctx.translate(0, -h * 0.33);

      // Cloak / Dress Body
      ctx.fillStyle = '#0f0517';
      ctx.beginPath();
      ctx.moveTo(-7, 0);
      ctx.lineTo(-4, -h * 0.40);
      ctx.lineTo(4, -h * 0.40);
      ctx.lineTo(7, 0);
      ctx.closePath();
      ctx.fill();

      // Head & Hair
      ctx.beginPath();
      ctx.arc(0, -h * 0.48, 5.5, 0, Math.PI * 2);
      ctx.fill();
      // Flowing Hair strand
      ctx.beginPath();
      ctx.moveTo(-3, -h * 0.50);
      ctx.quadraticCurveTo(-9, -h * 0.46, -11, -h * 0.38);
      ctx.lineTo(-7, -h * 0.42);
      ctx.closePath();
      ctx.fill();

      // Arms reached forward holding the luminous star
      const starX = 14;
      const starY = -h * 0.44;

      ctx.strokeStyle = '#0f0517';
      ctx.lineWidth = 2.4;
      ctx.lineCap = 'round';
      ctx.beginPath();
      ctx.moveTo(2, -h * 0.38);
      ctx.lineTo(starX - 2, starY + 2);
      ctx.stroke();

      // 3. Glowing Radiant Handheld Celestial Star / Core
      const starPulse = 0.8 + Math.sin(now * 0.005) * 0.2;
      const starGlow = ctx.createRadialGradient(starX, starY, 1, starX, starY, 18);
      starGlow.addColorStop(0, 'rgba(255, 255, 255, 0.95)');
      starGlow.addColorStop(0.3, 'rgba(254, 240, 138, 0.75)');
      starGlow.addColorStop(0.65, 'rgba(236, 72, 153, 0.45)');
      starGlow.addColorStop(1, 'transparent');

      ctx.fillStyle = starGlow;
      ctx.beginPath();
      ctx.arc(starX, starY, 18 * starPulse, 0, Math.PI * 2);
      ctx.fill();

      // Handheld Star Shape
      drawCrossStar(ctx, starX, starY, 7 * starPulse, '#ffffff', '#fef08a', 0.95);

      // 4. Ascending Helical Cosmic Stardust Swirl (rising upwards into the heavens)
      const swirlPoints = 24;
      ctx.strokeStyle = 'rgba(236, 72, 153, 0.75)';
      ctx.lineWidth = 1.8;
      ctx.beginPath();
      for (let s = 0; s < swirlPoints; s++) {
        const prog = s / swirlPoints;
        const py = starY - prog * (h * 1.8);
        const wave = Math.sin(now * 0.004 + s * 0.45) * (8 + prog * 24);
        const px = starX + (prog * 35) + wave;
        if (s === 0) ctx.moveTo(px, py);
        else ctx.lineTo(px, py);
      }
      ctx.stroke();

      // Micro sparkles & mini hearts along the cosmic swirl stream
      for (let s = 2; s < swirlPoints; s += 3) {
        const prog = s / swirlPoints;
        const py = starY - prog * (h * 1.8) + Math.sin(now * 0.005 + s) * 4;
        const px = starX + (prog * 35) + Math.sin(now * 0.004 + s * 0.45) * (8 + prog * 24);
        const sparkPulse = 0.6 + Math.sin(now * 0.006 + s) * 0.4;
        ctx.fillStyle = s % 2 === 0 ? '#fbcfe8' : '#38bdf8';
        ctx.globalAlpha = 0.85 * sparkPulse;
        ctx.beginPath();
        ctx.arc(px, py, 1.8 * sparkPulse, 0, Math.PI * 2);
        ctx.fill();
      }

      ctx.restore();
      ctx.restore();
    }

    // ── Ghibli Emerald Spring Drawing Helpers (Apr) ────────────
    function drawCloverShape(ctx, size, color) {
      ctx.fillStyle = color;
      ctx.beginPath();
      for (let i = 0; i < 3; i++) {
        const angle = (i * Math.PI * 2) / 3 - Math.PI / 2;
        const lx = Math.cos(angle) * (size * 0.55);
        const ly = Math.sin(angle) * (size * 0.55);
        ctx.arc(lx, ly, size * 0.42, 0, Math.PI * 2);
      }
      ctx.fill();

      ctx.strokeStyle = '#065f46';
      ctx.lineWidth = 1.2;
      ctx.beginPath();
      ctx.moveTo(0, 0);
      ctx.quadraticCurveTo(size * 0.25, size * 0.6, 0, size * 1.05);
      ctx.stroke();
    }

    function drawLeafSproutShape(ctx, size, color) {
      ctx.fillStyle = color;
      ctx.beginPath();
      ctx.moveTo(0, size);
      ctx.quadraticCurveTo(-size * 0.6, 0, 0, -size);
      ctx.quadraticCurveTo(size * 0.6, 0, 0, size);
      ctx.closePath();
      ctx.fill();

      ctx.strokeStyle = '#064e3b';
      ctx.lineWidth = 0.8;
      ctx.beginPath();
      ctx.moveTo(0, size);
      ctx.lineTo(0, -size * 0.85);
      ctx.stroke();
    }

    // 15. Studio Ghibli Emerald Mountain Vista & Reflective Lake (Apr)
    function drawEmeraldVistaHorizon(ctx, width, height, alpha, now) {
      ctx.save();
      ctx.globalAlpha = alpha;

      const horizY = height * 0.72;

      // Far Misty Emerald Mountain Ridge
      ctx.fillStyle = '#064e3b';
      ctx.beginPath();
      ctx.moveTo(0, horizY);
      ctx.lineTo(0, height * 0.45);
      ctx.quadraticCurveTo(width * 0.18, height * 0.32, width * 0.36, height * 0.48);
      ctx.quadraticCurveTo(width * 0.52, height * 0.28, width * 0.72, height * 0.46);
      ctx.quadraticCurveTo(width * 0.86, height * 0.38, width, height * 0.44);
      ctx.lineTo(width, horizY);
      ctx.closePath();
      ctx.fill();

      // Mid Rolling Verdant Hills
      ctx.fillStyle = '#047857';
      ctx.beginPath();
      ctx.moveTo(0, horizY);
      ctx.lineTo(0, height * 0.54);
      ctx.quadraticCurveTo(width * 0.22, height * 0.44, width * 0.45, height * 0.58);
      ctx.quadraticCurveTo(width * 0.68, height * 0.46, width * 0.88, height * 0.56);
      ctx.lineTo(width, height * 0.54);
      ctx.lineTo(width, horizY);
      ctx.closePath();
      ctx.fill();

      // Morning Lake Water Surface on Lower Horizon
      const lakeGrad = ctx.createLinearGradient(0, height * 0.55, 0, height);
      lakeGrad.addColorStop(0, '#064e3b');
      lakeGrad.addColorStop(0.3, '#0f766e');
      lakeGrad.addColorStop(0.7, '#042f2e');
      lakeGrad.addColorStop(1, '#021814');
      ctx.fillStyle = lakeGrad;
      ctx.fillRect(0, height * 0.55, width, height * 0.45);

      // Glassy Water Sheen & Subtle Horizon Mist
      const mistGrad = ctx.createLinearGradient(0, height * 0.50, 0, height * 0.68);
      mistGrad.addColorStop(0, 'rgba(167, 243, 208, 0.25)');
      mistGrad.addColorStop(0.5, 'rgba(52, 211, 153, 0.12)');
      mistGrad.addColorStop(1, 'transparent');
      ctx.fillStyle = mistGrad;
      ctx.fillRect(0, height * 0.50, width, height * 0.18);

      // Water Ripple Rings (Studio Ghibli rain/water droplets)
      const ripples = [
        { x: width * 0.48, y: height * 0.68, r: 18, phase: 0 },
        { x: width * 0.65, y: height * 0.74, r: 24, phase: 1.5 },
        { x: width * 0.32, y: height * 0.80, r: 15, phase: 3.0 }
      ];

      ripples.forEach(rp => {
        const prog = ((now * 0.0012 + rp.phase) % 3) / 3;
        const curR = rp.r * (0.3 + prog * 0.7);
        const ripAlpha = (1 - prog) * 0.55;
        ctx.strokeStyle = 'rgba(167, 243, 208, ' + ripAlpha + ')';
        ctx.lineWidth = 1.1;
        ctx.beginPath();
        ctx.ellipse(rp.x, rp.y, curR, curR * 0.35, 0, 0, Math.PI * 2);
        ctx.stroke();
      });

      // Little Wooden Rowing Boat on the lake
      ctx.save();
      ctx.translate(width * 0.52, height * 0.63);
      ctx.fillStyle = '#78350f';
      ctx.beginPath();
      ctx.moveTo(-10, 0);
      ctx.quadraticCurveTo(0, 4, 10, 0);
      ctx.lineTo(8, -2);
      ctx.lineTo(-8, -2);
      ctx.closePath();
      ctx.fill();
      // Oar
      ctx.strokeStyle = '#b45309';
      ctx.lineWidth = 0.9;
      ctx.beginPath();
      ctx.moveTo(-2, -3);
      ctx.lineTo(6, 4);
      ctx.stroke();
      ctx.restore();

      ctx.restore();
    }

    // 16. Ancient Mossy Stone Archway Overgrown with Lush Emerald Ivy (Apr)
    function drawIvyStoneArch(ctx, x, y, size, alpha) {
      ctx.save();
      ctx.translate(x, y);
      ctx.globalAlpha = alpha;

      const h = size;
      const w = size * 0.75;

      // 1. Ancient Stone Column & Roman Portal Arch
      ctx.fillStyle = '#0f172a';
      ctx.strokeStyle = '#1e293b';
      ctx.lineWidth = 2.0;

      // Left Column Body
      ctx.beginPath();
      ctx.moveTo(0, 0);
      ctx.lineTo(0, -h * 0.95);
      ctx.quadraticCurveTo(w * 0.45, -h * 1.08, w * 0.85, -h * 0.90);
      ctx.lineTo(w * 0.68, -h * 0.78);
      ctx.quadraticCurveTo(w * 0.38, -h * 0.90, w * 0.28, -h * 0.70);
      ctx.lineTo(w * 0.28, 0);
      ctx.closePath();
      ctx.fill();
      ctx.stroke();

      // Keystone Block at Crown of Arch
      ctx.fillStyle = '#1e293b';
      ctx.beginPath();
      ctx.moveTo(w * 0.40, -h * 1.02);
      ctx.lineTo(w * 0.54, -h * 1.06);
      ctx.lineTo(w * 0.52, -h * 0.92);
      ctx.lineTo(w * 0.42, -h * 0.90);
      ctx.closePath();
      ctx.fill();

      // Masonry Block Joint Lines on Column
      ctx.strokeStyle = 'rgba(51, 65, 85, 0.7)';
      ctx.lineWidth = 1.2;
      const blockHeights = [0.2, 0.4, 0.6, 0.78];
      blockHeights.forEach(bh => {
        ctx.beginPath();
        ctx.moveTo(0, -h * bh);
        ctx.lineTo(w * 0.28, -h * bh);
        ctx.stroke();
      });

      // 2. Climbing Lush Botanical Emerald Ivy Vines
      ctx.strokeStyle = '#064e3b';
      ctx.lineWidth = 3.5;
      ctx.lineCap = 'round';
      ctx.beginPath();
      ctx.moveTo(w * 0.08, 0);
      ctx.quadraticCurveTo(w * 0.22, -h * 0.35, w * 0.12, -h * 0.65);
      ctx.quadraticCurveTo(w * 0.05, -h * 0.85, w * 0.45, -h * 1.02);
      ctx.quadraticCurveTo(w * 0.72, -h * 0.98, w * 0.82, -h * 0.88);
      ctx.stroke();

      // Secondary Tendrils
      ctx.lineWidth = 2.0;
      ctx.strokeStyle = '#065f46';
      ctx.beginPath();
      ctx.moveTo(w * 0.12, -h * 0.65);
      ctx.quadraticCurveTo(w * 0.32, -h * 0.75, w * 0.28, -h * 0.55);
      ctx.moveTo(w * 0.45, -h * 1.02);
      ctx.quadraticCurveTo(w * 0.42, -h * 0.82, w * 0.40, -h * 0.72);
      ctx.moveTo(w * 0.65, -h * 0.95);
      ctx.quadraticCurveTo(w * 0.62, -h * 0.80, w * 0.58, -h * 0.68);
      ctx.stroke();

      // 3. Dense Clustered Ivy Leaves & Spring Clover Sprout Foliage
      const ivyLeaves = [
        { x: w * 0.42, y: -h * 1.05, s: 9, c: '#10b981', a: 0.3 },
        { x: w * 0.50, y: -h * 1.08, s: 11, c: '#34d399', a: 0.8 },
        { x: w * 0.58, y: -h * 1.04, s: 10, c: '#059669', a: -0.4 },
        { x: w * 0.34, y: -h * 1.00, s: 8, c: '#6ee7b7', a: 1.2 },
        { x: w * 0.68, y: -h * 0.96, s: 9, c: '#10b981', a: -0.7 },
        { x: w * 0.78, y: -h * 0.90, s: 8, c: '#34d399', a: 0.5 },
        { x: w * 0.40, y: -h * 0.72, s: 7, c: '#10b981', a: 1.4 },
        { x: w * 0.41, y: -h * 0.82, s: 8, c: '#34d399', a: -0.2 },
        { x: w * 0.58, y: -h * 0.68, s: 7, c: '#059669', a: 0.9 },
        { x: w * 0.61, y: -h * 0.80, s: 8, c: '#6ee7b7', a: -0.5 },
        { x: w * 0.12, y: -h * 0.65, s: 11, c: '#059669', a: 0.4 },
        { x: w * 0.20, y: -h * 0.70, s: 9, c: '#10b981', a: -0.8 },
        { x: w * 0.26, y: -h * 0.58, s: 8, c: '#34d399', a: 1.1 },
        { x: w * 0.08, y: -h * 0.52, s: 10, c: '#059669', a: -0.3 },
        { x: w * 0.18, y: -h * 0.38, s: 11, c: '#10b981', a: 0.7 },
        { x: w * 0.10, y: -h * 0.22, s: 9, c: '#34d399', a: -0.5 },
        { x: w * 0.22, y: -h * 0.15, s: 8, c: '#059669', a: 0.3 },
        { x: w * 0.06, y: -h * 0.06, s: 10, c: '#10b981', a: -0.2 }
      ];

      ivyLeaves.forEach(lf => {
        ctx.save();
        ctx.translate(lf.x, lf.y);
        ctx.rotate(lf.a);
        drawLeafSproutShape(ctx, lf.s, lf.c);
        ctx.restore();
      });

      ctx.restore();
    }

    // 17. Botanical Maidenhair Ferns & Sprouts Bank (Apr)
    function drawEmeraldFernsBank(ctx, x, y, size, alpha, now) {
      ctx.save();
      ctx.translate(x, y);
      ctx.globalAlpha = alpha;

      const w = size * 2.2;
      const h = size;

      // Mossy Forest Shoreline Mound
      ctx.fillStyle = '#042f2e';
      ctx.beginPath();
      ctx.moveTo(0, 0);
      ctx.lineTo(-w, 0);
      ctx.quadraticCurveTo(-w * 0.5, -h * 0.45, 0, -h * 0.35);
      ctx.closePath();
      ctx.fill();

      // Botanical Fern Fronds Swaying Gently
      const fronds = [
        { x: -w * 0.25, h: h * 0.85, angle: -0.2, col: '#10b981' },
        { x: -w * 0.50, h: h * 0.70, angle: -0.4, col: '#34d399' },
        { x: -w * 0.72, h: h * 0.60, angle: -0.6, col: '#059669' },
        { x: -w * 0.12, h: h * 0.75, angle: 0.1, col: '#6ee7b7' }
      ];

      fronds.forEach(fr => {
        const sway = Math.sin(now * 0.0025 + fr.x) * 0.08;
        ctx.save();
        ctx.translate(fr.x, -h * 0.28);
        ctx.rotate(fr.angle + sway);

        ctx.strokeStyle = '#065f46';
        ctx.lineWidth = 1.8;
        ctx.beginPath();
        ctx.moveTo(0, 0);
        ctx.quadraticCurveTo(fr.h * 0.2, -fr.h * 0.5, 0, -fr.h);
        ctx.stroke();

        for (let p = 1; p <= 6; p++) {
          const py = -(fr.h * (p / 7));
          const psize = (1 - p / 8) * 8;
          ctx.save();
          ctx.translate(0, py);
          drawLeafSproutShape(ctx, psize, fr.col);
          ctx.restore();
        }
        ctx.restore();
      });

      ctx.restore();
    }

    // ── Retro Synthwave / Cyberwave Drawing Helpers (Jun) ─────
    function drawRetroDiamond(ctx, size, color) {
      ctx.strokeStyle = color;
      ctx.lineWidth = 1.2;
      ctx.fillStyle = 'rgba(236, 72, 153, 0.2)';
      ctx.beginPath();
      ctx.moveTo(0, -size);
      ctx.lineTo(size * 0.7, 0);
      ctx.lineTo(0, size);
      ctx.lineTo(-size * 0.7, 0);
      ctx.closePath();
      ctx.fill();
      ctx.stroke();

      // Inner wireframe cross
      ctx.beginPath();
      ctx.moveTo(0, -size); ctx.lineTo(0, size);
      ctx.moveTo(-size * 0.7, 0); ctx.lineTo(size * 0.7, 0);
      ctx.stroke();
    }

    function drawGridSquare(ctx, size, color) {
      ctx.strokeStyle = color;
      ctx.lineWidth = 1.0;
      ctx.fillStyle = 'rgba(6, 182, 212, 0.18)';
      ctx.strokeRect(-size * 0.5, -size * 0.5, size, size);
      ctx.fillRect(-size * 0.5, -size * 0.5, size, size);
    }

    // 18. Giant Segmented Neon Synthwave Sun & 3D Perspective Grid (Jun)
    function drawSynthwaveSunAndGrid(ctx, width, height, alpha, now) {
      ctx.save();
      ctx.globalAlpha = alpha;

      const horizY = height * 0.68;
      const sunR = Math.min(Math.max(width * 0.12, 65), 115);
      const sunX = width * 0.5;
      const sunY = horizY - sunR * 0.35;

      // 1. Giant Segmented Outrun Sun
      // Sun ambient aura glow
      const aura = ctx.createRadialGradient(sunX, sunY, sunR * 0.4, sunX, sunY, sunR * 1.6);
      aura.addColorStop(0, 'rgba(244, 63, 94, 0.45)');
      aura.addColorStop(0.5, 'rgba(236, 72, 153, 0.20)');
      aura.addColorStop(1, 'transparent');
      ctx.fillStyle = aura;
      ctx.beginPath();
      ctx.arc(sunX, sunY, sunR * 1.6, 0, Math.PI * 2);
      ctx.fill();

      // Sun body gradient
      const sunGrad = ctx.createLinearGradient(sunX, sunY - sunR, sunX, sunY + sunR);
      sunGrad.addColorStop(0, '#fde047');
      sunGrad.addColorStop(0.35, '#f43f5e');
      sunGrad.addColorStop(0.75, '#ec4899');
      sunGrad.addColorStop(1, '#a855f7');

      ctx.save();
      ctx.beginPath();
      ctx.arc(sunX, sunY, sunR, 0, Math.PI * 2);
      ctx.clip();

      ctx.fillStyle = sunGrad;
      ctx.fillRect(sunX - sunR, sunY - sunR, sunR * 2, sunR * 2);

      // Horizontal Dark Segmentation Stripes (widen toward bottom)
      ctx.fillStyle = '#0c0317';
      const stripeCount = 7;
      for (let s = 1; s <= stripeCount; s++) {
        const prog = s / stripeCount;
        const stripeH = 2.0 + prog * 4.5;
        const sy = sunY + (prog * sunR * 0.95);
        ctx.fillRect(sunX - sunR, sy, sunR * 2, stripeH);
      }
      ctx.restore();

      // 2. Low-Poly Wireframe Neon Mountains on Horizon
      ctx.fillStyle = '#110322';
      ctx.strokeStyle = '#ec4899';
      ctx.lineWidth = 1.5;

      const mtnPeaks = [
        { x: 0, y: horizY },
        { x: width * 0.12, y: horizY - 45 },
        { x: width * 0.24, y: horizY - 20 },
        { x: width * 0.35, y: horizY - 55 },
        { x: width * 0.50, y: horizY - 25 },
        { x: width * 0.65, y: horizY - 60 },
        { x: width * 0.78, y: horizY - 30 },
        { x: width * 0.90, y: horizY - 50 },
        { x: width, y: horizY }
      ];

      ctx.beginPath();
      ctx.moveTo(0, horizY);
      mtnPeaks.forEach(p => ctx.lineTo(p.x, p.y));
      ctx.lineTo(width, horizY);
      ctx.closePath();
      ctx.fill();
      ctx.stroke();

      // Mountain ridge wireframe lines
      ctx.strokeStyle = 'rgba(236, 72, 153, 0.4)';
      ctx.lineWidth = 1.0;
      ctx.beginPath();
      ctx.moveTo(width * 0.12, horizY - 45); ctx.lineTo(width * 0.16, horizY);
      ctx.moveTo(width * 0.35, horizY - 55); ctx.lineTo(width * 0.32, horizY);
      ctx.moveTo(width * 0.65, horizY - 60); ctx.lineTo(width * 0.68, horizY);
      ctx.moveTo(width * 0.90, horizY - 50); ctx.lineTo(width * 0.88, horizY);
      ctx.stroke();

      // 3. 3D Perspective Wireframe Neon Grid Floor
      const gridFloorGrad = ctx.createLinearGradient(0, horizY, 0, height);
      gridFloorGrad.addColorStop(0, '#0c0218');
      gridFloorGrad.addColorStop(0.4, '#15032a');
      gridFloorGrad.addColorStop(1, '#05010b');
      ctx.fillStyle = gridFloorGrad;
      ctx.fillRect(0, horizY, width, height - horizY);

      // Glowing Horizon Line
      ctx.strokeStyle = '#06b6d4';
      ctx.shadowColor = '#06b6d4';
      ctx.shadowBlur = 8;
      ctx.lineWidth = 2.0;
      ctx.beginPath();
      ctx.moveTo(0, horizY);
      ctx.lineTo(width, horizY);
      ctx.stroke();
      ctx.shadowBlur = 0;

      // Perspective Radiating Longitudinal Lines
      const vanishingX = width * 0.5;
      const numLongLines = 22;
      ctx.strokeStyle = 'rgba(6, 182, 212, 0.55)';
      ctx.lineWidth = 1.2;

      for (let i = 0; i <= numLongLines; i++) {
        const bottomX = (i / numLongLines) * (width * 1.8) - (width * 0.4);
        ctx.beginPath();
        ctx.moveTo(vanishingX, horizY);
        ctx.lineTo(bottomX, height);
        ctx.stroke();
      }

      // Animated Receding Latitudinal Lines
      const gridSpeed = (now * 0.035) % 24;
      const latSteps = 12;
      for (let k = 1; k <= latSteps; k++) {
        const norm = (k + (gridSpeed / 24)) / latSteps;
        const distRatio = Math.pow(norm, 2.6); // Perspective exponent
        const ly = horizY + distRatio * (height - horizY);
        const lineAlpha = 0.25 + norm * 0.65;
        ctx.strokeStyle = 'rgba(236, 72, 153, ' + lineAlpha + ')';
        ctx.lineWidth = 0.9 + norm * 1.4;
        ctx.beginPath();
        ctx.moveTo(0, ly);
        ctx.lineTo(width, ly);
        ctx.stroke();
      }

      ctx.restore();
    }

    // 19. Cyberpunk Skyscraper Skyline (Jun)
    function drawCyberpunkSkyline(ctx, width, height, alpha, now) {
      ctx.save();
      ctx.globalAlpha = alpha;

      const horizY = height * 0.68;

      // Left Skyline Cluster
      const buildings = [
        { x: width * 0.12, w: 32, h: 90, c: '#0b0416' },
        { x: width * 0.16, w: 42, h: 130, c: '#100620' },
        { x: width * 0.22, w: 36, h: 80, c: '#0b0416' },
        { x: width * 0.74, w: 38, h: 110, c: '#100620' },
        { x: width * 0.80, w: 46, h: 145, c: '#0c0418' },
        { x: width * 0.86, w: 34, h: 75, c: '#100620' }
      ];

      buildings.forEach((b, idx) => {
        ctx.fillStyle = b.c;
        ctx.fillRect(b.x, horizY - b.h, b.w, b.h);

        // Neon Edge Outline
        ctx.strokeStyle = idx % 2 === 0 ? 'rgba(6, 182, 212, 0.45)' : 'rgba(236, 72, 153, 0.45)';
        ctx.lineWidth = 1.0;
        ctx.strokeRect(b.x, horizY - b.h, b.w, b.h);

        // Rooftop Antenna
        ctx.strokeStyle = '#64748b';
        ctx.lineWidth = 1.0;
        ctx.beginPath();
        ctx.moveTo(b.x + b.w * 0.5, horizY - b.h);
        ctx.lineTo(b.x + b.w * 0.5, horizY - b.h - 18);
        ctx.stroke();

        // Pulsing Warning Beacon
        const beaconPulse = 0.5 + Math.sin(now * 0.005 + idx) * 0.5;
        ctx.fillStyle = idx % 2 === 0 ? '#ef4444' : '#06b6d4';
        ctx.beginPath();
        ctx.arc(b.x + b.w * 0.5, horizY - b.h - 18, 1.8 * beaconPulse, 0, Math.PI * 2);
        ctx.fill();

        // Glowing Window Grid Lines
        const winCols = 3;
        const winRows = Math.floor(b.h / 14);
        for (let r = 1; r < winRows; r++) {
          for (let c = 0; c < winCols; c++) {
            if ((r + c + idx) % 3 === 0) {
              const wx = b.x + 5 + c * (b.w / 4);
              const wy = horizY - b.h + 8 + r * 12;
              ctx.fillStyle = (r + c) % 2 === 0 ? '#06b6d4' : '#f472b6';
              ctx.fillRect(wx, wy, 3.5, 4.5);
            }
          }
        }
      });

      ctx.restore();
    }

    // 20. Iconic Outrun Palm Tree Silhouettes (Jun)
    function drawOutrunPalm(ctx, x, y, size, alpha, flip) {
      ctx.save();
      ctx.translate(x, y);
      if (flip) ctx.scale(-1, 1);
      ctx.globalAlpha = alpha;

      const h = size;

      // Curved Trunk
      ctx.strokeStyle = '#0f021c';
      ctx.lineWidth = 6.5;
      ctx.lineCap = 'round';
      ctx.beginPath();
      ctx.moveTo(0, 0);
      ctx.quadraticCurveTo(h * 0.18, -h * 0.5, h * 0.12, -h);
      ctx.stroke();

      // Neon Magenta Back-Rim Highlight along Trunk
      ctx.strokeStyle = 'rgba(236, 72, 153, 0.7)';
      ctx.lineWidth = 1.4;
      ctx.beginPath();
      ctx.moveTo(-1.5, 0);
      ctx.quadraticCurveTo(h * 0.18 - 1.5, -h * 0.5, h * 0.12 - 1.5, -h);
      ctx.stroke();

      // Palm Crown Top Point
      const crownX = h * 0.12;
      const crownY = -h;

      // Outrun Palm Fronds
      const frondAngles = [-0.9, -0.6, -0.2, 0.2, 0.55, 0.85, 1.15];
      frondAngles.forEach(ang => {
        ctx.save();
        ctx.translate(crownX, crownY);
        ctx.rotate(ang);

        const frondLen = h * 0.42;

        // Frond stem
        ctx.strokeStyle = '#0f021c';
        ctx.lineWidth = 2.4;
        ctx.beginPath();
        ctx.moveTo(0, 0);
        ctx.quadraticCurveTo(frondLen * 0.45, -12, frondLen, 16);
        ctx.stroke();

        // Frond Neon Highlight
        ctx.strokeStyle = 'rgba(6, 182, 212, 0.65)';
        ctx.lineWidth = 0.9;
        ctx.beginPath();
        ctx.moveTo(0, 0);
        ctx.quadraticCurveTo(frondLen * 0.45, -12, frondLen, 16);
        ctx.stroke();

        // Drooping Leaflets
        ctx.strokeStyle = '#120422';
        ctx.lineWidth = 1.5;
        for (let l = 2; l <= 6; l++) {
          const lx = (l / 7) * frondLen;
          const ly = -6 + (l * 2.5);
          ctx.beginPath();
          ctx.moveTo(lx, ly);
          ctx.lineTo(lx - 4, ly + 9);
          ctx.stroke();
        }

        ctx.restore();
      });

      ctx.restore();
    }

    // ── Abyssal Ocean Drawing Helpers (Jul) ───────────────────
    function drawAirBubble(ctx, size, color) {
      ctx.save();
      const bubGrad = ctx.createRadialGradient(-size * 0.25, -size * 0.25, size * 0.1, 0, 0, size);
      bubGrad.addColorStop(0, 'rgba(255, 255, 255, 0.75)');
      bubGrad.addColorStop(0.4, 'rgba(56, 189, 248, 0.35)');
      bubGrad.addColorStop(0.85, 'rgba(0, 242, 254, 0.45)');
      bubGrad.addColorStop(1, 'rgba(6, 182, 212, 0.85)');

      ctx.fillStyle = bubGrad;
      ctx.beginPath();
      ctx.arc(0, 0, size, 0, Math.PI * 2);
      ctx.fill();

      ctx.fillStyle = '#ffffff';
      ctx.beginPath();
      ctx.arc(-size * 0.35, -size * 0.35, size * 0.28, 0, Math.PI * 2);
      ctx.fill();

      ctx.restore();
    }

    // 21. Upper Ocean Surface Caustics & Deep Abyss Gradients (Jul)
    function drawOceanCausticsSurface(ctx, width, height, alpha, now) {
      ctx.save();
      ctx.globalAlpha = alpha;

      const abyssGrad = ctx.createLinearGradient(0, 0, 0, height);
      abyssGrad.addColorStop(0, 'rgba(2, 132, 199, 0.22)');
      abyssGrad.addColorStop(0.35, 'rgba(12, 74, 110, 0.35)');
      abyssGrad.addColorStop(0.75, 'rgba(3, 37, 65, 0.65)');
      abyssGrad.addColorStop(1, 'rgba(1, 9, 20, 0.92)');
      ctx.fillStyle = abyssGrad;
      ctx.fillRect(0, 0, width, height);

      // Shimmering undulating water surface caustics
      const time = now * 0.001;
      ctx.strokeStyle = 'rgba(0, 242, 254, 0.35)';
      ctx.lineWidth = 1.8;
      ctx.beginPath();
      ctx.moveTo(0, 15 + Math.sin(time) * 4);
      for (let x = 0; x <= width; x += 35) {
        const cy = 15 + Math.sin(time + x * 0.015) * 5 + Math.cos(time * 0.7 + x * 0.02) * 3;
        ctx.lineTo(x, cy);
      }
      ctx.stroke();

      ctx.strokeStyle = 'rgba(110, 231, 183, 0.22)';
      ctx.lineWidth = 1.2;
      ctx.beginPath();
      ctx.moveTo(0, 25 + Math.cos(time * 0.8) * 4);
      for (let x = 0; x <= width; x += 40) {
        const cy = 25 + Math.cos(time * 0.8 + x * 0.018) * 4;
        ctx.lineTo(x, cy);
      }
      ctx.stroke();

      ctx.restore();
    }

    // 22. Deep Oceanic Trench & Bioluminescent Coral Reef (Jul)
    function drawBioluminescentReef(ctx, width, height, alpha, now) {
      ctx.save();
      ctx.globalAlpha = alpha;

      const reefH = Math.min(height * 0.38, 200);

      // Left Rocky Sea Trench Wall
      ctx.fillStyle = '#020d1a';
      ctx.beginPath();
      ctx.moveTo(0, height);
      ctx.lineTo(0, height - reefH);
      ctx.quadraticCurveTo(width * 0.12, height - reefH * 0.7, width * 0.18, height - reefH * 0.35);
      ctx.quadraticCurveTo(width * 0.25, height - reefH * 0.15, width * 0.32, height);
      ctx.closePath();
      ctx.fill();

      // Right Rocky Sea Floor Mound
      ctx.beginPath();
      ctx.moveTo(width, height);
      ctx.lineTo(width, height - reefH * 0.85);
      ctx.quadraticCurveTo(width * 0.85, height - reefH * 0.65, width * 0.78, height - reefH * 0.3);
      ctx.quadraticCurveTo(width * 0.70, height - reefH * 0.15, width * 0.62, height);
      ctx.closePath();
      ctx.fill();

      // Swaying Deep-Sea Kelp Ribbons
      const kelps = [
        { x: width * 0.08, y: height - reefH * 0.55, len: 75, angle: -0.15, col: '#0d9488' },
        { x: width * 0.14, y: height - reefH * 0.30, len: 90, angle: 0.1, col: '#059669' },
        { x: width * 0.82, y: height - reefH * 0.45, len: 80, angle: -0.1, col: '#0d9488' },
        { x: width * 0.88, y: height - reefH * 0.65, len: 65, angle: 0.15, col: '#10b981' }
      ];

      kelps.forEach((k, idx) => {
        const sway = Math.sin(now * 0.0018 + idx * 1.2) * 12;
        ctx.strokeStyle = k.col;
        ctx.lineWidth = 3.2;
        ctx.beginPath();
        ctx.moveTo(k.x, k.y);
        ctx.bezierCurveTo(k.x + sway * 0.5, k.y - k.len * 0.35, k.x - sway * 0.5, k.y - k.len * 0.7, k.x + sway, k.y - k.len);
        ctx.stroke();
      });

      // Bioluminescent Staghorn & Fan Corals
      const corals = [
        { x: width * 0.06, y: height - reefH * 0.62, size: 28, col: '#00f2fe' },
        { x: width * 0.16, y: height - reefH * 0.28, size: 34, col: '#4facfe' },
        { x: width * 0.22, y: height - reefH * 0.10, size: 22, col: '#6ee7b7' },
        { x: width * 0.76, y: height - reefH * 0.25, size: 30, col: '#00f2fe' },
        { x: width * 0.86, y: height - reefH * 0.52, size: 36, col: '#38bdf8' }
      ];

      corals.forEach(cr => {
        ctx.save();
        ctx.translate(cr.x, cr.y);
        ctx.strokeStyle = cr.col;
        ctx.lineWidth = 2.0;
        ctx.lineCap = 'round';

        ctx.beginPath();
        ctx.moveTo(0, 0); ctx.lineTo(0, -cr.size * 0.5);
        ctx.moveTo(0, -cr.size * 0.3); ctx.lineTo(-cr.size * 0.35, -cr.size * 0.65);
        ctx.moveTo(-cr.size * 0.35, -cr.size * 0.65); ctx.lineTo(-cr.size * 0.2, -cr.size * 0.95);
        ctx.moveTo(-cr.size * 0.35, -cr.size * 0.65); ctx.lineTo(-cr.size * 0.5, -cr.size * 0.9);
        ctx.moveTo(0, -cr.size * 0.5); ctx.lineTo(cr.size * 0.3, -cr.size * 0.8);
        ctx.moveTo(cr.size * 0.3, -cr.size * 0.8); ctx.lineTo(cr.size * 0.45, -cr.size * 1.05);
        ctx.moveTo(cr.size * 0.3, -cr.size * 0.8); ctx.lineTo(cr.size * 0.18, -cr.size * 1.05);
        ctx.stroke();

        ctx.fillStyle = '#ffffff';
        ctx.shadowColor = cr.col;
        ctx.shadowBlur = 6;
        ctx.beginPath();
        ctx.arc(-cr.size * 0.2, -cr.size * 0.95, 2, 0, Math.PI * 2);
        ctx.arc(-cr.size * 0.5, -cr.size * 0.9, 2, 0, Math.PI * 2);
        ctx.arc(cr.size * 0.45, -cr.size * 1.05, 2, 0, Math.PI * 2);
        ctx.arc(cr.size * 0.18, -cr.size * 1.05, 2, 0, Math.PI * 2);
        ctx.fill();
        ctx.shadowBlur = 0;

        ctx.restore();
      });

      ctx.restore();
    }

    // 23. Majestic Whale & Diver Swimming Upward Toward Sunlit Surface (Jul)
    function drawMajesticWhaleDiver(ctx, width, height, alpha, now) {
      ctx.save();
      ctx.globalAlpha = alpha;

      const whaleX = width * 0.50 + Math.sin(now * 0.0008) * 25;
      const whaleY = height * 0.48 + Math.cos(now * 0.001) * 15;
      const whaleLen = Math.min(Math.max(width * 0.18, 95), 160);

      // 1. Majestic Whale Silhouette
      ctx.save();
      ctx.translate(whaleX, whaleY);
      ctx.rotate(-0.25 + Math.sin(now * 0.0012) * 0.04);

      ctx.fillStyle = '#031930';
      ctx.beginPath();
      ctx.moveTo(whaleLen * 0.55, 0);
      ctx.quadraticCurveTo(whaleLen * 0.35, -whaleLen * 0.22, 0, -whaleLen * 0.20);
      ctx.quadraticCurveTo(-whaleLen * 0.35, -whaleLen * 0.15, -whaleLen * 0.55, -whaleLen * 0.04);
      ctx.lineTo(-whaleLen * 0.65, -whaleLen * 0.12);
      ctx.lineTo(-whaleLen * 0.58, 0);
      ctx.lineTo(-whaleLen * 0.65, whaleLen * 0.12);
      ctx.lineTo(-whaleLen * 0.55, whaleLen * 0.04);
      ctx.quadraticCurveTo(-whaleLen * 0.30, whaleLen * 0.18, 0, whaleLen * 0.22);
      ctx.quadraticCurveTo(whaleLen * 0.35, whaleLen * 0.20, whaleLen * 0.55, 0);
      ctx.closePath();
      ctx.fill();

      ctx.strokeStyle = 'rgba(56, 189, 248, 0.7)';
      ctx.lineWidth = 1.4;
      ctx.beginPath();
      ctx.moveTo(whaleLen * 0.55, 0);
      ctx.quadraticCurveTo(whaleLen * 0.35, -whaleLen * 0.22, 0, -whaleLen * 0.20);
      ctx.quadraticCurveTo(-whaleLen * 0.35, -whaleLen * 0.15, -whaleLen * 0.55, -whaleLen * 0.04);
      ctx.stroke();

      const finFlap = Math.sin(now * 0.002) * 4;
      ctx.fillStyle = '#021224';
      ctx.strokeStyle = 'rgba(56, 189, 248, 0.5)';
      ctx.lineWidth = 1.0;
      ctx.beginPath();
      ctx.moveTo(whaleLen * 0.15, whaleLen * 0.05);
      ctx.quadraticCurveTo(whaleLen * 0.05, whaleLen * 0.35 + finFlap, -whaleLen * 0.15, whaleLen * 0.40 + finFlap);
      ctx.quadraticCurveTo(whaleLen * 0.02, whaleLen * 0.20, whaleLen * 0.10, whaleLen * 0.08);
      ctx.closePath();
      ctx.fill();
      ctx.stroke();

      ctx.restore();

      // 2. Free-Diver Silhouette Swimming Near Whale
      const diverX = whaleX - whaleLen * 0.45;
      const diverY = whaleY - whaleLen * 0.28;
      ctx.save();
      ctx.translate(diverX, diverY);
      ctx.rotate(-0.35);

      ctx.fillStyle = '#021020';
      ctx.beginPath();
      ctx.ellipse(0, 0, 7, 3, 0, 0, Math.PI * 2);
      ctx.fill();

      ctx.beginPath();
      ctx.arc(8, -1, 2.5, 0, Math.PI * 2);
      ctx.fill();
      ctx.fillStyle = '#38bdf8';
      ctx.fillRect(9, -2, 1.5, 2);

      ctx.fillStyle = '#00f2fe';
      ctx.beginPath();
      ctx.moveTo(-6, 0);
      ctx.lineTo(-14, -3 + Math.sin(now * 0.006) * 3);
      ctx.lineTo(-12, 3 - Math.sin(now * 0.006) * 3);
      ctx.closePath();
      ctx.fill();

      for (let b = 1; b <= 3; b++) {
        const bx = 10 + b * 5;
        const by = -2 - (b * 6) + Math.sin(now * 0.004 + b) * 3;
        ctx.save();
        ctx.translate(bx, by);
        drawAirBubble(ctx, 1.2 + b * 0.5, '#38bdf8');
        ctx.restore();
      }

      ctx.restore();

      // 3. School of Tiny Fish Orbiting Gracefully
      const numFish = 12;
      for (let f = 0; f < numFish; f++) {
        const fishAngle = (f / numFish) * Math.PI * 2 + now * 0.0008;
        const fx = whaleX + Math.cos(fishAngle) * (whaleLen * 0.75);
        const fy = whaleY + Math.sin(fishAngle) * (whaleLen * 0.45);

        ctx.save();
        ctx.translate(fx, fy);
        ctx.rotate(fishAngle + Math.PI * 0.5);
        ctx.fillStyle = '#38bdf8';
        ctx.beginPath();
        ctx.ellipse(0, 0, 3.5, 1.4, 0, 0, Math.PI * 2);
        ctx.fill();
        ctx.restore();
      }

      ctx.restore();
    }

    // ── Perseid Meteor Shower Drawing Helpers (Aug) ───────────

    // 24. Deep Cosmic Milky Way & Lake Reflection Vista (Aug)
    function drawMilkyWayNightSky(ctx, width, height, alpha, now) {
      ctx.save();
      ctx.globalAlpha = alpha;

      // 1. Cosmic Deep Sky Backdrop Gradient
      const skyGrad = ctx.createLinearGradient(0, 0, 0, height);
      skyGrad.addColorStop(0, 'rgba(6, 7, 25, 0.45)');
      skyGrad.addColorStop(0.5, 'rgba(15, 23, 42, 0.35)');
      skyGrad.addColorStop(0.85, 'rgba(30, 27, 75, 0.45)');
      skyGrad.addColorStop(1, 'rgba(10, 10, 26, 0.75)');
      ctx.fillStyle = skyGrad;
      ctx.fillRect(0, 0, width, height);

      // 2. Diagonal Luminous Milky Way Galaxy Swath
      ctx.save();
      ctx.translate(width * 0.5, height * 0.4);
      ctx.rotate(-0.55);

      const mwGrad = ctx.createLinearGradient(0, -height * 0.4, 0, height * 0.4);
      mwGrad.addColorStop(0, 'transparent');
      mwGrad.addColorStop(0.35, 'rgba(99, 102, 241, 0.08)');
      mwGrad.addColorStop(0.5, 'rgba(252, 211, 77, 0.12)');
      mwGrad.addColorStop(0.65, 'rgba(129, 140, 248, 0.10)');
      mwGrad.addColorStop(1, 'transparent');

      ctx.fillStyle = mwGrad;
      ctx.fillRect(-width * 0.9, -height * 0.35, width * 1.8, height * 0.7);

      const starDustPositions = [
        { x: -width * 0.35, y: -25, r: 1.2, a: 0.7 },
        { x: -width * 0.22, y: 15, r: 1.5, a: 0.8 },
        { x: -width * 0.10, y: -8, r: 1.0, a: 0.6 },
        { x: width * 0.05, y: 12, r: 1.8, a: 0.9 },
        { x: width * 0.18, y: -18, r: 1.3, a: 0.75 },
        { x: width * 0.32, y: 8, r: 1.4, a: 0.85 }
      ];

      starDustPositions.forEach(st => {
        ctx.fillStyle = 'rgba(254, 240, 138, ' + st.a + ')';
        ctx.beginPath();
        ctx.arc(st.x, st.y, st.r, 0, Math.PI * 2);
        ctx.fill();
      });

      ctx.restore();

      // 3. Faint Constellation Asterism Lines (Perseus & Cassiopeia W shape)
      const casStars = [
        { x: width * 0.62, y: height * 0.16 },
        { x: width * 0.67, y: height * 0.22 },
        { x: width * 0.72, y: height * 0.17 },
        { x: width * 0.78, y: height * 0.23 },
        { x: width * 0.83, y: height * 0.19 }
      ];

      ctx.strokeStyle = 'rgba(129, 140, 248, 0.45)';
      ctx.lineWidth = 1.0;
      ctx.beginPath();
      ctx.moveTo(casStars[0].x, casStars[0].y);
      for (let c = 1; c < casStars.length; c++) {
        ctx.lineTo(casStars[c].x, casStars[c].y);
      }
      ctx.stroke();

      casStars.forEach(cs => {
        ctx.fillStyle = '#ffffff';
        ctx.shadowColor = '#818cf8';
        ctx.shadowBlur = 6;
        ctx.beginPath();
        ctx.arc(cs.x, cs.y, 2.0, 0, Math.PI * 2);
        ctx.fill();
        ctx.shadowBlur = 0;
      });

      // 4. Distant Mountain Silhouette on Lower Horizon
      const horizY = height * 0.72;
      ctx.fillStyle = '#080a1a';
      ctx.beginPath();
      ctx.moveTo(0, height);
      ctx.lineTo(0, horizY);
      ctx.lineTo(width * 0.18, horizY - 35);
      ctx.lineTo(width * 0.35, horizY - 15);
      ctx.lineTo(width * 0.52, horizY - 45);
      ctx.lineTo(width * 0.70, horizY - 20);
      ctx.lineTo(width * 0.88, horizY - 40);
      ctx.lineTo(width, horizY - 10);
      ctx.lineTo(width, height);
      ctx.closePath();
      ctx.fill();

      // Starlit Mountain Lake Water Base
      const lakeGrad = ctx.createLinearGradient(0, horizY, 0, height);
      lakeGrad.addColorStop(0, '#090b1e');
      lakeGrad.addColorStop(0.5, '#0c102c');
      lakeGrad.addColorStop(1, '#050612');
      ctx.fillStyle = lakeGrad;
      ctx.fillRect(0, horizY, width, height - horizY);

      // Shimmering Water Sheen Reflection
      const sheenGrad = ctx.createLinearGradient(0, horizY, 0, horizY + 30);
      sheenGrad.addColorStop(0, 'rgba(129, 140, 248, 0.22)');
      sheenGrad.addColorStop(1, 'transparent');
      ctx.fillStyle = sheenGrad;
      ctx.fillRect(0, horizY, width, 30);

      ctx.restore();
    }

    // 25. Layered Alpine Pine Forest Ridge (Aug)
    function drawPerseidPines(ctx, x, y, size, alpha, flip) {
      ctx.save();
      ctx.translate(x, y);
      if (flip) ctx.scale(-1, 1);
      ctx.globalAlpha = alpha;

      const baseW = size * 0.9;

      // Forest mound silhouette
      ctx.fillStyle = '#060814';
      ctx.beginPath();
      ctx.moveTo(0, 0);
      ctx.lineTo(baseW, 0);
      ctx.quadraticCurveTo(baseW * 0.5, -size * 0.25, 0, -size * 0.15);
      ctx.closePath();
      ctx.fill();

      // Cluster of 3 Pine Trees
      const pines = [
        { px: baseW * 0.18, py: -size * 0.15, h: size * 0.95, w: size * 0.32 },
        { px: baseW * 0.45, py: -size * 0.22, h: size * 0.78, w: size * 0.28 },
        { px: baseW * 0.72, py: -size * 0.10, h: size * 0.60, w: size * 0.24 }
      ];

      pines.forEach(p => {
        // Pine Trunk
        ctx.fillStyle = '#03040a';
        ctx.fillRect(p.px - 2.5, p.py - p.h * 0.2, 5, p.h * 0.25);

        // Tiered Pine Foliage
        const tiers = 4;
        for (let t = 0; t < tiers; t++) {
          const prog = t / tiers;
          const ty = p.py - p.h * (0.2 + prog * 0.75);
          const tw = p.w * (1 - prog * 0.65);
          const th = p.h * 0.28;

          ctx.fillStyle = t % 2 === 0 ? '#070b18' : '#0a1024';
          ctx.beginPath();
          ctx.moveTo(p.px, ty - th);
          ctx.lineTo(p.px + tw * 0.5, ty);
          ctx.lineTo(p.px - tw * 0.5, ty);
          ctx.closePath();
          ctx.fill();
        }
      });

      ctx.restore();
    }

    // 26. Cozy Stargazer Campsite with Glowing Campfire & Tent (Aug)
    function drawStargazerCamp(ctx, x, y, size, alpha, now) {
      ctx.save();
      ctx.translate(x, y);
      ctx.globalAlpha = alpha;

      const h = size;
      const w = size * 2.2;

      // 1. Grassy Mound Silhouette
      ctx.fillStyle = '#080a1b';
      ctx.beginPath();
      ctx.moveTo(-w * 0.5, 0);
      ctx.quadraticCurveTo(0, -h * 0.45, w * 0.5, 0);
      ctx.closePath();
      ctx.fill();

      // 2. Cozy Camp Tent
      const tentX = -w * 0.22;
      const tentY = -h * 0.38;
      const tentW = h * 0.85;
      const tentH = h * 0.65;

      ctx.fillStyle = '#c2410c'; // Warm burnt orange canvas
      ctx.beginPath();
      ctx.moveTo(tentX, tentY - tentH);
      ctx.lineTo(tentX + tentW * 0.5, tentY);
      ctx.lineTo(tentX - tentW * 0.5, tentY);
      ctx.closePath();
      ctx.fill();

      // Tent Doorway Flap with Warm Interior Lantern Light
      ctx.fillStyle = '#fef08a';
      ctx.beginPath();
      ctx.moveTo(tentX, tentY - tentH * 0.8);
      ctx.lineTo(tentX + tentW * 0.22, tentY);
      ctx.lineTo(tentX - tentW * 0.05, tentY);
      ctx.closePath();
      ctx.fill();

      // Tent Guy-lines & Pegs
      ctx.strokeStyle = '#475569';
      ctx.lineWidth = 0.8;
      ctx.beginPath();
      ctx.moveTo(tentX, tentY - tentH); ctx.lineTo(tentX - tentW * 0.7, tentY + 2);
      ctx.moveTo(tentX, tentY - tentH); ctx.lineTo(tentX + tentW * 0.7, tentY + 2);
      ctx.stroke();

      // 3. Glowing Campfire
      const fireX = w * 0.08;
      const fireY = -h * 0.38;

      // Campfire Ambient Warm Aura
      const fireAura = ctx.createRadialGradient(fireX, fireY, 2, fireX, fireY, 28);
      const flicker = 0.85 + Math.sin(now * 0.015) * 0.15;
      fireAura.addColorStop(0, 'rgba(251, 146, 60, ' + (0.55 * flicker) + ')');
      fireAura.addColorStop(0.5, 'rgba(239, 68, 68, ' + (0.22 * flicker) + ')');
      fireAura.addColorStop(1, 'transparent');
      ctx.fillStyle = fireAura;
      ctx.beginPath();
      ctx.arc(fireX, fireY, 28, 0, Math.PI * 2);
      ctx.fill();

      // Campfire Logs
      ctx.fillStyle = '#291407';
      ctx.beginPath();
      ctx.moveTo(fireX - 8, fireY + 2); ctx.lineTo(fireX + 8, fireY - 2);
      ctx.moveTo(fireX - 8, fireY - 2); ctx.lineTo(fireX + 8, fireY + 2);
      ctx.lineWidth = 2.4;
      ctx.strokeStyle = '#381c0c';
      ctx.stroke();

      // Flickering Flame Tongues
      const f1 = Math.sin(now * 0.02) * 2.5;
      const f2 = Math.cos(now * 0.025) * 2.0;
      ctx.fillStyle = '#f59e0b';
      ctx.beginPath();
      ctx.moveTo(fireX - 4, fireY);
      ctx.quadraticCurveTo(fireX + f1, fireY - 14, fireX, fireY - 16);
      ctx.quadraticCurveTo(fireX + 4 + f2, fireY - 8, fireX + 4, fireY);
      ctx.closePath();
      ctx.fill();

      ctx.fillStyle = '#fef08a';
      ctx.beginPath();
      ctx.arc(fireX, fireY - 4, 3, 0, Math.PI * 2);
      ctx.fill();

      // 4. Two Anime Stargazer Silhouettes Sitting on Grass
      const sitX = w * 0.28;
      const sitY = -h * 0.34;

      // Stargazer 1 (Left - relaxed sitting)
      ctx.fillStyle = '#050711';
      ctx.beginPath();
      ctx.ellipse(sitX - 7, sitY, 6, 4, 0, 0, Math.PI * 2);
      ctx.fill();
      ctx.beginPath();
      ctx.arc(sitX - 7, sitY - 10, 3.2, 0, Math.PI * 2);
      ctx.fill();

      // Stargazer 2 (Right - pointing arm towards sky)
      ctx.beginPath();
      ctx.ellipse(sitX + 7, sitY, 6.5, 4, 0, 0, Math.PI * 2);
      ctx.fill();
      ctx.beginPath();
      ctx.arc(sitX + 7, sitY - 10, 3.2, 0, Math.PI * 2);
      ctx.fill();

      // Pointing arm extended diagonally up-right
      ctx.strokeStyle = '#050711';
      ctx.lineWidth = 1.6;
      ctx.beginPath();
      ctx.moveTo(sitX + 9, sitY - 8);
      ctx.lineTo(sitX + 18, sitY - 16);
      ctx.stroke();

      ctx.restore();
    }

    // 27. Astronomical Observatory Dome with Telescope (Aug)
    function drawObservatoryDome(ctx, x, y, size, alpha) {
      ctx.save();
      ctx.translate(x, y);
      ctx.globalAlpha = alpha;

      const h = size;
      const w = size * 0.95;

      // Observatory Hill Base Mound
      ctx.fillStyle = '#060814';
      ctx.beginPath();
      ctx.moveTo(-w * 0.8, 0);
      ctx.quadraticCurveTo(0, -h * 0.35, w * 0.8, 0);
      ctx.closePath();
      ctx.fill();

      // Observatory Cylinder Base Building
      const bH = h * 0.40;
      const bW = w * 0.65;
      const bY = -h * 0.28;

      ctx.fillStyle = '#0c1026';
      ctx.strokeStyle = '#1e293b';
      ctx.lineWidth = 1.5;
      ctx.fillRect(-bW * 0.5, bY - bH, bW, bH);
      ctx.strokeRect(-bW * 0.5, bY - bH, bW, bH);

      // Slit Windows on Base
      ctx.fillStyle = '#6366f1';
      ctx.shadowColor = '#6366f1';
      ctx.shadowBlur = 6;
      ctx.fillRect(-bW * 0.3, bY - bH * 0.7, 4, 7);
      ctx.fillRect(bW * 0.3 - 4, bY - bH * 0.7, 4, 7);
      ctx.shadowBlur = 0;

      // Hemispherical Rotating Dome Roof
      const domeR = bW * 0.56;
      const domeY = bY - bH;

      ctx.fillStyle = '#0f172a';
      ctx.beginPath();
      ctx.arc(0, domeY, domeR, Math.PI, 0);
      ctx.closePath();
      ctx.fill();
      ctx.stroke();

      // Observation Slit Aperture Opening
      ctx.fillStyle = '#030712';
      ctx.beginPath();
      ctx.moveTo(-domeR * 0.2, domeY);
      ctx.lineTo(-domeR * 0.15, domeY - domeR * 0.95);
      ctx.lineTo(domeR * 0.15, domeY - domeR * 0.95);
      ctx.lineTo(domeR * 0.2, domeY);
      ctx.closePath();
      ctx.fill();

      // Optical Telescope Tube Protruding out from Slit
      ctx.save();
      ctx.translate(0, domeY - domeR * 0.4);
      ctx.rotate(-0.65); // Angled up towards Perseid radiant

      ctx.fillStyle = '#cbd5e1';
      ctx.strokeStyle = '#64748b';
      ctx.lineWidth = 1.0;
      ctx.fillRect(0, -3.5, 24, 7);
      ctx.strokeRect(0, -3.5, 24, 7);

      // Lens Glow at Tip
      ctx.fillStyle = '#fcd34d';
      ctx.shadowColor = '#fcd34d';
      ctx.shadowBlur = 8;
      ctx.beginPath();
      ctx.arc(24, 0, 3.5, 0, Math.PI * 2);
      ctx.fill();
      ctx.shadowBlur = 0;

      ctx.restore();

      ctx.restore();
    }

    // ── Spooky Haunt Drawing Helpers (Oct) ─────────────────────

    // 28. Giant Harvest Blood Moon & Haunted Castle Horizon (Oct)
    function drawSpookyMoonAndHorizon(ctx, width, height, alpha, now) {
      ctx.save();
      ctx.globalAlpha = alpha;

      const horizY = height * 0.72;

      // 1. Spooky Night Sky Backdrop Gradient
      const skyGrad = ctx.createLinearGradient(0, 0, 0, height);
      skyGrad.addColorStop(0, 'rgba(10, 4, 20, 0.50)');
      skyGrad.addColorStop(0.5, 'rgba(31, 13, 56, 0.40)');
      skyGrad.addColorStop(0.85, 'rgba(56, 14, 40, 0.45)');
      skyGrad.addColorStop(1, 'rgba(15, 6, 26, 0.85)');
      ctx.fillStyle = skyGrad;
      ctx.fillRect(0, 0, width, height);

      // 2. Giant Glowing Harvest Blood Moon (Positioned on the upper right clear of hero text)
      const moonX = Math.min(width * 0.86, width - 90);
      const moonY = Math.max(height * 0.22, 110);
      const moonR = Math.min(Math.max(width * 0.085, 48), 85);

      const moonAura = ctx.createRadialGradient(moonX, moonY, moonR * 0.5, moonX, moonY, moonR * 1.8);
      moonAura.addColorStop(0, 'rgba(251, 146, 60, 0.45)');
      moonAura.addColorStop(0.4, 'rgba(168, 85, 247, 0.22)');
      moonAura.addColorStop(0.8, 'rgba(249, 115, 22, 0.08)');
      moonAura.addColorStop(1, 'transparent');
      ctx.fillStyle = moonAura;
      ctx.beginPath();
      ctx.arc(moonX, moonY, moonR * 1.8, 0, Math.PI * 2);
      ctx.fill();

      const moonGrad = ctx.createRadialGradient(moonX - moonR * 0.25, moonY - moonR * 0.25, 2, moonX, moonY, moonR);
      moonGrad.addColorStop(0, '#fef08a');
      moonGrad.addColorStop(0.4, '#fde047');
      moonGrad.addColorStop(0.75, '#fb923c');
      moonGrad.addColorStop(1, '#ea580c');
      ctx.fillStyle = moonGrad;
      ctx.beginPath();
      ctx.arc(moonX, moonY, moonR, 0, Math.PI * 2);
      ctx.fill();

      ctx.save();
      ctx.beginPath();
      ctx.arc(moonX, moonY, moonR, 0, Math.PI * 2);
      ctx.clip();

      ctx.fillStyle = 'rgba(154, 52, 18, 0.25)';
      const craters = [
        { cx: moonX - moonR * 0.35, cy: moonY - moonR * 0.2, r: moonR * 0.22 },
        { cx: moonX + moonR * 0.25, cy: moonY - moonR * 0.35, r: moonR * 0.18 },
        { cx: moonX - moonR * 0.15, cy: moonY + moonR * 0.35, r: moonR * 0.28 },
        { cx: moonX + moonR * 0.38, cy: moonY + moonR * 0.25, r: moonR * 0.20 },
        { cx: moonX + moonR * 0.05, cy: moonY - moonR * 0.05, r: moonR * 0.14 }
      ];
      craters.forEach(cr => {
        ctx.beginPath();
        ctx.arc(cr.cx, cr.cy, cr.r, 0, Math.PI * 2);
        ctx.fill();
      });
      ctx.restore();

      // 3. Gothic Haunted Castle on Horizon
      const cX = width * 0.44;
      const cY = horizY;
      const cW = 85;
      const cH = 90;

      ctx.fillStyle = '#0c0517';
      ctx.fillRect(cX - cW * 0.35, cY - cH * 0.65, cW * 0.7, cH * 0.65);
      ctx.fillRect(cX - cW * 0.48, cY - cH * 0.85, cW * 0.25, cH * 0.85);
      ctx.beginPath();
      ctx.moveTo(cX - cW * 0.52, cY - cH * 0.85);
      ctx.lineTo(cX - cW * 0.35, cY - cH * 1.15);
      ctx.lineTo(cX - cW * 0.20, cY - cH * 0.85);
      ctx.closePath();
      ctx.fill();

      ctx.beginPath();
      ctx.moveTo(cX - cW * 0.18, cY - cH * 0.65);
      ctx.lineTo(cX, cY - cH * 1.05);
      ctx.lineTo(cX + cW * 0.18, cY - cH * 0.65);
      ctx.closePath();
      ctx.fill();

      ctx.fillRect(cX + cW * 0.24, cY - cH * 0.75, cW * 0.24, cH * 0.75);
      ctx.beginPath();
      ctx.moveTo(cX + cW * 0.20, cY - cH * 0.75);
      ctx.lineTo(cX + cW * 0.36, cY - cH * 1.0);
      ctx.lineTo(cX + cW * 0.52, cY - cH * 0.75);
      ctx.closePath();
      ctx.fill();

      ctx.fillStyle = '#fef08a';
      ctx.shadowColor = '#f59e0b';
      ctx.shadowBlur = 6;
      ctx.fillRect(cX - cW * 0.40, cY - cH * 0.65, 4, 8);
      ctx.fillRect(cX - cW * 0.08, cY - cH * 0.48, 5, 9);
      ctx.fillRect(cX + cW * 0.30, cY - cH * 0.55, 4, 8);
      ctx.shadowBlur = 0;

      // 4. Gnarled Bare Spooky Trees
      const deadTrees = [
        { tx: width * 0.22, ty: horizY, h: 70, w: 45 },
        { tx: width * 0.75, ty: horizY, h: 80, w: 50 }
      ];

      deadTrees.forEach(dt => {
        ctx.strokeStyle = '#0a0314';
        ctx.lineWidth = 4.0;
        ctx.lineCap = 'round';
        ctx.beginPath();
        ctx.moveTo(dt.tx, dt.ty);
        ctx.quadraticCurveTo(dt.tx - 6, dt.ty - dt.h * 0.5, dt.tx, dt.ty - dt.h);
        ctx.stroke();

        ctx.lineWidth = 2.0;
        ctx.beginPath();
        ctx.moveTo(dt.tx - 3, dt.ty - dt.h * 0.55);
        ctx.quadraticCurveTo(dt.tx - dt.w * 0.6, dt.ty - dt.h * 0.75, dt.tx - dt.w * 0.8, dt.ty - dt.h * 0.95);
        ctx.moveTo(dt.tx + 2, dt.ty - dt.h * 0.65);
        ctx.quadraticCurveTo(dt.tx + dt.w * 0.5, dt.ty - dt.h * 0.85, dt.tx + dt.w * 0.75, dt.ty - dt.h * 1.05);
        ctx.moveTo(dt.tx, dt.ty - dt.h);
        ctx.lineTo(dt.tx - 12, dt.ty - dt.h - 15);
        ctx.moveTo(dt.tx, dt.ty - dt.h);
        ctx.lineTo(dt.tx + 10, dt.ty - dt.h - 18);
        ctx.stroke();
      });

      // 5. Spooky Horizon Hill & Wrought-Iron Spiked Fence
      ctx.fillStyle = '#080210';
      ctx.beginPath();
      ctx.moveTo(0, height);
      ctx.lineTo(0, horizY);
      ctx.quadraticCurveTo(width * 0.35, horizY - 25, width * 0.65, horizY - 10);
      ctx.quadraticCurveTo(width * 0.85, horizY - 30, width, horizY - 15);
      ctx.lineTo(width, height);
      ctx.closePath();
      ctx.fill();

      ctx.strokeStyle = '#1e112e';
      ctx.lineWidth = 1.2;
      const numPickets = Math.ceil(width / 22);
      for (let p = 0; p <= numPickets; p++) {
        const px = p * 22;
        const py = horizY - 12 + Math.sin(p * 0.4) * 4;
        ctx.beginPath();
        ctx.moveTo(px, py);
        ctx.lineTo(px, py - 18);
        ctx.stroke();

        ctx.fillStyle = '#1e112e';
        ctx.beginPath();
        ctx.moveTo(px - 2.5, py - 16);
        ctx.lineTo(px, py - 21);
        ctx.lineTo(px + 2.5, py - 16);
        ctx.closePath();
        ctx.fill();
      }

      ctx.beginPath();
      ctx.moveTo(0, horizY - 20);
      ctx.lineTo(width, horizY - 20);
      ctx.stroke();

      ctx.restore();
    }

    // 29. Gothic Graveyard Hill with Weathered Cross, Cauldron & Blinking Eyes (Oct)
    function drawSpookyGraveyardHill(ctx, x, y, size, alpha, now, flip) {
      ctx.save();
      ctx.translate(x, y);
      if (flip) ctx.scale(-1, 1);
      ctx.globalAlpha = alpha;

      const w = size * 2.2;
      const h = size;

      // 1. Grassy Cemetery Mound
      ctx.fillStyle = '#090314';
      ctx.beginPath();
      ctx.moveTo(0, 0);
      ctx.lineTo(-w, 0);
      ctx.quadraticCurveTo(-w * 0.5, -h * 0.55, 0, -h * 0.35);
      ctx.closePath();
      ctx.fill();

      // 2. Weathered Stone Celtic Cross Tombstone
      const crossX = -w * 0.35;
      const crossY = -h * 0.38;
      const crossH = h * 0.55;

      ctx.fillStyle = '#1e162a';
      ctx.strokeStyle = '#38264e';
      ctx.lineWidth = 1.0;
      ctx.fillRect(crossX - 4, crossY - crossH, 8, crossH);
      ctx.strokeRect(crossX - 4, crossY - crossH, 8, crossH);
      ctx.fillRect(crossX - 14, crossY - crossH * 0.72, 28, 7);
      ctx.strokeRect(crossX - 14, crossY - crossH * 0.72, 28, 7);
      ctx.beginPath();
      ctx.arc(crossX, crossY - crossH * 0.68, 10, 0, Math.PI * 2);
      ctx.stroke();

      // 3. Rounded R.I.P. Tombstone
      const ripX = -w * 0.65;
      const ripY = -h * 0.28;
      ctx.fillStyle = '#181024';
      ctx.strokeStyle = '#2d1c44';
      ctx.beginPath();
      ctx.moveTo(ripX - 12, ripY);
      ctx.lineTo(ripX - 12, ripY - 26);
      ctx.quadraticCurveTo(ripX, ripY - 36, ripX + 12, ripY - 26);
      ctx.lineTo(ripX + 12, ripY);
      ctx.closePath();
      ctx.fill();
      ctx.stroke();

      ctx.fillStyle = '#a855f7';
      ctx.font = 'bold 7px serif';
      ctx.textAlign = 'center';
      ctx.fillText('R.I.P', ripX, ripY - 14);

      // 4. Carved Jack-o'-Lantern with Glowing Fiery Face
      const pX = -w * 0.16;
      const pY = -h * 0.32;
      const pSize = h * 0.22;

      ctx.fillStyle = '#ea580c';
      ctx.beginPath();
      ctx.ellipse(pX, pY, pSize * 0.95, pSize * 0.75, 0, 0, Math.PI * 2);
      ctx.fill();

      ctx.fillStyle = '#15803d';
      ctx.beginPath();
      ctx.moveTo(pX - 2, pY - pSize * 0.75);
      ctx.quadraticCurveTo(pX + 4, pY - pSize * 1.15, pX + 8, pY - pSize * 1.05);
      ctx.lineTo(pX + 2, pY - pSize * 0.75);
      ctx.closePath();
      ctx.fill();

      const pGlow = 0.8 + Math.sin(now * 0.008) * 0.2;
      ctx.fillStyle = '#fef08a';
      ctx.shadowColor = '#f97316';
      ctx.shadowBlur = 8 * pGlow;

      ctx.beginPath();
      ctx.moveTo(pX - pSize * 0.45, pY - pSize * 0.15);
      ctx.lineTo(pX - pSize * 0.15, pY - pSize * 0.15);
      ctx.lineTo(pX - pSize * 0.3, pY - pSize * 0.45);
      ctx.closePath();
      ctx.fill();

      ctx.beginPath();
      ctx.moveTo(pX + pSize * 0.15, pY - pSize * 0.15);
      ctx.lineTo(pX + pSize * 0.45, pY - pSize * 0.15);
      ctx.lineTo(pX + pSize * 0.3, pY - pSize * 0.45);
      ctx.closePath();
      ctx.fill();

      ctx.beginPath();
      ctx.moveTo(pX - pSize * 0.55, pY + pSize * 0.15);
      ctx.lineTo(pX - pSize * 0.25, pY + pSize * 0.38);
      ctx.lineTo(pX, pY + pSize * 0.18);
      ctx.lineTo(pX + pSize * 0.25, pY + pSize * 0.38);
      ctx.lineTo(pX + pSize * 0.55, pY + pSize * 0.15);
      ctx.lineTo(pX, pY + pSize * 0.55);
      ctx.closePath();
      ctx.fill();
      ctx.shadowBlur = 0;

      // 5. Bubbling Witch's Cauldron
      const cauldX = -w * 0.82;
      const cauldY = -h * 0.18;
      const cauldR = h * 0.20;

      ctx.fillStyle = '#0f051a';
      ctx.strokeStyle = '#2d1348';
      ctx.lineWidth = 1.5;
      ctx.beginPath();
      ctx.arc(cauldX, cauldY, cauldR, 0.2, Math.PI - 0.2);
      ctx.lineTo(cauldX - cauldR * 1.1, cauldY - 4);
      ctx.lineTo(cauldX + cauldR * 1.1, cauldY - 4);
      ctx.closePath();
      ctx.fill();
      ctx.stroke();

      ctx.fillStyle = '#a3e635';
      ctx.shadowColor = '#4ade80';
      ctx.shadowBlur = 8;
      ctx.beginPath();
      ctx.ellipse(cauldX, cauldY - 4, cauldR * 0.95, 4.5, 0, 0, Math.PI * 2);
      ctx.fill();
      ctx.shadowBlur = 0;

      for (let b = 1; b <= 3; b++) {
        const bubProg = ((now * 0.0015 + b * 0.35) % 1);
        const bubY = (cauldY - 6) - (bubProg * 24);
        const bubX = cauldX + Math.sin(now * 0.004 + b) * 8;
        const bubAlpha = (1 - bubProg) * 0.75;
        ctx.fillStyle = 'rgba(163, 230, 53, ' + bubAlpha + ')';
        ctx.beginPath();
        ctx.arc(bubX, bubY, 2.2 * (1 - bubProg * 0.5), 0, Math.PI * 2);
        ctx.fill();
      }

      // 6. Sinister Glowing Eyes in Dark Cave Hollow (blinking)
      const eyeBlink = Math.sin(now * 0.002) > 0.9 ? 0 : 1;
      if (eyeBlink > 0) {
        const eyeX = -w * 0.48;
        const eyeY = -h * 0.15;
        ctx.fillStyle = '#ef4444';
        ctx.shadowColor = '#ef4444';
        ctx.shadowBlur = 6;
        ctx.beginPath();
        ctx.ellipse(eyeX - 4, eyeY, 2.5, 1.4, -0.2, 0, Math.PI * 2);
        ctx.ellipse(eyeX + 4, eyeY, 2.5, 1.4, 0.2, 0, Math.PI * 2);
        ctx.fill();
        ctx.shadowBlur = 0;
      }

      ctx.restore();
    }

    // ── Neon Spirit Forest Drawing Helpers (Jan) ───────────────

    // 30. Mystical Neon Forest Horizon & Reflective Stream (Jan)
    function drawNeonForestVista(ctx, width, height, alpha, now) {
      ctx.save();
      ctx.globalAlpha = alpha;

      const horizY = height * 0.68;

      // 1. Deep Cyber Twilight Forest Sky
      const skyGrad = ctx.createLinearGradient(0, 0, 0, height);
      skyGrad.addColorStop(0, 'rgba(5, 8, 22, 0.55)');
      skyGrad.addColorStop(0.45, 'rgba(9, 27, 54, 0.40)');
      skyGrad.addColorStop(0.8, 'rgba(26, 12, 48, 0.45)');
      skyGrad.addColorStop(1, 'rgba(4, 8, 20, 0.85)');
      ctx.fillStyle = skyGrad;
      ctx.fillRect(0, 0, width, height);

      // 2. Distant Forest Trees in Luminous Teal/Violet Mist
      const mistGrad = ctx.createLinearGradient(0, horizY - 60, 0, horizY + 20);
      mistGrad.addColorStop(0, 'transparent');
      mistGrad.addColorStop(0.5, 'rgba(56, 219, 245, 0.18)');
      mistGrad.addColorStop(1, 'rgba(196, 181, 253, 0.12)');
      ctx.fillStyle = mistGrad;
      ctx.fillRect(0, horizY - 60, width, 80);

      // Distant Layer 1 Tree Silhouettes
      ctx.fillStyle = '#060d1e';
      ctx.beginPath();
      ctx.moveTo(0, horizY);
      for (let x = 0; x <= width; x += 45) {
        const th = 35 + Math.sin(x * 0.05) * 15 + Math.cos(x * 0.02) * 10;
        ctx.lineTo(x, horizY - th);
        ctx.lineTo(x + 22, horizY - th * 0.4);
      }
      ctx.lineTo(width, horizY);
      ctx.closePath();
      ctx.fill();

      // 3. Glowing Mountain Stream & Water Reflection on Horizon
      const streamGrad = ctx.createLinearGradient(0, horizY, 0, height);
      streamGrad.addColorStop(0, '#041528');
      streamGrad.addColorStop(0.4, '#08253e');
      streamGrad.addColorStop(1, '#030a14');
      ctx.fillStyle = streamGrad;
      ctx.fillRect(0, horizY, width, height - horizY);

      // Bioluminescent Water Sheen & Ripple Glows
      const waterRipples = [
        { x: width * 0.42, y: horizY + 35, r: 24, phase: 0 },
        { x: width * 0.65, y: horizY + 55, r: 32, phase: 1.8 },
        { x: width * 0.28, y: horizY + 75, r: 20, phase: 3.2 }
      ];

      waterRipples.forEach(rp => {
        const prog = ((now * 0.001 + rp.phase) % 3) / 3;
        const curR = rp.r * (0.3 + prog * 0.7);
        const ripAlpha = (1 - prog) * 0.45;
        ctx.strokeStyle = 'rgba(56, 219, 245, ' + ripAlpha + ')';
        ctx.lineWidth = 1.0;
        ctx.beginPath();
        ctx.ellipse(rp.x, rp.y, curR, curR * 0.3, 0, 0, Math.PI * 2);
        ctx.stroke();
      });

      // Luminous Water Lily Pads with Glowing Petals
      const lilies = [
        { x: width * 0.48, y: horizY + 45, col: '#38dbf5' },
        { x: width * 0.58, y: horizY + 65, col: '#c084fc' }
      ];

      lilies.forEach(l => {
        ctx.fillStyle = '#064e3b';
        ctx.beginPath();
        ctx.ellipse(l.x, l.y, 10, 4, 0, 0, Math.PI * 2);
        ctx.fill();

        ctx.fillStyle = l.col;
        ctx.shadowColor = l.col;
        ctx.shadowBlur = 6;
        ctx.beginPath();
        ctx.arc(l.x, l.y - 2, 2.5, 0, Math.PI * 2);
        ctx.fill();
        ctx.shadowBlur = 0;
      });

      ctx.restore();
    }

    // 31. Ancient Bioluminescent Spirit Tree with Glowing Vascular Veins (Jan)
    function drawNeonSpiritTree(ctx, x, y, size, alpha, now) {
      ctx.save();
      ctx.translate(x, y);
      ctx.globalAlpha = alpha;

      const h = size;
      const bW = size * 0.55;

      // 1. Mossy Riverbank Shore Mound
      ctx.fillStyle = '#050a18';
      ctx.beginPath();
      ctx.moveTo(0, 0);
      ctx.lineTo(bW * 0.9, 0);
      ctx.quadraticCurveTo(bW * 0.4, -h * 0.18, 0, -h * 0.12);
      ctx.closePath();
      ctx.fill();

      // 2. Ancient Gnarled Spirit Tree Trunk & Spreading Roots
      ctx.fillStyle = '#081124';
      ctx.beginPath();
      ctx.moveTo(0, 0);
      ctx.quadraticCurveTo(bW * 0.35, 0, bW * 0.28, -h * 0.25);
      ctx.quadraticCurveTo(bW * 0.22, -h * 0.55, bW * 0.15, -h * 0.82);
      ctx.lineTo(0, -h * 0.88);
      ctx.closePath();
      ctx.fill();

      ctx.strokeStyle = '#040914';
      ctx.lineWidth = 2.0;
      ctx.stroke();

      // 3. Pulsing Electric Cyan / Violet Vascular Veins along Trunk
      const pulse1 = 0.65 + Math.sin(now * 0.0025) * 0.35;
      const pulse2 = 0.65 + Math.cos(now * 0.002) * 0.35;

      ctx.strokeStyle = 'rgba(56, 219, 245, ' + pulse1 + ')';
      ctx.shadowColor = '#38dbf5';
      ctx.shadowBlur = 10;
      ctx.lineWidth = 2.4;
      ctx.beginPath();
      ctx.moveTo(bW * 0.26, -2);
      ctx.quadraticCurveTo(bW * 0.24, -h * 0.22, bW * 0.19, -h * 0.48);
      ctx.quadraticCurveTo(bW * 0.16, -h * 0.68, bW * 0.12, -h * 0.84);
      ctx.stroke();

      ctx.strokeStyle = 'rgba(192, 132, 252, ' + pulse2 + ')';
      ctx.shadowColor = '#c084fc';
      ctx.lineWidth = 1.4;
      ctx.beginPath();
      ctx.moveTo(bW * 0.19, -h * 0.48);
      ctx.quadraticCurveTo(bW * 0.28, -h * 0.58, bW * 0.35, -h * 0.68);
      ctx.moveTo(bW * 0.22, -h * 0.30);
      ctx.quadraticCurveTo(bW * 0.12, -h * 0.40, bW * 0.06, -h * 0.55);
      ctx.stroke();
      ctx.shadowBlur = 0;

      // 4. Layered Bioluminescent Foliage Cloud Clusters
      const neonCanopies = [
        { cx: bW * 0.20, cy: -h * 0.85, rx: 55, ry: 38, col1: '#38dbf5', col2: '#0284c7' },
        { cx: bW * 0.35, cy: -h * 0.72, rx: 48, ry: 34, col1: '#c084fc', col2: '#7c3aed' },
        { cx: bW * 0.08, cy: -h * 0.78, rx: 50, ry: 35, col1: '#38dbf5', col2: '#0891b2' },
        { cx: bW * 0.25, cy: -h * 0.62, rx: 42, ry: 30, col1: '#e879f9', col2: '#a21caf' },
        { cx: bW * 0.42, cy: -h * 0.55, rx: 36, ry: 26, col1: '#38dbf5', col2: '#0369a1' }
      ];

      neonCanopies.forEach((nc, idx) => {
        const canGlow = ctx.createRadialGradient(nc.cx, nc.cy, 4, nc.cx, nc.cy, nc.rx);
        canGlow.addColorStop(0, nc.col1);
        canGlow.addColorStop(0.65, nc.col2);
        canGlow.addColorStop(1, 'transparent');
        ctx.fillStyle = canGlow;
        ctx.beginPath();
        ctx.ellipse(nc.cx, nc.cy, nc.rx, nc.ry, -0.15, 0, Math.PI * 2);
        ctx.fill();

        for (let n = 0; n < 4; n++) {
          const na = (n / 4) * Math.PI * 2 + now * 0.001;
          const nx = nc.cx + Math.cos(na) * (nc.rx * 0.5);
          const ny = nc.cy + Math.sin(na) * (nc.ry * 0.5);
          ctx.fillStyle = '#ffffff';
          ctx.shadowColor = nc.col1;
          ctx.shadowBlur = 6;
          ctx.beginPath();
          ctx.arc(nx, ny, 1.8, 0, Math.PI * 2);
          ctx.fill();
          ctx.shadowBlur = 0;
        }
      });

      // 5. Dangling Bioluminescent Weeping Vine Tendrils
      const vines = [
        { vx: bW * 0.12, vy: -h * 0.72, len: 65, col: '#38dbf5' },
        { vx: bW * 0.25, vy: -h * 0.60, len: 75, col: '#c084fc' },
        { vx: bW * 0.38, vy: -h * 0.52, len: 55, col: '#38dbf5' },
        { vx: bW * 0.45, vy: -h * 0.48, len: 45, col: '#f472b6' }
      ];

      vines.forEach((vn, idx) => {
        const sway = Math.sin(now * 0.002 + idx * 1.4) * 8;
        ctx.strokeStyle = vn.col;
        ctx.lineWidth = 1.4;
        ctx.beginPath();
        ctx.moveTo(vn.vx, vn.vy);
        ctx.quadraticCurveTo(vn.vx + sway * 0.5, vn.vy + vn.len * 0.5, vn.vx + sway, vn.vy + vn.len);
        ctx.stroke();

        ctx.fillStyle = '#ffffff';
        ctx.shadowColor = vn.col;
        ctx.shadowBlur = 8;
        ctx.beginPath();
        ctx.arc(vn.vx + sway, vn.vy + vn.len, 2.5, 0, Math.PI * 2);
        ctx.fill();
        ctx.shadowBlur = 0;
      });

      ctx.restore();
    }

    // 32. Overhanging Neon Canopy & Glowing Crystal Mushrooms (Jan)
    function drawNeonOverhangingCanopy(ctx, width, height, alpha, now) {
      ctx.save();
      ctx.globalAlpha = alpha;

      const cSize = Math.min(width * 0.42, 360);

      // 1. Top-Right Overhanging Ancient Bough
      ctx.strokeStyle = '#081124';
      ctx.lineWidth = 9;
      ctx.lineCap = 'round';
      ctx.beginPath();
      ctx.moveTo(width + 15, -10);
      ctx.bezierCurveTo(width - cSize * 0.3, cSize * 0.15, width - cSize * 0.55, cSize * 0.28, width - cSize * 0.75, cSize * 0.36);
      ctx.stroke();

      ctx.strokeStyle = 'rgba(56, 219, 245, 0.75)';
      ctx.lineWidth = 1.6;
      ctx.beginPath();
      ctx.moveTo(width + 15, -8);
      ctx.bezierCurveTo(width - cSize * 0.3, cSize * 0.16, width - cSize * 0.55, cSize * 0.29, width - cSize * 0.75, cSize * 0.37);
      ctx.stroke();

      // 2. Right Shore Bank with Glowing Crystals & Bioluminescent Mushrooms
      const bankW = Math.min(width * 0.25, 220);
      const bankH = 75;

      ctx.fillStyle = '#060c1c';
      ctx.beginPath();
      ctx.moveTo(width, height);
      ctx.lineTo(width - bankW, height);
      ctx.quadraticCurveTo(width - bankW * 0.5, height - bankH, width, height - bankH * 0.7);
      ctx.closePath();
      ctx.fill();

      // Glowing Crystal Cluster
      const crysX = width - bankW * 0.45;
      const crysY = height - bankH * 0.65;
      const crystals = [
        { dx: -6, dy: 0, w: 7, h: 28, col: '#38dbf5' },
        { dx: 4, dy: 3, w: 9, h: 36, col: '#c084fc' },
        { dx: 14, dy: 6, w: 6, h: 22, col: '#38dbf5' }
      ];

      crystals.forEach(cr => {
        ctx.fillStyle = cr.col;
        ctx.shadowColor = cr.col;
        ctx.shadowBlur = 8;
        ctx.beginPath();
        ctx.moveTo(crysX + cr.dx, crysY + cr.dy);
        ctx.lineTo(crysX + cr.dx + cr.w * 0.5, crysY + cr.dy - cr.h);
        ctx.lineTo(crysX + cr.dx + cr.w, crysY + cr.dy);
        ctx.closePath();
        ctx.fill();
        ctx.shadowBlur = 0;
      });

      // Bioluminescent Fairy Mushrooms
      const mushs = [
        { mx: width - bankW * 0.72, my: height - 12, s: 14, col: '#38dbf5' },
        { mx: width - bankW * 0.82, my: height - 10, s: 10, col: '#e879f9' }
      ];

      mushs.forEach(m => {
        ctx.fillStyle = '#0f172a';
        ctx.fillRect(m.mx - 1.5, m.my - m.s, 3, m.s);

        ctx.fillStyle = m.col;
        ctx.shadowColor = m.col;
        ctx.shadowBlur = 8;
        ctx.beginPath();
        ctx.arc(m.mx, m.my - m.s, m.s * 0.65, Math.PI, 0);
        ctx.closePath();
        ctx.fill();
        ctx.shadowBlur = 0;
      });

      ctx.restore();
    }

    // ── Vesak Festival of Lights Dedicated Silhouette Drawers ───────────

    // Draw realistic lotus petal shape with gradient
    function drawLotusPetal(ctx, length, width, baseColor, tipColor) {
      const grad = ctx.createLinearGradient(0, 0, 0, -length);
      grad.addColorStop(0, baseColor || '#f43f5e');
      grad.addColorStop(0.6, tipColor || '#fda4af');
      grad.addColorStop(1, '#ffffff');
      ctx.fillStyle = grad;

      ctx.beginPath();
      ctx.moveTo(0, 0);
      ctx.bezierCurveTo(-width * 0.7, -length * 0.35, -width * 0.9, -length * 0.7, 0, -length);
      ctx.bezierCurveTo(width * 0.9, -length * 0.7, width * 0.7, -length * 0.35, 0, 0);
      ctx.closePath();
      ctx.fill();
    }

    // Draw blooming lotus flower with central flickering candle flame
    function drawVesakLotusFlower(ctx, x, y, scale, alpha, now, floatPhase = 0) {
      ctx.save();
      const wave = Math.sin(now * 0.0025 + floatPhase) * 3;
      ctx.translate(x, y + wave);
      ctx.globalAlpha = alpha;

      const s = scale;

      // 1. Water Ripples around lotus
      const rippleRadius = s * 1.6 + Math.sin(now * 0.002 + floatPhase) * 4;
      ctx.strokeStyle = 'rgba(251, 191, 36, 0.25)';
      ctx.lineWidth = 1.0;
      ctx.beginPath();
      ctx.ellipse(0, s * 0.2, rippleRadius, rippleRadius * 0.3, 0, 0, Math.PI * 2);
      ctx.stroke();

      // 2. Large Emerald Lily Pad base
      ctx.fillStyle = '#064e3b';
      ctx.beginPath();
      ctx.ellipse(0, s * 0.15, s * 1.4, s * 0.45, 0, 0, Math.PI * 2);
      ctx.fill();

      // Pad Notch / Cleft
      ctx.fillStyle = 'rgba(10, 15, 30, 0.8)';
      ctx.beginPath();
      ctx.moveTo(0, s * 0.15);
      ctx.lineTo(s * 1.4, s * 0.15);
      ctx.lineTo(s * 1.2, s * 0.3);
      ctx.closePath();
      ctx.fill();

      // 3. Blooming Lotus Outer Petals
      const outerPetals = 8;
      for (let i = 0; i < outerPetals; i++) {
        const angle = (i / outerPetals) * Math.PI * 2;
        ctx.save();
        ctx.translate(Math.cos(angle) * (s * 0.35), Math.sin(angle) * (s * 0.15));
        ctx.rotate(angle * 0.4);
        drawLotusPetal(ctx, s * 0.85, s * 0.45, '#e11d48', '#fbcfe8');
        ctx.restore();
      }

      // 4. Inner Petals
      const innerPetals = 6;
      for (let i = 0; i < innerPetals; i++) {
        const angle = (i / innerPetals) * Math.PI * 2 + 0.3;
        ctx.save();
        ctx.translate(Math.cos(angle) * (s * 0.2), Math.sin(angle) * (s * 0.08));
        ctx.rotate(angle * 0.3);
        drawLotusPetal(ctx, s * 0.65, s * 0.35, '#f43f5e', '#ffffff');
        ctx.restore();
      }

      // 5. Central Golden Clay Oil Lamp (Pahan / Diya)
      ctx.fillStyle = '#78350f';
      ctx.beginPath();
      ctx.ellipse(0, -s * 0.1, s * 0.28, s * 0.14, 0, 0, Math.PI * 2);
      ctx.fill();

      // Oil pool
      ctx.fillStyle = '#d97706';
      ctx.beginPath();
      ctx.ellipse(0, -s * 0.12, s * 0.22, s * 0.09, 0, 0, Math.PI * 2);
      ctx.fill();

      // 6. Flickering Candle Flame & Golden Aura
      const fPulse = 0.85 + Math.sin(now * 0.012 + floatPhase * 2) * 0.15;
      const flameH = s * 0.45 * fPulse;

      // Golden Flame Glow
      const fGlow = ctx.createRadialGradient(0, -s * 0.15 - flameH * 0.5, 1, 0, -s * 0.15 - flameH * 0.5, s * 1.5);
      fGlow.addColorStop(0, 'rgba(254, 240, 138, 0.9)');
      fGlow.addColorStop(0.35, 'rgba(251, 191, 36, 0.45)');
      fGlow.addColorStop(0.7, 'rgba(249, 115, 22, 0.15)');
      fGlow.addColorStop(1, 'transparent');
      ctx.fillStyle = fGlow;
      ctx.beginPath();
      ctx.arc(0, -s * 0.15 - flameH * 0.5, s * 1.5, 0, Math.PI * 2);
      ctx.fill();

      // Outer Orange Flame
      ctx.fillStyle = '#f97316';
      ctx.beginPath();
      ctx.moveTo(-s * 0.08, -s * 0.12);
      ctx.quadraticCurveTo(-s * 0.12, -s * 0.12 - flameH * 0.6, 0, -s * 0.12 - flameH);
      ctx.quadraticCurveTo(s * 0.12, -s * 0.12 - flameH * 0.6, s * 0.08, -s * 0.12);
      ctx.closePath();
      ctx.fill();

      // Inner Golden Yellow Flame
      ctx.fillStyle = '#fef08a';
      ctx.beginPath();
      ctx.moveTo(-s * 0.04, -s * 0.12);
      ctx.quadraticCurveTo(-s * 0.06, -s * 0.12 - flameH * 0.5, 0, -s * 0.12 - flameH * 0.8);
      ctx.quadraticCurveTo(s * 0.06, -s * 0.12 - flameH * 0.5, s * 0.04, -s * 0.12);
      ctx.closePath();
      ctx.fill();

      // White Hot Flame Core
      ctx.fillStyle = '#ffffff';
      ctx.beginPath();
      ctx.arc(0, -s * 0.14, s * 0.035, 0, Math.PI * 2);
      ctx.fill();

      // 7. Water Shimmer Reflection under the lotus
      const reflGrad = ctx.createLinearGradient(0, s * 0.2, 0, s * 0.9);
      reflGrad.addColorStop(0, 'rgba(251, 191, 36, 0.45)');
      reflGrad.addColorStop(0.5, 'rgba(249, 115, 22, 0.25)');
      reflGrad.addColorStop(1, 'transparent');
      ctx.fillStyle = reflGrad;
      ctx.fillRect(-s * 0.35, s * 0.2, s * 0.7, s * 0.7);

      ctx.restore();
    }

    // 1. Vesak Water Lake Vista & Sacred Vesak Full Moon
    function drawVesakWaterVista(ctx, width, height, alpha, now) {
      ctx.save();
      ctx.globalAlpha = alpha;

      const waterY = height * 0.62;

      // 1. Distant Misty Twilight Mountain Silhouettes
      ctx.fillStyle = '#0f0a1c';
      ctx.beginPath();
      ctx.moveTo(0, waterY);
      ctx.bezierCurveTo(width * 0.15, waterY - 70, width * 0.35, waterY - 45, width * 0.5, waterY - 60);
      ctx.bezierCurveTo(width * 0.68, waterY - 80, width * 0.85, waterY - 40, width, waterY - 55);
      ctx.lineTo(width, waterY);
      ctx.closePath();
      ctx.fill();

      // Secondary Closer Hill Layer
      ctx.fillStyle = '#140c24';
      ctx.beginPath();
      ctx.moveTo(0, waterY);
      ctx.bezierCurveTo(width * 0.2, waterY - 40, width * 0.45, waterY - 25, width * 0.7, waterY - 45);
      ctx.bezierCurveTo(width * 0.85, waterY - 30, width * 0.95, waterY - 20, width, waterY - 35);
      ctx.lineTo(width, waterY);
      ctx.closePath();
      ctx.fill();

      // 2. Sacred Vesak Full Moon (Poya Moon) in the Upper Night Sky
      const moonX = width * 0.82;
      const moonY = height * 0.22;
      const moonR = Math.min(Math.max(width * 0.045, 34), 54);

      // Multi-tier Ethereal Golden Moon Halo Glow
      const moonHalo = ctx.createRadialGradient(moonX, moonY, moonR * 0.8, moonX, moonY, moonR * 3.8);
      moonHalo.addColorStop(0, 'rgba(254, 240, 138, 0.45)');
      moonHalo.addColorStop(0.35, 'rgba(251, 191, 36, 0.22)');
      moonHalo.addColorStop(0.7, 'rgba(244, 63, 94, 0.08)');
      moonHalo.addColorStop(1, 'transparent');
      ctx.fillStyle = moonHalo;
      ctx.beginPath();
      ctx.arc(moonX, moonY, moonR * 3.8, 0, Math.PI * 2);
      ctx.fill();

      // Luminous Full Moon Disc
      const moonGrad = ctx.createRadialGradient(moonX - moonR * 0.25, moonY - moonR * 0.25, moonR * 0.1, moonX, moonY, moonR);
      moonGrad.addColorStop(0, '#ffffff');
      moonGrad.addColorStop(0.5, '#fef08a');
      moonGrad.addColorStop(0.85, '#fde047');
      moonGrad.addColorStop(1, '#fbbf24');
      ctx.fillStyle = moonGrad;
      ctx.beginPath();
      ctx.arc(moonX, moonY, moonR, 0, Math.PI * 2);
      ctx.fill();

      // Moon Mare / Texture Craters
      ctx.fillStyle = 'rgba(217, 119, 6, 0.18)';
      ctx.beginPath();
      ctx.arc(moonX - moonR * 0.3, moonY - moonR * 0.2, moonR * 0.25, 0, Math.PI * 2);
      ctx.arc(moonX + moonR * 0.2, moonY + moonR * 0.25, moonR * 0.3, 0, Math.PI * 2);
      ctx.arc(moonX - moonR * 0.1, moonY + moonR * 0.35, moonR * 0.18, 0, Math.PI * 2);
      ctx.fill();

      // 3. Mirror-like Calm Water Surface
      const waterGrad = ctx.createLinearGradient(0, waterY, 0, height);
      waterGrad.addColorStop(0, 'rgba(10, 6, 20, 0.95)');
      waterGrad.addColorStop(0.4, 'rgba(15, 8, 28, 0.96)');
      waterGrad.addColorStop(1, 'rgba(8, 4, 16, 0.98)');
      ctx.fillStyle = waterGrad;
      ctx.fillRect(0, waterY, width, height - waterY);

      // Water Horizon Mist Line
      ctx.strokeStyle = 'rgba(251, 191, 36, 0.35)';
      ctx.lineWidth = 1.2;
      ctx.beginPath();
      ctx.moveTo(0, waterY);
      ctx.lineTo(width, waterY);
      ctx.stroke();

      // 4. Moonlight Shimmer Path on Water
      const shimmerBars = 22;
      for (let s = 0; s < shimmerBars; s++) {
        const sy = waterY + (s / shimmerBars) * (height - waterY);
        const progress = s / shimmerBars;
        const sw = (moonR * 0.8 + progress * (moonR * 2.2)) * (0.8 + Math.sin(now * 0.003 + s * 0.6) * 0.2);
        const sx = moonX + Math.sin(now * 0.0015 + s * 0.4) * 8;

        ctx.fillStyle = 'rgba(254, 240, 138, ' + (0.35 * (1 - progress * 0.6)) + ')';
        ctx.beginPath();
        ctx.ellipse(sx, sy, sw, 1.4 + progress * 1.2, 0, 0, Math.PI * 2);
        ctx.fill();
      }

      ctx.restore();
    }

    // 2. Ornate Sri Lankan Vesak Lanterns (Vesak Kudu) Hanging from Bamboo Poles on Edges
    function drawVesakHangingLanterns(ctx, width, height, alpha, now) {
      ctx.save();
      ctx.globalAlpha = alpha;

      const lanternConfigs = [
        // Left Side: Grand Traditional Octagonal Vesak Kudu
        {
          x: width * 0.07,
          y: height * 0.28,
          size: 42,
          bambooRootX: 0,
          bambooRootY: height * 0.55,
          color1: '#fbbf24',
          color2: '#f43f5e',
          color3: '#38dbf5',
          phase: 0
        },
        // Left Side Secondary Lantern
        {
          x: width * 0.16,
          y: height * 0.38,
          size: 28,
          bambooRootX: 0,
          bambooRootY: height * 0.6,
          color1: '#f43f5e',
          color2: '#fde047',
          color3: '#a855f7',
          phase: 1.2
        },
        // Right Side: Grand Vesak Kudu
        {
          x: width * 0.93,
          y: height * 0.30,
          size: 38,
          bambooRootX: width,
          bambooRootY: height * 0.55,
          color1: '#fde047',
          color2: '#fb923c',
          color3: '#ec4899',
          phase: 2.4
        },
        // Right Side Secondary Lantern
        {
          x: width * 0.84,
          y: height * 0.42,
          size: 26,
          bambooRootX: width,
          bambooRootY: height * 0.62,
          color1: '#38dbf5',
          color2: '#fbbf24',
          color3: '#f43f5e',
          phase: 3.8
        }
      ];

      lanternConfigs.forEach(l => {
        const sway = Math.sin(now * 0.0018 + l.phase) * 6;
        const lx = l.x + sway;
        const ly = l.y;
        const s = l.size;

        // 1. Arched Bamboo Pole
        ctx.strokeStyle = '#78350f';
        ctx.lineWidth = 3.5;
        ctx.lineCap = 'round';
        ctx.beginPath();
        ctx.moveTo(l.bambooRootX, l.bambooRootY);
        ctx.quadraticCurveTo(l.bambooRootX === 0 ? lx * 0.7 : width - (width - lx) * 0.7, ly - 35, lx, ly - 15);
        ctx.stroke();

        // Bamboo node rings
        ctx.strokeStyle = '#451a03';
        ctx.lineWidth = 4.5;
        ctx.beginPath();
        ctx.moveTo(l.bambooRootX === 0 ? 15 : width - 15, l.bambooRootY - 20);
        ctx.lineTo(l.bambooRootX === 0 ? 15 : width - 15, l.bambooRootY - 17);
        ctx.stroke();

        // Hanging string
        ctx.strokeStyle = 'rgba(254, 240, 138, 0.7)';
        ctx.lineWidth = 1.0;
        ctx.beginPath();
        ctx.moveTo(lx, ly - 15);
        ctx.lineTo(lx, ly - s * 0.6);
        ctx.stroke();

        // 2. Warm Candle Flame Glow Inside Lantern
        const flamePulse = 0.85 + Math.sin(now * 0.006 + l.phase * 2) * 0.15;
        const glow = ctx.createRadialGradient(lx, ly, s * 0.1, lx, ly, s * 2.2);
        glow.addColorStop(0, 'rgba(254, 240, 138, 0.85)');
        glow.addColorStop(0.35, 'rgba(251, 191, 36, 0.45)');
        glow.addColorStop(0.7, 'rgba(244, 63, 94, 0.18)');
        glow.addColorStop(1, 'transparent');
        ctx.fillStyle = glow;
        ctx.beginPath();
        ctx.arc(lx, ly, s * 2.2, 0, Math.PI * 2);
        ctx.fill();

        // 3. Octagonal Sri Lankan Vesak Kudu Frame & Colorful Tissue Paper Faces
        ctx.save();
        ctx.translate(lx, ly);

        // Center Square / Diamond
        ctx.fillStyle = l.color1;
        ctx.globalAlpha = 0.88 * flamePulse;
        ctx.beginPath();
        ctx.moveTo(0, -s * 0.55);
        ctx.lineTo(s * 0.55, 0);
        ctx.lineTo(0, s * 0.55);
        ctx.lineTo(-s * 0.55, 0);
        ctx.closePath();
        ctx.fill();

        // 4 Triangular Pyramid Points on faces
        // Top Point
        ctx.fillStyle = l.color2;
        ctx.beginPath();
        ctx.moveTo(-s * 0.35, -s * 0.25);
        ctx.lineTo(0, -s * 0.75);
        ctx.lineTo(s * 0.35, -s * 0.25);
        ctx.closePath();
        ctx.fill();

        // Bottom Point
        ctx.fillStyle = l.color2;
        ctx.beginPath();
        ctx.moveTo(-s * 0.35, s * 0.25);
        ctx.lineTo(0, s * 0.75);
        ctx.lineTo(s * 0.35, s * 0.25);
        ctx.closePath();
        ctx.fill();

        // Left Point
        ctx.fillStyle = l.color3;
        ctx.beginPath();
        ctx.moveTo(-s * 0.25, -s * 0.35);
        ctx.lineTo(-s * 0.75, 0);
        ctx.lineTo(-s * 0.25, s * 0.35);
        ctx.closePath();
        ctx.fill();

        // Right Point
        ctx.fillStyle = l.color3;
        ctx.beginPath();
        ctx.moveTo(s * 0.25, -s * 0.35);
        ctx.lineTo(s * 0.75, 0);
        ctx.lineTo(s * 0.25, s * 0.35);
        ctx.closePath();
        ctx.fill();

        // White Framework lines
        ctx.strokeStyle = '#ffffff';
        ctx.lineWidth = 1.0;
        ctx.globalAlpha = 0.9;
        ctx.beginPath();
        ctx.moveTo(0, -s * 0.75); ctx.lineTo(0, s * 0.75);
        ctx.moveTo(-s * 0.75, 0); ctx.lineTo(s * 0.75, 0);
        ctx.moveTo(-s * 0.55, 0); ctx.lineTo(0, -s * 0.55);
        ctx.lineTo(s * 0.55, 0); ctx.lineTo(0, s * 0.55);
        ctx.closePath();
        ctx.stroke();

        // 4. Trailing Fluttering Paper Streamers / Tassels (Val Pata)
        const tasselCount = 4;
        const tasselLen = s * 1.6;
        const colors = [l.color1, l.color2, l.color3, '#ffffff'];

        for (let t = 0; t < tasselCount; t++) {
          const tx = ((t - (tasselCount - 1) * 0.5) / (tasselCount * 0.5)) * (s * 0.32);
          ctx.strokeStyle = colors[t % colors.length];
          ctx.lineWidth = 1.8;
          ctx.globalAlpha = 0.85;

          ctx.beginPath();
          ctx.moveTo(tx, s * 0.45);
          for (let seg = 1; seg <= 6; seg++) {
            const segY = s * 0.45 + seg * (tasselLen / 6);
            const waveX = tx + Math.sin(now * 0.0025 + l.phase + seg * 0.7 + t * 0.5) * (4 + seg * 2.2);
            ctx.lineTo(waveX, segY);
          }
          ctx.stroke();
        }

        ctx.restore();
      });

      ctx.restore();
    }

    // 3. Floating Lotus Bank (Foreground Blooming Lotus Flowers)
    function drawFloatingLotusBank(ctx, width, height, alpha, now) {
      ctx.save();
      ctx.globalAlpha = alpha;

      // Lotus Clusters on Left and Right Foreground Margins (keeping hero center clean)
      const flowers = [
        { x: width * 0.09, y: height - 60, scale: 32, phase: 0 },
        { x: width * 0.18, y: height - 42, scale: 26, phase: 1.1 },
        { x: width * 0.27, y: height - 25, scale: 22, phase: 2.3 },
        { x: width * 0.73, y: height - 30, scale: 24, phase: 3.2 },
        { x: width * 0.82, y: height - 52, scale: 30, phase: 4.1 },
        { x: width * 0.92, y: height - 70, scale: 36, phase: 5.0 }
      ];

      flowers.forEach(f => {
        drawVesakLotusFlower(ctx, f.x, f.y, f.scale, 0.95, now, f.phase);
      });

      ctx.restore();
    }

    // 4. Shoreline Rows of Glowing Clay Oil Lamps (Pahan / Diyas)
    function drawOilLampsShore(ctx, width, height, alpha, now) {
      ctx.save();
      ctx.globalAlpha = alpha;

      // Clay Lamps along water bank
      const leftLamps = [
        { x: width * 0.04, y: height - 18, s: 12, p: 0 },
        { x: width * 0.11, y: height - 15, s: 10, p: 1 },
        { x: width * 0.19, y: height - 12, s: 9, p: 2 },
        { x: width * 0.28, y: height - 10, s: 8, p: 3 },
        { x: width * 0.72, y: height - 10, s: 8, p: 4 },
        { x: width * 0.81, y: height - 12, s: 9, p: 5 },
        { x: width * 0.89, y: height - 15, s: 10, p: 6 },
        { x: width * 0.96, y: height - 18, s: 12, p: 7 }
      ];

      leftLamps.forEach(lp => {
        const s = lp.s;
        const lx = lp.x;
        const ly = lp.y;

        // Clay Bowl
        ctx.fillStyle = '#78350f';
        ctx.beginPath();
        ctx.ellipse(lx, ly, s * 0.8, s * 0.4, 0, 0, Math.PI * 2);
        ctx.fill();

        // Oil Pool
        ctx.fillStyle = '#d97706';
        ctx.beginPath();
        ctx.ellipse(lx, ly - 1, s * 0.6, s * 0.25, 0, 0, Math.PI * 2);
        ctx.fill();

        // Flickering Flame
        const fPulse = 0.85 + Math.sin(now * 0.015 + lp.p * 1.5) * 0.15;
        const fH = s * 0.9 * fPulse;

        // Warm Golden Glow
        const dGlow = ctx.createRadialGradient(lx, ly - fH * 0.5, 1, lx, ly - fH * 0.5, s * 2.2);
        dGlow.addColorStop(0, 'rgba(254, 240, 138, 0.9)');
        dGlow.addColorStop(0.4, 'rgba(251, 191, 36, 0.45)');
        dGlow.addColorStop(1, 'transparent');
        ctx.fillStyle = dGlow;
        ctx.beginPath();
        ctx.arc(lx, ly - fH * 0.5, s * 2.2, 0, Math.PI * 2);
        ctx.fill();

        // Flame Body
        ctx.fillStyle = '#f97316';
        ctx.beginPath();
        ctx.moveTo(lx - s * 0.25, ly - 2);
        ctx.quadraticCurveTo(lx - s * 0.35, ly - fH * 0.6, lx, ly - fH);
        ctx.quadraticCurveTo(lx + s * 0.35, ly - fH * 0.6, lx + s * 0.25, ly - 2);
        ctx.closePath();
        ctx.fill();

        // Inner Yellow Flame
        ctx.fillStyle = '#fef08a';
        ctx.beginPath();
        ctx.moveTo(lx - s * 0.12, ly - 2);
        ctx.quadraticCurveTo(lx - s * 0.18, ly - fH * 0.5, lx, ly - fH * 0.75);
        ctx.quadraticCurveTo(lx + s * 0.18, ly - fH * 0.5, lx + s * 0.12, ly - 2);
        ctx.closePath();
        ctx.fill();
      });

      ctx.restore();
    }

    // ── Dramatic Hogwarts Castle Silhouette & Highland Moon (Sep Horizon) ──
    function drawHogwartsCastleSilhouette(ctx, width, height, alpha, now) {
      ctx.save();
      ctx.globalAlpha = alpha;

      // 1. Radiant Highland Full Moon & Moonlight Halo
      const moonX = width * 0.70;
      const moonY = height * 0.22;
      const moonR = Math.min(Math.max(width * 0.034, 28), 44);

      // Moonlight Atmospheric Glow
      const moonHalo = ctx.createRadialGradient(moonX, moonY, moonR * 0.4, moonX, moonY, moonR * 4.0);
      moonHalo.addColorStop(0, 'rgba(254, 240, 138, 0.45)');
      moonHalo.addColorStop(0.35, 'rgba(245, 158, 11, 0.18)');
      moonHalo.addColorStop(0.7, 'rgba(129, 140, 248, 0.08)');
      moonHalo.addColorStop(1, 'transparent');
      ctx.fillStyle = moonHalo;
      ctx.beginPath();
      ctx.arc(moonX, moonY, moonR * 4.0, 0, Math.PI * 2);
      ctx.fill();

      // Full Moon Disk with subtle craters
      const moonGrad = ctx.createRadialGradient(moonX - moonR * 0.3, moonY - moonR * 0.3, 1, moonX, moonY, moonR);
      moonGrad.addColorStop(0, '#ffffff');
      moonGrad.addColorStop(0.65, '#fef08a');
      moonGrad.addColorStop(1, '#fde68a');
      ctx.fillStyle = moonGrad;
      ctx.beginPath();
      ctx.arc(moonX, moonY, moonR, 0, Math.PI * 2);
      ctx.fill();

      // Soft Moon Surface Mare Texture
      ctx.fillStyle = 'rgba(202, 138, 4, 0.16)';
      ctx.beginPath();
      ctx.arc(moonX - moonR * 0.25, moonY - moonR * 0.2, moonR * 0.35, 0, Math.PI * 2);
      ctx.arc(moonX + moonR * 0.3, moonY + moonR * 0.15, moonR * 0.28, 0, Math.PI * 2);
      ctx.arc(moonX - moonR * 0.1, moonY + moonR * 0.35, moonR * 0.25, 0, Math.PI * 2);
      ctx.fill();

      // 2. Distant Highland Mountain Ridge Layers
      const mtnBaseY = height * 0.78;

      // Far Mountain Ridge (Deep Twilight Slate/Purple)
      ctx.fillStyle = 'rgba(24, 12, 34, 0.75)';
      ctx.beginPath();
      ctx.moveTo(0, mtnBaseY);
      ctx.lineTo(0, height * 0.50);
      ctx.lineTo(width * 0.18, height * 0.44);
      ctx.lineTo(width * 0.35, height * 0.48);
      ctx.lineTo(width * 0.52, height * 0.40);
      ctx.lineTo(width * 0.70, height * 0.44);
      ctx.lineTo(width * 0.88, height * 0.38);
      ctx.lineTo(width, height * 0.46);
      ctx.lineTo(width, height);
      ctx.lineTo(0, height);
      ctx.closePath();
      ctx.fill();

      // Mid Mountain Ridge (Darker Indigo Silhouette)
      ctx.fillStyle = 'rgba(16, 8, 24, 0.88)';
      ctx.beginPath();
      ctx.moveTo(0, mtnBaseY);
      ctx.lineTo(0, height * 0.56);
      ctx.lineTo(width * 0.22, height * 0.50);
      ctx.lineTo(width * 0.42, height * 0.54);
      ctx.lineTo(width * 0.62, height * 0.46);
      ctx.lineTo(width * 0.82, height * 0.50);
      ctx.lineTo(width, height * 0.48);
      ctx.lineTo(width, height);
      ctx.lineTo(0, height);
      ctx.closePath();
      ctx.fill();

      // 3. Atmospheric Mountain Base Mist
      const mistGrad = ctx.createLinearGradient(0, height * 0.48, 0, height * 0.75);
      mistGrad.addColorStop(0, 'transparent');
      mistGrad.addColorStop(0.5, 'rgba(254, 240, 138, 0.08)');
      mistGrad.addColorStop(0.8, 'rgba(245, 158, 11, 0.05)');
      mistGrad.addColorStop(1, 'transparent');
      ctx.fillStyle = mistGrad;
      ctx.fillRect(0, height * 0.48, width, height * 0.27);

      // 4. Castle Scale & Positioning
      const cBaseX = width * 0.54;
      const cBaseY = height * 0.68;
      const cW = Math.min(Math.max(width * 0.44, 400), 580);
      const cH = Math.min(Math.max(height * 0.42, 280), 440);

      // 5. Rugged Highland Rocky Crags (Rising dramatically beneath the Castle)
      ctx.fillStyle = '#0f0717';
      ctx.beginPath();
      ctx.moveTo(cBaseX - cW * 0.35, cBaseY + cH * 0.38);
      ctx.lineTo(cBaseX - cW * 0.28, cBaseY + cH * 0.18);
      ctx.lineTo(cBaseX - cW * 0.16, cBaseY + cH * 0.12);
      ctx.lineTo(cBaseX - cW * 0.02, cBaseY + cH * 0.06);
      ctx.lineTo(cBaseX + cW * 0.18, cBaseY + cH * 0.02);
      ctx.lineTo(cBaseX + cW * 0.45, cBaseY + cH * 0.00);
      ctx.lineTo(cBaseX + cW * 0.72, cBaseY + cH * 0.04);
      ctx.lineTo(cBaseX + cW * 0.95, cBaseY + cH * 0.14);
      ctx.lineTo(cBaseX + cW * 1.15, cBaseY + cH * 0.38);
      ctx.closePath();
      ctx.fill();

      // Rocky Cliff Facet Shading & Highlights
      ctx.fillStyle = '#170c24';
      ctx.beginPath();
      ctx.moveTo(cBaseX - cW * 0.02, cBaseY + cH * 0.06);
      ctx.lineTo(cBaseX + cW * 0.08, cBaseY + cH * 0.22);
      ctx.lineTo(cBaseX + cW * 0.22, cBaseY + cH * 0.16);
      ctx.lineTo(cBaseX + cW * 0.18, cBaseY + cH * 0.02);
      ctx.closePath();
      ctx.fill();

      ctx.beginPath();
      ctx.moveTo(cBaseX + cW * 0.45, cBaseY + cH * 0.00);
      ctx.lineTo(cBaseX + cW * 0.52, cBaseY + cH * 0.20);
      ctx.lineTo(cBaseX + cW * 0.68, cBaseY + cH * 0.14);
      ctx.lineTo(cBaseX + cW * 0.72, cBaseY + cH * 0.04);
      ctx.closePath();
      ctx.fill();

      // Silhouetted Scottish Pines on the Cliff Ledges
      const pines = [
        { x: cBaseX - cW * 0.25, y: cBaseY + cH * 0.20, h: 26 },
        { x: cBaseX - cW * 0.15, y: cBaseY + cH * 0.14, h: 20 },
        { x: cBaseX - cW * 0.06, y: cBaseY + cH * 0.08, h: 24 },
        { x: cBaseX + cW * 0.88, y: cBaseY + cH * 0.14, h: 26 },
        { x: cBaseX + cW * 0.98, y: cBaseY + cH * 0.22, h: 30 }
      ];
      ctx.fillStyle = '#09040e';
      pines.forEach(pine => {
        ctx.beginPath();
        ctx.moveTo(pine.x, pine.y - pine.h);
        ctx.lineTo(pine.x + pine.h * 0.28, pine.y);
        ctx.lineTo(pine.x - pine.h * 0.28, pine.y);
        ctx.closePath();
        ctx.fill();
      });

      // 6. The Great Viaduct Bridge (Connecting cliffs over the chasm)
      const vX = cBaseX - cW * 0.32;
      const vY = cBaseY + cH * 0.06;
      const vW = cW * 0.34;
      const vH = cH * 0.18;
      ctx.fillStyle = '#11081a';
      ctx.fillRect(vX, vY, vW, 5); // Road deck
      for (let a = 0; a < 4; a++) {
        const ax = vX + a * (vW / 4) + 4;
        const aw = (vW / 4) - 6;
        ctx.fillRect(ax - 2.5, vY + 5, 3.5, vH);
        ctx.beginPath();
        ctx.arc(ax + aw * 0.5, vY + 8, aw * 0.45, Math.PI, 0);
        ctx.stroke();
      }
      // Glowing Bridge Lanterns
      for (let bl = 0; bl < 5; bl++) {
        const blx = vX + bl * (vW / 4);
        ctx.fillStyle = '#fbbf24';
        ctx.shadowColor = '#f59e0b';
        ctx.shadowBlur = 6;
        ctx.beginPath();
        ctx.arc(blx, vY - 2, 1.4, 0, Math.PI * 2);
        ctx.fill();
        ctx.shadowBlur = 0;
      }

      // 7. The Boathouse (Down by water edge)
      const bhX = cBaseX - cW * 0.12;
      const bhY = cBaseY + cH * 0.16;
      ctx.fillStyle = '#13081c';
      ctx.fillRect(bhX - 12, bhY, 24, 14);
      ctx.beginPath();
      ctx.moveTo(bhX - 14, bhY);
      ctx.lineTo(bhX, bhY - 10);
      ctx.lineTo(bhX + 14, bhY);
      ctx.closePath();
      ctx.fill();
      // Glowing boathouse entrance
      const bhGlow = ctx.createRadialGradient(bhX, bhY + 6, 1, bhX, bhY + 6, 14);
      bhGlow.addColorStop(0, 'rgba(254, 240, 138, 0.95)');
      bhGlow.addColorStop(0.5, 'rgba(245, 158, 11, 0.45)');
      bhGlow.addColorStop(1, 'transparent');
      ctx.fillStyle = bhGlow;
      ctx.beginPath();
      ctx.arc(bhX, bhY + 6, 14, 0, Math.PI * 2);
      ctx.fill();
      ctx.fillStyle = '#fef08a';
      ctx.fillRect(bhX - 2.5, bhY + 4, 5, 8);

      // 8. HOGWARTS CASTLE ARCHITECTURE

      // A. The Great Hall (Iconic high-pitched roof & radiant lancet windows)
      const ghX = cBaseX + cW * 0.08;
      const ghY = cBaseY - cH * 0.32;
      const ghW = cW * 0.40;
      const ghH = cH * 0.38;

      ctx.fillStyle = '#0d0614';
      ctx.fillRect(ghX, ghY, ghW, ghH);

      // Steep Pitched Gothic Roof with Decorated Ridge Cresting
      ctx.beginPath();
      ctx.moveTo(ghX - 6, ghY);
      ctx.lineTo(ghX + ghW * 0.5, ghY - cH * 0.35);
      ctx.lineTo(ghX + ghW + 6, ghY);
      ctx.closePath();
      ctx.fill();

      // Ridge Finials & Central Flèche Spire
      ctx.beginPath();
      ctx.moveTo(ghX + ghW * 0.5 - 4, ghY - cH * 0.33);
      ctx.lineTo(ghX + ghW * 0.5, ghY - cH * 0.62);
      ctx.lineTo(ghX + ghW * 0.5 + 4, ghY - cH * 0.33);
      ctx.closePath();
      ctx.fill();

      // Great Hall Ambient Candlelight Halo
      const ghGlow = ctx.createRadialGradient(ghX + ghW * 0.5, ghY + ghH * 0.42, 6, ghX + ghW * 0.5, ghY + ghH * 0.42, ghW * 0.85);
      ghGlow.addColorStop(0, 'rgba(254, 240, 138, 0.45)');
      ghGlow.addColorStop(0.4, 'rgba(245, 158, 11, 0.22)');
      ghGlow.addColorStop(0.8, 'rgba(239, 68, 68, 0.06)');
      ghGlow.addColorStop(1, 'transparent');
      ctx.fillStyle = ghGlow;
      ctx.beginPath();
      ctx.arc(ghX + ghW * 0.5, ghY + ghH * 0.42, ghW * 0.85, 0, Math.PI * 2);
      ctx.fill();

      // Row of 6 Glowing Gothic Lancet Windows with Warm Candlelight
      const winCount = 6;
      const winW = (ghW * 0.65) / winCount;
      const winH = ghH * 0.54;
      for (let w = 0; w < winCount; w++) {
        const wx = ghX + ghW * 0.16 + w * (winW + 5);
        const wy = ghY + ghH * 0.20;

        const wPulse = 0.86 + Math.sin(now * 0.0055 + w * 1.4) * 0.14;
        const winGrad = ctx.createLinearGradient(wx, wy, wx, wy + winH);
        winGrad.addColorStop(0, `rgba(255, 255, 255, ${0.98 * wPulse})`);
        winGrad.addColorStop(0.25, `rgba(254, 240, 138, ${0.95 * wPulse})`);
        winGrad.addColorStop(0.65, `rgba(245, 158, 11, ${0.90 * wPulse})`);
        winGrad.addColorStop(1, `rgba(180, 83, 9, ${0.80 * wPulse})`);

        ctx.fillStyle = winGrad;
        ctx.beginPath();
        ctx.arc(wx + winW * 0.5, wy + winW * 0.5, winW * 0.5, Math.PI, 0); // Gothic Arch Top
        ctx.lineTo(wx + winW, wy + winH);
        ctx.lineTo(wx, wy + winH);
        ctx.closePath();
        ctx.fill();

        // Gothic Mullion Tracery
        ctx.strokeStyle = '#0d0614';
        ctx.lineWidth = 0.9;
        ctx.beginPath();
        ctx.moveTo(wx + winW * 0.5, wy);
        ctx.lineTo(wx + winW * 0.5, wy + winH);
        ctx.moveTo(wx, wy + winH * 0.45);
        ctx.lineTo(wx + winW, wy + winH * 0.45);
        ctx.stroke();

        // Stone Buttress Pier between windows
        ctx.fillStyle = '#08030c';
        ctx.fillRect(wx - 3, wy - 4, 3, winH + 10);
      }

      // B. The Astronomy / Great Tower (Tallest Soaring Spire)
      const atX = cBaseX + cW * 0.54;
      const atBaseY = cBaseY + cH * 0.04;
      const atW = cW * 0.14;
      const atTopY = cBaseY - cH * 0.95;

      ctx.fillStyle = '#0a0410';
      // Cylindrical Tower Shaft
      ctx.fillRect(atX, atTopY + 28, atW, atBaseY - atTopY - 28);

      // Lower Turret Balcony
      ctx.fillRect(atX - 6, atTopY + 45, atW + 12, 8);

      // Upper Battlements / Observation Balcony
      ctx.fillRect(atX - 5, atTopY + 20, atW + 10, 10);
      for (let c = 0; c < 4; c++) {
        ctx.fillRect(atX - 5 + c * ((atW + 10) / 4), atTopY + 12, (atW + 10) / 6, 8);
      }

      // Conical Spire Top
      ctx.beginPath();
      ctx.moveTo(atX - 4, atTopY + 18);
      ctx.lineTo(atX + atW * 0.5, atTopY - 35);
      ctx.lineTo(atX + atW + 4, atTopY + 18);
      ctx.closePath();
      ctx.fill();

      // Glowing Arched Observatory Windows
      ctx.fillStyle = '#fef08a';
      ctx.shadowColor = '#f59e0b';
      ctx.shadowBlur = 8;
      for (let aw = 0; aw < 2; aw++) {
        const awx = atX + atW * 0.22 + aw * (atW * 0.45);
        ctx.beginPath();
        ctx.arc(awx, atTopY + 34, 2.8, Math.PI, 0);
        ctx.lineTo(awx + 2.8, atTopY + 42);
        ctx.lineTo(awx - 2.8, atTopY + 42);
        ctx.closePath();
        ctx.fill();
      }
      ctx.shadowBlur = 0;

      // Spire Starlight Glint / Magic Lumos Sparkle
      const tipX = atX + atW * 0.5;
      const tipY = atTopY - 35;
      const tipPulse = 0.85 + Math.sin(now * 0.004) * 0.15;
      const tipGlow = ctx.createRadialGradient(tipX, tipY, 0.5, tipX, tipY, 10);
      tipGlow.addColorStop(0, '#ffffff');
      tipGlow.addColorStop(0.4, 'rgba(254, 240, 138, 0.9)');
      tipGlow.addColorStop(0.8, 'rgba(245, 158, 11, 0.4)');
      tipGlow.addColorStop(1, 'transparent');
      ctx.fillStyle = tipGlow;
      ctx.beginPath();
      ctx.arc(tipX, tipY, 10 * tipPulse, 0, Math.PI * 2);
      ctx.fill();

      // C. Secondary Towers & Spire Cluster (Gryffindor, Ravenclaw & Bell Towers)
      const spires = [
        // Left Spire Cluster (Gryffindor / Defense Against Dark Arts Tower)
        { x: cBaseX - cW * 0.04, y: cBaseY - cH * 0.42, w: cW * 0.09, h: cH * 0.48, spireH: 42, winCount: 3 },
        { x: cBaseX + cW * 0.02, y: cBaseY - cH * 0.55, w: cW * 0.08, h: cH * 0.60, spireH: 50, winCount: 4 },
        // Middle Turrets behind Great Hall
        { x: cBaseX + cW * 0.42, y: cBaseY - cH * 0.48, w: cW * 0.07, h: cH * 0.52, spireH: 45, winCount: 3 },
        // Right Grand Spire Cluster (Ravenclaw / Bell Tower)
        { x: cBaseX + cW * 0.69, y: cBaseY - cH * 0.60, w: cW * 0.10, h: cH * 0.66, spireH: 56, winCount: 4 },
        { x: cBaseX + cW * 0.80, y: cBaseY - cH * 0.38, w: cW * 0.08, h: cH * 0.44, spireH: 38, winCount: 2 },
        { x: cBaseX + cW * 0.88, y: cBaseY - cH * 0.28, w: cW * 0.07, h: cH * 0.34, spireH: 30, winCount: 2 }
      ];

      spires.forEach(s => {
        ctx.fillStyle = '#0b0512';
        ctx.fillRect(s.x, s.y, s.w, s.h);

        // Tower Balcony Ledge
        ctx.fillRect(s.x - 2, s.y + 12, s.w + 4, 4);

        // Conical Spire Roof
        ctx.beginPath();
        ctx.moveTo(s.x - 3, s.y);
        ctx.lineTo(s.x + s.w * 0.5, s.y - s.spireH);
        ctx.lineTo(s.x + s.w + 3, s.y);
        ctx.closePath();
        ctx.fill();

        // Pinpoint Warm Amber Window Slits with Gentle Glow
        for (let sw = 0; sw < s.winCount; sw++) {
          const swy = s.y + 18 + sw * (s.h / (s.winCount + 1));
          const swx = s.x + s.w * 0.5 - 1.2;
          ctx.fillStyle = '#fef08a';
          ctx.shadowColor = '#fbbf24';
          ctx.shadowBlur = 4;
          ctx.fillRect(swx, swy, 2.4, 5);
          ctx.shadowBlur = 0;
        }
      });

      // D. Stone Curtain Walls, Quad Ramparts & Battlement Turrets
      ctx.fillStyle = '#0e0616';
      ctx.fillRect(cBaseX + cW * 0.04, cBaseY - cH * 0.15, cW * 0.06, cH * 0.22);
      ctx.fillRect(cBaseX + cW * 0.46, cBaseY - cH * 0.22, cW * 0.10, cH * 0.28);
      ctx.fillRect(cBaseX + cW * 0.77, cBaseY - cH * 0.18, cW * 0.06, cH * 0.24);

      // Connecting Wall Warm Light Punctures
      const wallLights = [
        { x: cBaseX + cW * 0.06, y: cBaseY - cH * 0.05 },
        { x: cBaseX + cW * 0.48, y: cBaseY - cH * 0.10 },
        { x: cBaseX + cW * 0.51, y: cBaseY - cH * 0.04 },
        { x: cBaseX + cW * 0.79, y: cBaseY - cH * 0.08 }
      ];
      ctx.fillStyle = '#fbbf24';
      wallLights.forEach(wl => {
        ctx.fillRect(wl.x, wl.y, 2.2, 4);
      });

      // 9. Silhouetted Owls / Bats circling the Highest Spire
      const owlFlock = [
        { rx: 28, ry: -25, a: now * 0.0018 },
        { rx: -38, ry: -15, a: now * 0.0015 + 1.8 },
        { rx: 18, ry: -45, a: now * 0.0022 + 3.5 }
      ];
      ctx.fillStyle = '#060209';
      owlFlock.forEach(of => {
        const ox = tipX + Math.cos(of.a) * of.rx;
        const oy = tipY + Math.sin(of.a) * (of.ry * 0.5) + of.ry;
        const flap = Math.sin(now * 0.015 + of.a);
        ctx.beginPath();
        ctx.ellipse(ox, oy, 1.8, 1.2, 0, 0, Math.PI * 2);
        ctx.moveTo(ox - 1.2, oy);
        ctx.lineTo(ox - 5, oy - flap * 3);
        ctx.moveTo(ox + 1.2, oy);
        ctx.lineTo(ox + 5, oy - flap * 3);
        ctx.fill();
        ctx.stroke();
      });

      ctx.restore();
    }

    // ── 60 FPS Render Loop ─────────────────────────────────────
    let animId;

    function render(now) {
      ctx.clearRect(0, 0, width, height);

      // 1. Ambient God-Rays
      if (godRays.length > 0) {
        godRays.forEach(ray => {
          ray.offset += ray.speed;
          const currentAlpha = ray.alpha * (0.7 + Math.sin(ray.offset) * 0.3);
          const rayGrad = ctx.createLinearGradient(ray.x, 0, ray.x + Math.sin(ray.angle) * height, height);
          rayGrad.addColorStop(0, currentTheme.colors.brand);
          rayGrad.addColorStop(1, 'transparent');
          ctx.save();
          ctx.fillStyle = rayGrad;
          ctx.globalAlpha = currentAlpha;
          ctx.beginPath();
          ctx.moveTo(ray.x - ray.width * 0.5, 0);
          ctx.lineTo(ray.x + ray.width * 0.5, 0);
          ctx.lineTo(ray.x + Math.sin(ray.angle) * height + ray.width * 1.5, height);
          ctx.lineTo(ray.x + Math.sin(ray.angle) * height - ray.width * 1.5, height);
          ctx.closePath();
          ctx.fill();
          ctx.restore();
        });
      }

      // 2. Render Horizon Scenery & Side Props
      sceneryProps.forEach(p => {
        if (p.type === 'christmas_lights') drawChristmasLights(ctx, width, now);
        else if (p.type === 'sakura_vista_horizon') drawSakuraVistaHorizon(ctx, width, height, 0.88);
        else if (p.type === 'tall_sakura_tree') drawTallSakuraTree(ctx, p.x, p.y, p.size, p.alpha);
        else if (p.type === 'overhanging_sakura') drawOverhangingSakuraBranch(ctx, width, height, 0.94);
        else if (p.type === 'hogwarts_castle_silhouette') drawHogwartsCastleSilhouette(ctx, width, height, p.alpha, now);
        else if (p.type === 'autumn_park_avenue') drawAutumnParkAvenue(ctx, width, height, 0.94, now);
        else if (p.type === 'autumn_tree') drawAutumnMapleTree(ctx, p.x, p.y, p.size, p.alpha, p.flip, p.isBg);
        else if (p.type === 'autumn_canopy_tunnel') drawAutumnCanopyTunnel(ctx, width, height, 0.95);
        else if (p.type === 'fallen_leaves_carpet') drawFallenLeavesCarpet(ctx, width, height, 0.92);
        else if (p.type === 'snowman') drawSnowman(ctx, p.x, p.y, p.size, p.alpha);
        else if (p.type === 'xmas_tree') drawXmasTree(ctx, p.x, p.y, p.size, p.alpha);
        else if (p.type === 'street_lamp') drawStreetLamp(ctx, p.x, p.y, p.size, p.alpha, now);
        else if (p.type === 'cottage') drawCozyCottage(ctx, p.x, p.y, p.size, p.alpha);
        else if (p.type === 'gingerbread') drawGingerbreadMan(ctx, p.x, p.y, p.size, p.alpha);
        else if (p.type === 'nebula_cosmic_sky') drawNebulaCosmicSky(ctx, width, height, p.alpha, now);
        else if (p.type === 'ringed_planet') drawRingedPlanet(ctx, p.x, p.y, p.size, p.alpha);
        else if (p.type === 'nebula_stargazer') drawNebulaStargazer(ctx, p.x, p.y, p.size, p.alpha, now);
        else if (p.type === 'emerald_vista_horizon') drawEmeraldVistaHorizon(ctx, width, height, p.alpha, now);
        else if (p.type === 'ivy_stone_arch') drawIvyStoneArch(ctx, p.x, p.y, p.size, p.alpha);
        else if (p.type === 'emerald_ferns_bank') drawEmeraldFernsBank(ctx, p.x, p.y, p.size, p.alpha, now);
        else if (p.type === 'synthwave_sun_and_grid') drawSynthwaveSunAndGrid(ctx, width, height, p.alpha, now);
        else if (p.type === 'cyberpunk_skyline') drawCyberpunkSkyline(ctx, width, height, p.alpha, now);
        else if (p.type === 'outrun_palm') drawOutrunPalm(ctx, p.x, p.y, p.size, p.alpha, p.flip);
        else if (p.type === 'ocean_caustics_surface') drawOceanCausticsSurface(ctx, width, height, p.alpha, now);
        else if (p.type === 'bioluminescent_reef') drawBioluminescentReef(ctx, width, height, p.alpha, now);
        else if (p.type === 'majestic_whale_diver') drawMajesticWhaleDiver(ctx, width, height, p.alpha, now);
        else if (p.type === 'milky_way_sky') drawMilkyWayNightSky(ctx, width, height, p.alpha, now);
        else if (p.type === 'perseid_pines') drawPerseidPines(ctx, p.x, p.y, p.size, p.alpha, p.flip);
        else if (p.type === 'stargazer_camp') drawStargazerCamp(ctx, p.x, p.y, p.size, p.alpha, now);
        else if (p.type === 'observatory_dome') drawObservatoryDome(ctx, p.x, p.y, p.size, p.alpha);
        else if (p.type === 'spooky_moon_horizon') drawSpookyMoonAndHorizon(ctx, width, height, p.alpha, now);

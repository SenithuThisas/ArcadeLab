---
// SeasonalBackground.astro - Tasteful Atmospheric Horizon Scenery & Theme Engine
import { getCurrentTheme, getCurrentMonthKey } from '../lib/seasonalThemes';

const activeTheme = getCurrentTheme();
const activeKey = getCurrentMonthKey();
---

<div
  id="seasonal-bg-container"
  class="fixed inset-0 pointer-events-none overflow-hidden -z-10"
  aria-hidden="true"
  data-active-theme={activeKey}
>
  <!-- Dynamic Ambient Glow Radial Underlays -->
  <div id="seasonal-glow-underlay" class="absolute inset-0 transition-opacity duration-1000 opacity-85">
    <div id="seasonal-glow-blob-1" class="absolute -top-32 left-1/4 w-[45rem] h-[30rem] rounded-full blur-3xl opacity-30 transition-all duration-700"></div>
    <div id="seasonal-glow-blob-2" class="absolute top-1/3 -right-24 w-[35rem] h-[35rem] rounded-full blur-3xl opacity-20 transition-all duration-700"></div>
    <div id="seasonal-glow-blob-3" class="absolute bottom-10 left-1/3 w-[40rem] h-[25rem] rounded-full blur-3xl opacity-25 transition-all duration-700"></div>
  </div>

  <!-- Atmospheric Background Canvas -->
  <canvas id="seasonalCanvas" class="absolute inset-0 w-full h-full block"></canvas>
</div>

<script is:inline>
  (function() {
    const THEMES = {
      jan: {
        id: 'jan', name: 'Neon Frost', badge: '❄️ Cyber Winter Edition',
        fontHeading: "'Orbitron', 'Space Grotesk', sans-serif",
        headlineGradient: 'linear-gradient(135deg, #ffffff 0%, #a5f3fc 35%, #38dbf5 70%, #c4b5fd 100%)',
        colors: { brand: '#38dbf5', accent: '#8b9dfa', glowStart: 'rgba(56, 219, 245, 0.25)', glowMid: 'rgba(139, 157, 250, 0.18)', glowEnd: 'rgba(100, 220, 255, 0.12)', surfaceTint: 'rgba(10, 20, 36, 0.70)', particlePalette: ['#ffffff', '#a5f3fc', '#38dbf5', '#c4b5fd', '#e0e7ff'] },
        visualTheme: 'frost'
      },
      feb: {
        id: 'feb', name: 'Nebula Love', badge: '💖 Cyber Valentine Edition',
        fontHeading: "'Outfit', 'Space Grotesk', sans-serif",
        headlineGradient: 'linear-gradient(135deg, #ffffff 0%, #ff94b8 35%, #ff5e8a 70%, #c084fc 100%)',
        colors: { brand: '#ff5e8a', accent: '#9d8df1', glowStart: 'rgba(255, 94, 138, 0.25)', glowMid: 'rgba(157, 141, 241, 0.18)', glowEnd: 'rgba(251, 113, 133, 0.12)', surfaceTint: 'rgba(28, 12, 28, 0.65)', particlePalette: ['#ff5e8a', '#ff94b8', '#9d8df1', '#f472b6', '#ffffff'] },
        visualTheme: 'hearts'
      },
      mar: {
        id: 'mar', name: 'Sakura Bloom', badge: '🌸 Hanami Spring Edition',
        fontHeading: "'Outfit', 'Space Grotesk', sans-serif",
        headlineGradient: 'linear-gradient(135deg, #ffffff 0%, #ffafb0 35%, #ff85a2 70%, #fed7aa 100%)',
        colors: { brand: '#ff85a2', accent: '#f7d070', glowStart: 'rgba(255, 133, 162, 0.25)', glowMid: 'rgba(247, 208, 112, 0.18)', glowEnd: 'rgba(255, 175, 176, 0.12)', surfaceTint: 'rgba(26, 16, 24, 0.65)', particlePalette: ['#ff85a2', '#ffafb0', '#fed7aa', '#fbcfe8', '#ffffff'] },
        visualTheme: 'sakura'
      },
      apr: {
        id: 'apr', name: 'Emerald Awakening', badge: '🌱 Earth & Sprout Edition',
        fontHeading: "'Outfit', 'Space Grotesk', sans-serif",
        headlineGradient: 'linear-gradient(135deg, #ffffff 0%, #6ee7b7 35%, #10b981 70%, #38dbf5 100%)',
        colors: { brand: '#10b981', accent: '#38dbf5', glowStart: 'rgba(16, 185, 129, 0.25)', glowMid: 'rgba(56, 219, 245, 0.18)', glowEnd: 'rgba(52, 211, 153, 0.12)', surfaceTint: 'rgba(10, 24, 20, 0.65)', particlePalette: ['#10b981', '#34d399', '#6ee7b7', '#38dbf5', '#a7f3d0'] },
        visualTheme: 'emerald'
      },
      may: {
        id: 'may', name: 'Vesak Festival', badge: '🪔 Vesak Festival of Lights Edition',
        fontHeading: "'Outfit', 'Space Grotesk', sans-serif",
        headlineGradient: 'linear-gradient(135deg, #ffffff 0%, #fde047 30%, #fb923c 65%, #f43f5e 100%)',
        colors: { brand: '#fbbf24', accent: '#f43f5e', glowStart: 'rgba(251, 191, 36, 0.26)', glowMid: 'rgba(244, 63, 94, 0.18)', glowEnd: 'rgba(253, 224, 71, 0.12)', surfaceTint: 'rgba(18, 12, 28, 0.70)', particlePalette: ['#fde047', '#fbbf24', '#f43f5e', '#fb7185', '#fed7aa', '#fef08a', '#ffffff'] },
        visualTheme: 'vesak'
      },
      jun: {
        id: 'jun', name: 'Retro Cyberwave', badge: '🌴 Summer Solstice Edition',
        fontHeading: "'Orbitron', 'Space Grotesk', sans-serif",
        headlineGradient: 'linear-gradient(135deg, #ffffff 0%, #f472b6 30%, #ec4899 65%, #06b6d4 100%)',
        colors: { brand: '#ec4899', accent: '#06b6d4', glowStart: 'rgba(236, 72, 153, 0.28)', glowMid: 'rgba(6, 182, 212, 0.20)', glowEnd: 'rgba(249, 115, 22, 0.14)', surfaceTint: 'rgba(28, 10, 26, 0.65)', particlePalette: ['#ec4899', '#f43f5e', '#06b6d4', '#a855f7', '#fbbf24'] },
        visualTheme: 'synthwave'
      },
      jul: {
        id: 'jul', name: 'Abyssal Ocean', badge: '🌊 Deep Aqua Edition',
        fontHeading: "'Space Grotesk', sans-serif",
        headlineGradient: 'linear-gradient(135deg, #ffffff 0%, #38bdf8 35%, #00f2fe 70%, #4facfe 100%)',
        colors: { brand: '#00f2fe', accent: '#4facfe', glowStart: 'rgba(0, 242, 254, 0.26)', glowMid: 'rgba(79, 172, 254, 0.18)', glowEnd: 'rgba(110, 231, 183, 0.12)', surfaceTint: 'rgba(8, 22, 34, 0.65)', particlePalette: ['#00f2fe', '#4facfe', '#6ee7b7', '#38bdf8', '#e0f2fe'] },
        visualTheme: 'abyss'
      },
      aug: {
        id: 'aug', name: 'Perseid Meteor', badge: '🌠 Meteor Shower Edition',
        fontHeading: "'Orbitron', 'Space Grotesk', sans-serif",
        headlineGradient: 'linear-gradient(135deg, #ffffff 0%, #fef08a 35%, #fcd34d 70%, #818cf8 100%)',
        colors: { brand: '#fcd34d', accent: '#6366f1', glowStart: 'rgba(252, 211, 77, 0.25)', glowMid: 'rgba(99, 102, 241, 0.20)', glowEnd: 'rgba(45, 212, 191, 0.12)', surfaceTint: 'rgba(16, 14, 36, 0.65)', particlePalette: ['#ffffff', '#fcd34d', '#818cf8', '#2dd4bf', '#fde047'] },
        visualTheme: 'meteor'
      },
      sep: {
        id: 'sep', name: 'Autumn Equinox', badge: '🍂 Hogwarts & Autumn Harvest Edition',
        fontHeading: "'Cinzel', 'Space Grotesk', serif",
        headlineGradient: 'linear-gradient(135deg, #ffffff 0%, #fde68a 30%, #f2b84b 60%, #ff8c42 85%, #ef4444 100%)',
        colors: { brand: '#f2b84b', accent: '#ff8c42', glowStart: 'rgba(242, 184, 75, 0.28)', glowMid: 'rgba(255, 140, 66, 0.20)', glowEnd: 'rgba(239, 68, 68, 0.12)', surfaceTint: 'rgba(28, 18, 12, 0.65)', particlePalette: ['#f2b84b', '#ff8c42', '#ef4444', '#d97706', '#fde68a'] },
        visualTheme: 'autumn'
      },
      oct: {
        id: 'oct', name: 'Spooky Haunt', badge: '🎃 Halloween Haunt Edition',
        fontHeading: "'Cinzel', 'Space Grotesk', serif",
        headlineGradient: 'linear-gradient(135deg, #ffffff 0%, #fb923c 30%, #f97316 60%, #c084fc 85%, #a855f7 100%)',
        colors: { brand: '#f97316', accent: '#a855f7', glowStart: 'rgba(249, 115, 22, 0.32)', glowMid: 'rgba(168, 85, 247, 0.24)', glowEnd: 'rgba(132, 204, 22, 0.16)', surfaceTint: 'rgba(24, 10, 34, 0.70)', particlePalette: ['#f97316', '#fb923c', '#c084fc', '#a855f7', '#a3e635'] },
        visualTheme: 'halloween'
      },
      nov: {
        id: 'nov', name: 'Cosmic Harvest', badge: '✨ Twilight Constellation Edition',
        fontHeading: "'Outfit', 'Space Grotesk', sans-serif",
        headlineGradient: 'linear-gradient(135deg, #ffffff 0%, #fef08a 35%, #eab308 70%, #d97706 100%)',
        colors: { brand: '#eab308', accent: '#d97706', glowStart: 'rgba(234, 179, 8, 0.25)', glowMid: 'rgba(217, 119, 6, 0.18)', glowEnd: 'rgba(180, 83, 9, 0.12)', surfaceTint: 'rgba(26, 20, 10, 0.65)', particlePalette: ['#eab308', '#facc15', '#fb923c', '#d97706', '#fef08a'] },
        visualTheme: 'harvest'
      },
      dec: {
        id: 'dec', name: 'Holiday Wonderland', badge: '🎄 Winter Holiday Edition',
        fontHeading: "'Cinzel', 'Space Grotesk', serif",
        headlineGradient: 'linear-gradient(135deg, #ffffff 0%, #fecdd3 30%, #f43f5e 60%, #fbbf24 85%, #10b981 100%)',
        colors: { brand: '#f43f5e', accent: '#10b981', glowStart: 'rgba(244, 63, 94, 0.28)', glowMid: 'rgba(16, 185, 129, 0.20)', glowEnd: 'rgba(251, 191, 36, 0.14)', surfaceTint: 'rgba(24, 14, 18, 0.65)', particlePalette: ['#ffffff', '#f43f5e', '#10b981', '#fbbf24', '#fecdd3'] },
        visualTheme: 'holiday'
      }
    };

    const container = document.getElementById('seasonal-bg-container');
    const serverKey = container ? container.getAttribute('data-active-theme') : null;
    const currentMonthIdx = new Date().getMonth();
    const liveMonthKey = ['jan', 'feb', 'mar', 'apr', 'may', 'jun', 'jul', 'aug', 'sep', 'oct', 'nov', 'dec'][currentMonthIdx];

    let currentThemeKey = (serverKey && THEMES[serverKey]) ? serverKey : (liveMonthKey || 'sep');
    let currentTheme = THEMES[currentThemeKey] || THEMES['sep'];

    // DOM Glow Elements
    const blob1 = document.getElementById('seasonal-glow-blob-1');
    const blob2 = document.getElementById('seasonal-glow-blob-2');
    const blob3 = document.getElementById('seasonal-glow-blob-3');

    function applyThemeTokens(theme) {
      if (blob1) blob1.style.background = `radial-gradient(circle, ${theme.colors.glowStart} 0%, transparent 70%)`;
      if (blob2) blob2.style.background = `radial-gradient(circle, ${theme.colors.glowMid} 0%, transparent 70%)`;
      if (blob3) blob3.style.background = `radial-gradient(circle, ${theme.colors.glowEnd} 0%, transparent 70%)`;

      document.documentElement.style.setProperty('--color-brand', theme.colors.brand);
      document.documentElement.style.setProperty('--color-accent', theme.colors.accent);
      document.documentElement.style.setProperty('--font-heading', theme.fontHeading);
      document.documentElement.style.setProperty('--headline-gradient', theme.headlineGradient);
      document.documentElement.style.setProperty('--surface-tint', theme.colors.surfaceTint);
      document.documentElement.setAttribute('data-season-theme', theme.id);

      document.querySelectorAll('.seasonal-badge-text').forEach(el => {
        el.textContent = theme.badge;
      });

      document.querySelectorAll('.theme-headline-gradient').forEach(el => {
        el.style.backgroundImage = theme.headlineGradient;
      });
    }

    applyThemeTokens(currentTheme);

    // Canvas State
    const canvas = document.getElementById('seasonalCanvas');
    if (!canvas) return;
    const ctx = canvas.getContext('2d');
    let width = 0, height = 0, dpr = 1;
    let particles = [];
    let sceneryProps = [];
    let godRays = [];
    let ambientEntities = [];
    const particleCount = 28;

    // Particle Factory with Tree-Branch origin for Sakura
    function createParticle(theme, isBurst = false, spawnX, spawnY) {
      const palette = theme.colors.particlePalette;
      const type = theme.visualTheme;

      let initX = spawnX !== undefined ? spawnX : Math.random() * width;
      let initY = spawnY !== undefined ? spawnY : (isBurst ? spawnY : Math.random() * height);

      // Sakura Petals originate from the tall cherry tree on the left side
      if (type === 'sakura' && spawnX === undefined && !isBurst) {
        if (Math.random() > 0.35) {
          initX = Math.random() * (width * 0.35);
          initY = height * 0.25 + Math.random() * (height * 0.45);
        }
      }

      // Autumn Maple Leaves originate from trees on both left and right sides
      if (type === 'autumn' && spawnX === undefined && !isBurst) {
        if (Math.random() > 0.3) {
          if (Math.random() > 0.5) {
            initX = Math.random() * (width * 0.35);
          } else {
            initX = width - Math.random() * (width * 0.35);
          }
          initY = height * 0.25 + Math.random() * (height * 0.45);
        }
      }

      const p = {
        x: initX,
        y: initY,
        color: palette[Math.floor(Math.random() * palette.length)],
        alpha: isBurst ? 0.9 : (0.22 + Math.random() * 0.45),
        size: 2.5 + Math.random() * 3.5,
        rot: Math.random() * Math.PI * 2,
        rotSpeed: (Math.random() - 0.5) * 0.03,
        tilt: Math.random() * Math.PI,
        tiltSpeed: 0.015 + Math.random() * 0.02,
        type: type,
        isBurst: isBurst,
        decay: isBurst ? (0.018 + Math.random() * 0.02) : 0,
        sway: Math.random() * Math.PI * 2,
        swaySpeed: 0.01 + Math.random() * 0.015
      };

      if (type === 'frost') {
        p.vx = (Math.random() - 0.5) * 0.45;
        p.vy = -0.35 - Math.random() * 0.55;
        p.size = 3.5 + Math.random() * 4.5;
        const rand = Math.random();
        p.particleShape = rand > 0.55 ? 'ice_crystal' : (rand > 0.3 ? 'spirit_spore' : 'frost_diamond');
      } else if (type === 'halloween') {
        p.vx = (Math.random() - 0.5) * 0.5;
        p.vy = -0.4 - Math.random() * 0.6;
        p.size = 3.5 + Math.random() * 4.5;
        const rand = Math.random();
        p.particleShape = rand > 0.6 ? 'pumpkin_ember' : (rand > 0.3 ? 'magic_orb' : 'ghost_spark');
      } else if (type === 'sakura') {
        p.vx = 0.45 + Math.random() * 0.75; // Drift from left tree to the right
        p.vy = 0.35 + Math.random() * 0.65;
        p.size = 5.5 + Math.random() * 4.5;
        const rand = Math.random();
        p.particleShape = rand > 0.65 ? 'sakura_flower' : 'sakura_petal';
      } else if (type === 'hogwarts' || type === 'sep') {
        p.vx = (Math.random() - 0.45) * 0.45;
        p.vy = -0.35 - Math.random() * 0.55; // Drifting upwards like lumos motes and wand sparks
        p.size = 3.5 + Math.random() * 4.5;
        const rand = Math.random();
        p.particleShape = rand > 0.65 ? 'wand_spark' : (rand > 0.35 ? 'lumos_orb' : 'snitch_glint');
      } else if (type === 'autumn') {
        p.vx = (Math.random() - 0.45) * 0.7; // Drifting with swirling autumn wind
        p.vy = 0.4 + Math.random() * 0.7;
        p.size = 6.5 + Math.random() * 3.5;
        p.rotSpeed = (Math.random() - 0.5) * 0.04;
        p.tiltSpeed = 0.02 + Math.random() * 0.03;
      } else if (type === 'hearts') {
        p.vx = (Math.random() - 0.5) * 0.35;
        p.vy = -0.35 - Math.random() * 0.55;
        p.size = 3.5 + Math.random() * 4.5;
        const rand = Math.random();
        p.particleShape = rand > 0.6 ? 'cross_star' : (rand > 0.3 ? 'heart' : 'stardust');
      } else if (type === 'abyss') {
        p.vx = (Math.random() - 0.45) * 0.35;
        p.vy = -0.4 - Math.random() * 0.65; // Air bubbles floating smoothly upwards to surface
        p.size = 3.5 + Math.random() * 5.0;
        const rand = Math.random();
        p.particleShape = rand > 0.35 ? 'bubble' : 'plankton';
      } else if (type === 'emerald') {
        p.vx = (Math.random() - 0.45) * 0.5;
        p.vy = -0.3 - Math.random() * 0.5; // Drifting upwards like forest pollen/spores
        p.size = 4.0 + Math.random() * 4.5;
        const rand = Math.random();
        p.particleShape = rand > 0.6 ? 'clover' : (rand > 0.3 ? 'sprout' : 'firefly');
      } else if (type === 'synthwave') {
        p.vx = (Math.random() - 0.5) * 0.5;
        p.vy = -0.35 - Math.random() * 0.65; // Upward floating retro neon sparks
        p.size = 3.5 + Math.random() * 4.5;
        const rand = Math.random();
        p.particleShape = rand > 0.6 ? 'retro_diamond' : (rand > 0.3 ? 'grid_square' : 'laser_spark');
      } else if (type === 'meteor') {
        p.vx = -0.7 - Math.random() * 0.9;
        p.vy = 0.8 + Math.random() * 1.2;
        p.size = 3.0 + Math.random() * 4.5;
        const rand = Math.random();
        p.particleShape = rand > 0.5 ? 'cross_star' : (rand > 0.25 ? 'stardust' : 'sparkle');
      } else if (type === 'vesak' || type === 'solar') {
        p.vx = (Math.random() - 0.45) * 0.45;
        p.vy = -0.35 - Math.random() * 0.55; // Drifting upwards like warm candlelight embers & lotus motes
        p.size = 3.5 + Math.random() * 4.5;
        const rand = Math.random();
        p.particleShape = rand > 0.6 ? 'flame_ember' : (rand > 0.3 ? 'lotus_petal' : 'blessing_orb');
      } else {
        p.vx = (Math.random() - 0.5) * 0.4;
        p.vy = 0.3 + Math.random() * 0.5;
      }

      if (isBurst) {
        const angle = Math.random() * Math.PI * 2;
        const speed = 2 + Math.random() * 4;
        p.vx = Math.cos(angle) * speed;
        p.vy = Math.sin(angle) * speed;
      }

      return p;
    }

    function initParticles() {
      particles = [];
      for (let i = 0; i < particleCount; i++) {
        particles.push(createParticle(currentTheme));
      }
    }

    // ── Build Horizon & Side Props ──
    function initHorizonProps() {
      sceneryProps = [];
      ambientEntities = [];
      const theme = currentTheme.visualTheme;

      if (theme === 'jan' || theme === 'frost') {
        // Jan: Bioluminescent Neon Spirit Forest with Ancient Glowing Tree, Overhanging Boughs & Spirit Moths
        sceneryProps.push({ type: 'neon_forest_vista', alpha: 0.92 });
        const spiritTreeHeight = Math.min(height * 0.78, 520);
        sceneryProps.push({ type: 'neon_spirit_tree', x: 0, y: height, size: spiritTreeHeight, alpha: 0.95 });
        sceneryProps.push({ type: 'neon_overhanging_canopy', alpha: 0.94 });

        for (let b = 0; b < 3; b++) {
          ambientEntities.push({
            type: 'neon_butterfly',
            x: Math.random() * width,
            y: height * 0.35 + Math.random() * (height * 0.45),
            vx: (Math.random() > 0.5 ? 1 : -1) * (0.35 + Math.random() * 0.35),
            vy: (Math.random() - 0.5) * 0.3,
            size: 10 + Math.random() * 4,
            wing: Math.random() * Math.PI * 2,
            wingSpeed: 0.12 + Math.random() * 0.06,
            color: Math.random() > 0.5 ? '#38dbf5' : '#c084fc',
            alpha: 0.85
          });
        }
      } else if (theme === 'dec' || theme === 'holiday') {
        // Dec: Magical Christmas Village with Tree, Snowman, Vintage Streetlamp, Cottage, Gingerbread Man & Santa's Sleigh
        sceneryProps.push({ type: 'xmas_tree', x: width * 0.08, y: height - 10, size: 68, alpha: 0.92 });
        sceneryProps.push({ type: 'snowman', x: width * 0.19, y: height - 12, size: 24, alpha: 0.88 });
        sceneryProps.push({ type: 'street_lamp', x: width * 0.28, y: height - 10, size: 75, alpha: 0.88 });
        sceneryProps.push({ type: 'cottage', x: width * 0.80, y: height - 12, size: 55, alpha: 0.85 });
        sceneryProps.push({ type: 'xmas_tree', x: width * 0.92, y: height - 10, size: 60, alpha: 0.88 });
        sceneryProps.push({ type: 'gingerbread', x: width * 0.70, y: height - 10, size: 22, alpha: 0.85 });
        sceneryProps.push({ type: 'christmas_lights' });

        ambientEntities.push({ type: 'santas_sleigh', x: -50, y: height * 0.20, vx: 0.75, size: 28, hover: 0 });
      } else if (theme === 'mar' || theme === 'sakura') {
        // Mar: Grand Anime Sakura Scene with Left Tree + Top-Right Overhanging Canopy + Vista Horizon
        const treeHeight = Math.min(height * 0.96, 680);
        sceneryProps.push({ type: 'sakura_vista_horizon' });
        sceneryProps.push({ type: 'tall_sakura_tree', x: 0, y: height, size: treeHeight, alpha: 0.95 });
        sceneryProps.push({ type: 'overhanging_sakura' });
      } else if (theme === 'oct' || theme === 'halloween') {
        // Oct: Spooky Gothic Haunt with Blood Harvest Moon, Haunted Castle, Cemetery Hill & Flying Witch
        sceneryProps.push({ type: 'spooky_moon_horizon', alpha: 0.94 });

        const leftHillSize = Math.min(Math.max(height * 0.28, 120), 180);
        const rightHillSize = Math.min(Math.max(height * 0.25, 110), 160);
        sceneryProps.push({ type: 'spooky_graveyard_hill', x: 0, y: height, size: leftHillSize, alpha: 0.95, flip: false });
        sceneryProps.push({ type: 'spooky_graveyard_hill', x: width, y: height, size: rightHillSize, alpha: 0.92, flip: true });

        ambientEntities.push({
          type: 'witch_flight',
          x: -60,
          y: height * 0.28,
          vx: 0.85,
          size: 26,
          hover: 0
        });

        ambientEntities.push({ type: 'spooky_ghost', x: width * 0.22, y: height * 0.52, vx: 0.35, size: 22, hover: 0, alpha: 0.85 });
        ambientEntities.push({ type: 'spooky_ghost', x: width * 0.78, y: height * 0.42, vx: -0.3, size: 19, hover: Math.PI, alpha: 0.80 });

        for (let b = 0; b < 4; b++) {
          ambientEntities.push({
            type: 'spooky_bat',
            x: Math.random() * width,
            y: height * 0.15 + Math.random() * (height * 0.35),
            vx: 1.1 + Math.random() * 0.8,
            vy: 0,
            size: 9 + Math.random() * 4,
            wing: Math.random() * Math.PI * 2,
            wingSpeed: 0.18 + Math.random() * 0.08,
            alpha: 0.75 + Math.random() * 0.2
          });
        }
      } else if (theme === 'jun' || theme === 'synthwave') {
        // Jun: Retro Cyberwave with Segmented Neon Sun, Perspective Wireframe Grid, Cyber Skyline & Outrun Palms
        sceneryProps.push({ type: 'synthwave_sun_and_grid', alpha: 0.92 });
        sceneryProps.push({ type: 'cyberpunk_skyline', alpha: 0.90 });
        const leftPalmHeight = Math.min(Math.max(height * 0.45, 200), 320);
        const rightPalmHeight = Math.min(Math.max(height * 0.38, 180), 280);
        sceneryProps.push({ type: 'outrun_palm', x: width * 0.06, y: height, size: leftPalmHeight, alpha: 0.95, flip: false });
        sceneryProps.push({ type: 'outrun_palm', x: width * 0.94, y: height, size: rightPalmHeight, alpha: 0.92, flip: true });

        ambientEntities.push({ type: 'cyber_spinner', x: -60, y: height * 0.32, vx: 1.1, size: 22 });
      } else if (theme === 'jul' || theme === 'abyss') {
        // Jul: Deep Abyssal Ocean with Surface Caustics, Seafloor Coral Reef, Bioluminescent Jellyfish & Majestic Whale
        sceneryProps.push({ type: 'ocean_caustics_surface', alpha: 0.90 });
        sceneryProps.push({ type: 'bioluminescent_reef', alpha: 0.92 });
        sceneryProps.push({ type: 'majestic_whale_diver', alpha: 0.94 });

        ambientEntities.push({ type: 'jellyfish_abyss', x: width * 0.18, y: height * 0.55, vy: -0.28, size: 24, pulse: 0, alpha: 0.85 });
        ambientEntities.push({ type: 'jellyfish_abyss', x: width * 0.82, y: height * 0.40, vy: -0.22, size: 20, pulse: 1.8, alpha: 0.80 });
        ambientEntities.push({ type: 'jellyfish_abyss', x: width * 0.52, y: height * 0.65, vy: -0.32, size: 16, pulse: 3.2, alpha: 0.75 });
      } else if (theme === 'sep' || theme === 'autumn' || theme === 'hogwarts') {
        // Sep: Autumn Maple Promenade + Hogwarts Castle Silhouette on Horizon
        const leftTreeHeight = Math.min(height * 0.96, 680);
        const rightTreeHeight = Math.min(height * 0.92, 640);

        // 1. Distant Hogwarts Castle Silhouette in the background between trees
        sceneryProps.push({ type: 'hogwarts_castle_silhouette', alpha: 0.92 });

        // 2. Perspective Promenade Walkway & Park Benches in Lower Ground Zone
        sceneryProps.push({ type: 'autumn_park_avenue' });

        // 3. Middle-Ground Trees on Far Margins
        sceneryProps.push({ type: 'autumn_tree', x: width * 0.08, y: height * 0.96, size: leftTreeHeight * 0.85, alpha: 0.90, flip: false, isBg: true });
        sceneryProps.push({ type: 'autumn_tree', x: width * 0.92, y: height * 0.96, size: rightTreeHeight * 0.85, alpha: 0.90, flip: true, isBg: true });

        // 4. Foreground Grand Maple Trees on Outer Edges
        sceneryProps.push({ type: 'autumn_tree', x: 0, y: height, size: leftTreeHeight, alpha: 0.98, flip: false, isBg: false });
        sceneryProps.push({ type: 'autumn_tree', x: width, y: height, size: rightTreeHeight, alpha: 0.98, flip: true, isBg: false });

        // 5. Overarching High Top-Edge Canopy Arch & Ground Fallen Leaves
        sceneryProps.push({ type: 'autumn_canopy_tunnel' });
        sceneryProps.push({ type: 'fallen_leaves_carpet' });
      } else if (theme === 'apr' || theme === 'emerald') {
        // Apr: Ghibli Emerald Spring with Lush Mountains, Reflective Lake, Overgrown Ivy Stone Arch & Forest Ferns
        const archSize = Math.min(Math.max(height * 0.55, 260), 440);
        sceneryProps.push({ type: 'emerald_vista_horizon', alpha: 0.92 });
        sceneryProps.push({ type: 'ivy_stone_arch', x: 0, y: height, size: archSize, alpha: 0.95 });
        sceneryProps.push({ type: 'emerald_ferns_bank', x: width, y: height, size: 75, alpha: 0.92 });
      } else if (theme === 'aug' || theme === 'meteor') {
        // Aug: Perseid Meteor Shower with Milky Way Vista, Stargazing Campsite, Observatory & Alpine Pines
        sceneryProps.push({ type: 'milky_way_sky', alpha: 0.92 });
        sceneryProps.push({ type: 'perseid_pines', x: 0, y: height, size: Math.min(height * 0.42, 220), alpha: 0.95, flip: false });
        sceneryProps.push({ type: 'perseid_pines', x: width, y: height, size: Math.min(height * 0.38, 200), alpha: 0.92, flip: true });

        const campSize = Math.min(Math.max(height * 0.15, 65), 95);
        sceneryProps.push({ type: 'stargazer_camp', x: width * 0.28, y: height, size: campSize, alpha: 0.95 });

        const obsSize = Math.min(Math.max(height * 0.16, 70), 100);
        sceneryProps.push({ type: 'observatory_dome', x: width * 0.78, y: height, size: obsSize, alpha: 0.92 });

        for (let m = 0; m < 4; m++) {
          ambientEntities.push({
            type: 'perseid_meteor',
            x: width * 0.3 + Math.random() * (width * 0.7),
            y: -20 - Math.random() * (height * 0.4),
            vx: -7.5 - Math.random() * 5.0,
            vy: 6.0 + Math.random() * 4.0,
            len: 80 + Math.random() * 90,
            thick: 1.8 + Math.random() * 1.2,
            color: ['#ffffff', '#fef08a', '#fcd34d', '#818cf8', '#2dd4bf'][Math.floor(Math.random() * 5)],
            delay: Math.random() * 120,
            alpha: 0
          });
        }
      } else if (theme === 'may' || theme === 'vesak' || theme === 'solar') {
        // May: Vesak Festival of Lights - Water Lake Vista, Hanging Vesak Lanterns, Floating Lotus Candles & Oil Lamps
        sceneryProps.push({ type: 'vesak_water_vista', alpha: 0.94 });
        sceneryProps.push({ type: 'vesak_hanging_lanterns', alpha: 0.96 });
        sceneryProps.push({ type: 'floating_lotus_bank', alpha: 0.95 });
        sceneryProps.push({ type: 'oil_lamps_shore', alpha: 0.92 });

        // Sky Lanterns floating upwards into the night sky
        for (let sl = 0; sl < 7; sl++) {
          ambientEntities.push({
            type: 'sky_lantern',
            x: width * 0.08 + Math.random() * (width * 0.84),
            y: height * 0.15 + Math.random() * (height * 0.75),
            vy: -0.35 - Math.random() * 0.45,
            vx: (Math.random() - 0.45) * 0.3,
            size: 14 + Math.random() * 12,
            sway: Math.random() * Math.PI * 2,
            swaySpeed: 0.015 + Math.random() * 0.02,
            flicker: Math.random() * Math.PI * 2,
            color: ['#fde047', '#fbbf24', '#f97316', '#fb7185', '#fed7aa'][Math.floor(Math.random() * 5)],
            alpha: 0.75 + Math.random() * 0.2
          });
        }

        // Floating Water Lotus Flowers gently drifting on the water
        const lotusPositions = [
          { x: width * 0.12, y: height - 42, size: 28 },
          { x: width * 0.24, y: height - 28, size: 22 },
          { x: width * 0.76, y: height - 35, size: 26 },
          { x: width * 0.88, y: height - 48, size: 30 }
        ];

        lotusPositions.forEach((lp, idx) => {
          ambientEntities.push({
            type: 'floating_water_lotus',
            x: lp.x,
            y: lp.y,
            baseY: lp.y,
            size: lp.size,
            bob: idx * 1.5,
            drift: (Math.random() - 0.5) * 0.1,
            alpha: 0.92
          });
        });
      } else if (theme === 'feb' || theme === 'hearts') {
        // Feb: Anime Cosmic Nebula Vista with Ringed Planet, Stargazer Silhouette & Swirling Stardust Stream
        sceneryProps.push({ type: 'nebula_cosmic_sky', alpha: 0.88 });
        const planetSize = Math.min(Math.max(width * 0.045, 36), 56);
        sceneryProps.push({ type: 'ringed_planet', x: width * 0.82, y: height * 0.22, size: planetSize, alpha: 0.92 });
        const stargazerSize = Math.min(Math.max(height * 0.12, 60), 85);
        sceneryProps.push({ type: 'nebula_stargazer', x: width * 0.14, y: height, size: stargazerSize, alpha: 0.94 });
      }
    }

    function initGodRays() {
      godRays = [];
      const theme = currentTheme.visualTheme;
      if (['autumn', 'hogwarts', 'solar', 'frost', 'abyss', 'emerald'].includes(theme)) {
        const isWarm = theme === 'autumn' || theme === 'hogwarts';
        for (let r = 0; r < (isWarm ? 4 : 3); r++) {
          godRays.push({
            x: (width * 0.15) + (r * (width * 0.25)),
            width: isWarm ? (100 + Math.random() * 120) : (80 + Math.random() * 100),
            angle: -Math.PI * 0.18,
            alpha: isWarm ? (0.05 + Math.random() * 0.04) : (0.03 + Math.random() * 0.03),
            speed: 0.0018,
            offset: Math.random() * Math.PI * 2
          });
        }
      }
    }

    function switchTheme(newKey) {
      if (!newKey || !THEMES[newKey]) return;
      currentThemeKey = newKey;
      currentTheme = THEMES[newKey];
      applyThemeTokens(currentTheme);
      initHorizonProps();
      initGodRays();
      initParticles();
    }

    function resize() {
      dpr = Math.min(window.devicePixelRatio || 1, 2);
      width = window.innerWidth;
      height = window.innerHeight;
      canvas.width = Math.round(width * dpr);
      canvas.height = Math.round(height * dpr);
      ctx.scale(dpr, dpr);

      initHorizonProps();
      initGodRays();
      initParticles();
    }

    resize();
    window.addEventListener('resize', resize);

    // Global Theme Switch Listener
    window.addEventListener('arcadelab-theme-change', (e) => {
      const key = e.detail && e.detail.themeKey;
      if (key) switchTheme(key);
    });

    // Mouse Tracking
    const mouse = { x: -9999, y: -9999, isOver: false, vx: 0, vy: 0, lastX: 0, lastY: 0 };
    window.addEventListener('mousemove', (e) => {
      mouse.vx = (e.clientX - mouse.lastX) * 0.2;
      mouse.vy = (e.clientY - mouse.lastY) * 0.2;
      mouse.lastX = e.clientX;
      mouse.lastY = e.clientY;
      mouse.x = e.clientX;
      mouse.y = e.clientY;
      mouse.isOver = true;
    });
    window.addEventListener('mouseleave', () => {
      mouse.isOver = false;
      mouse.x = -9999;
      mouse.y = -9999;
    });

    // Click Burst
    window.addEventListener('click', (e) => {
      const target = e.target;
      if (target.closest('button, a, input, select, canvas#gameCanvas')) return;
      for (let i = 0; i < 10; i++) {
        particles.push(createParticle(currentTheme, true, e.clientX, e.clientY));
      }
    });

    // ── Dedicated Silhouette Prop Drawers ───────────────────────

    // 1. Christmas Fairy Lights Garland (Dec)
    function drawChristmasLights(ctx, width, now) {
      ctx.save();
      const wireSegments = Math.ceil(width / 65);
      const colors = ['#f43f5e', '#10b981', '#fbbf24', '#38dbf5', '#ec4899'];

      // Draped Garland Wire
      ctx.strokeStyle = 'rgba(255, 255, 255, 0.22)';
      ctx.lineWidth = 1.0;
      ctx.beginPath();
      ctx.moveTo(0, 0);
      for (let i = 0; i < wireSegments; i++) {
        const x1 = i * 65;
        const x2 = (i + 1) * 65;
        const midX = (x1 + x2) / 2;
        ctx.quadraticCurveTo(midX, 20, x2, 4);
      }
      ctx.stroke();

      // Glowing Twinkling Bulbs
      for (let i = 0; i < wireSegments; i++) {
        const x = (i + 0.5) * 65;
        const y = 17;
        const color = colors[i % colors.length];
        const pulse = 0.7 + Math.sin(now * 0.0035 + i * 1.3) * 0.3;

        // Glow Halo
        const glow = ctx.createRadialGradient(x, y, 1, x, y, 12);
        glow.addColorStop(0, color);
        glow.addColorStop(1, 'transparent');
        ctx.fillStyle = glow;
        ctx.globalAlpha = 0.55 * pulse;
        ctx.beginPath();
        ctx.arc(x, y, 12, 0, Math.PI * 2);
        ctx.fill();

        // Bulb Glass
        ctx.fillStyle = color;
        ctx.globalAlpha = 0.85 * pulse;
        ctx.beginPath();
        ctx.ellipse(x, y, 3.2, 4.8, 0, 0, Math.PI * 2);
        ctx.fill();

        // White Filament Spark
        ctx.fillStyle = '#ffffff';
        ctx.globalAlpha = 0.95 * pulse;
        ctx.beginPath();
        ctx.arc(x, y - 1, 1.2, 0, Math.PI * 2);
        ctx.fill();
      }
      ctx.restore();
    }

    // ── Botanical Sakura Blossom Drawing Helpers ──
    function drawSakuraPetalShape(ctx, length, width, baseColor, tipColor) {
      const grad = ctx.createLinearGradient(0, 0, 0, -length);
      grad.addColorStop(0, baseColor || '#f472b6');
      grad.addColorStop(0.55, tipColor || '#fce7f3');
      grad.addColorStop(1, '#ffffff');
      ctx.fillStyle = grad;

      ctx.beginPath();
      ctx.moveTo(0, 0);
      // Left organic petal curve
      ctx.bezierCurveTo(-width * 0.7, -length * 0.35, -width * 0.95, -length * 0.75, -width * 0.4, -length);
      // Characteristic Sakura notch / cleft at petal tip
      ctx.quadraticCurveTo(0, -length * 0.88, width * 0.4, -length);
      // Right petal curve
      ctx.bezierCurveTo(width * 0.95, -length * 0.75, width * 0.7, -length * 0.35, 0, 0);
      ctx.closePath();
      ctx.fill();
    }

    function drawOpenSakuraFlower(ctx, x, y, scale, angle, alpha, tint) {
      ctx.save();
      ctx.translate(x, y);
      ctx.rotate(angle || 0);
      ctx.scale(scale || 1, scale || 1);
      ctx.globalAlpha = alpha !== undefined ? alpha : 0.98;

      const baseCol = tint === 'deep' ? '#fb7185' : (tint === 'white' ? '#fbcfe8' : '#f472b6');
      const tipCol = tint === 'deep' ? '#fbcfe8' : (tint === 'white' ? '#ffffff' : '#fce7f3');

      // 5 Realistic Overlapping Petals
      const petalLen = 9;
      const petalWid = 6.2;
      for (let p = 0; p < 5; p++) {
        ctx.save();
        ctx.rotate((p * Math.PI * 2) / 5);
        drawSakuraPetalShape(ctx, petalLen, petalWid, baseCol, tipCol);
        ctx.restore();
      }

      // Crimson Center Pistil Base
      ctx.fillStyle = '#be123c';
      ctx.beginPath();
      ctx.arc(0, 0, 1.8, 0, Math.PI * 2);
      ctx.fill();

      // Delicate Stamens radiating from flower heart
      ctx.strokeStyle = '#fda4af';
      ctx.lineWidth = 0.6;
      ctx.fillStyle = '#fbbf24';
      for (let s = 0; s < 8; s++) {
        const sa = (s * Math.PI * 2) / 8 + 0.2;
        const sx = Math.cos(sa) * 3.8;
        const sy = Math.sin(sa) * 3.8;
        ctx.beginPath();
        ctx.moveTo(0, 0);
        ctx.lineTo(sx, sy);
        ctx.stroke();

        // Tiny yellow anther pollen dot
        ctx.beginPath();
        ctx.arc(sx, sy, 0.75, 0, Math.PI * 2);
        ctx.fill();
      }

      ctx.restore();
    }

    // Helper to draw dense cluster bouquets of blossoms
    function drawSakuraBlossomBunch(ctx, cx, cy, scale, count, spread) {
      const cnt = count || 4;
      const sp = spread || 8;
      for (let i = 0; i < cnt; i++) {
        const angle = (i * Math.PI * 2) / cnt + (i * 0.4);
        const dist = ((i % 2 === 0) ? sp * 0.5 : sp) * scale;
        const bx = cx + Math.cos(angle) * dist;
        const by = cy + Math.sin(angle) * dist;
        const bScale = scale * (0.85 + (i % 3) * 0.15);
        const bRot = angle + (i * 0.5);
        const tint = (i % 3 === 0) ? 'deep' : (i % 3 === 1 ? 'light' : 'white');
        drawOpenSakuraFlower(ctx, bx, by, bScale, bRot, 0.98, tint);
      }
    }

    function drawSakuraBud(ctx, x, y, scale, angle, alpha) {
      ctx.save();
      ctx.translate(x, y);
      ctx.rotate(angle || 0);
      ctx.scale(scale || 1, scale || 1);
      ctx.globalAlpha = alpha !== undefined ? alpha : 0.95;

      // Dark Calyx
      ctx.fillStyle = '#3f1a28';
      ctx.beginPath();
      ctx.moveTo(-2, 0);
      ctx.lineTo(2, 0);
      ctx.lineTo(0, 4);
      ctx.closePath();
      ctx.fill();

      // Emerging Petals
      ctx.fillStyle = '#f43f5e';
      ctx.beginPath();
      ctx.ellipse(-1.5, -3, 2.5, 5, -0.2, 0, Math.PI * 2);
      ctx.fill();

      ctx.fillStyle = '#fbcfe8';
      ctx.beginPath();
      ctx.ellipse(1.5, -4, 2.8, 5.5, 0.2, 0, Math.PI * 2);
      ctx.fill();

      ctx.restore();
    }

    // ── Anime Sakura Scenic Vista & Cottage Horizon (Mar) ──
    function drawSakuraVistaHorizon(ctx, width, height, alpha) {
      ctx.save();
      ctx.globalAlpha = alpha;

      // 1. Distant Anime Misty Hills (Lower ground zone)
      const mtnGrad = ctx.createLinearGradient(0, height - 95, 0, height);
      mtnGrad.addColorStop(0, 'rgba(56, 30, 68, 0.35)');
      mtnGrad.addColorStop(0.7, 'rgba(40, 18, 50, 0.60)');
      mtnGrad.addColorStop(1, 'rgba(25, 10, 32, 0.80)');
      ctx.fillStyle = mtnGrad;

      ctx.beginPath();
      ctx.moveTo(0, height);
      ctx.lineTo(0, height - 45);
      ctx.quadraticCurveTo(width * 0.25, height - 75, width * 0.50, height - 50);
      ctx.quadraticCurveTo(width * 0.75, height - 80, width, height - 48);
      ctx.lineTo(width, height);
      ctx.closePath();
      ctx.fill();

      // Billowing Anime Cumulus Clouds in the low horizon
      const cloudGrad = ctx.createLinearGradient(0, height - 110, 0, height - 40);
      cloudGrad.addColorStop(0, 'rgba(255, 255, 255, 0.25)');
      cloudGrad.addColorStop(1, 'rgba(244, 206, 230, 0.08)');
      ctx.fillStyle = cloudGrad;

      const clouds = [
        { cx: width * 0.26, cy: height - 75, r: 28 },
        { cx: width * 0.31, cy: height - 85, r: 35 },
        { cx: width * 0.37, cy: height - 78, r: 30 },
        { cx: width * 0.68, cy: height - 80, r: 28 },
        { cx: width * 0.74, cy: height - 92, r: 38 },
        { cx: width * 0.80, cy: height - 82, r: 32 }
      ];
      clouds.forEach(c => {
        ctx.beginPath();
        ctx.arc(c.cx, c.cy, c.r, 0, Math.PI * 2);
        ctx.fill();
      });

      // 2. Charming Japanese Wooden Cottage & Striped Awning (Lower backdrop)
      const houseX = width * 0.36;
      const houseY = height - 58;
      const houseW = Math.min(width * 0.28, 180);
      const houseH = 58;

      if (width > 640) {
        // Cottage Wooden Gable Roof
        ctx.fillStyle = '#5c2c16';
        ctx.beginPath();
        ctx.moveTo(houseX - 8, houseY + 20);
        ctx.lineTo(houseX + houseW * 0.5, houseY);
        ctx.lineTo(houseX + houseW + 8, houseY + 20);
        ctx.lineTo(houseX + houseW + 4, houseY + 25);
        ctx.lineTo(houseX + houseW * 0.5, houseY + 6);
        ctx.lineTo(houseX - 4, houseY + 25);
        ctx.closePath();
        ctx.fill();

        // Wooden Plank Facade
        ctx.fillStyle = '#78350f';
        ctx.fillRect(houseX, houseY + 20, houseW, houseH - 20);

        // Green & White Striped Awning
        const awnY = houseY + 30;
        const awnH = 15;
        const numStripes = 8;
        const stripeW = houseW / numStripes;
        for (let s = 0; s < numStripes; s++) {
          ctx.fillStyle = (s % 2 === 0) ? '#059669' : '#f8fafc';
          ctx.beginPath();
          ctx.moveTo(houseX + s * stripeW, awnY);
          ctx.lineTo(houseX + (s + 1) * stripeW, awnY);
          ctx.lineTo(houseX + (s + 1) * stripeW, awnY + awnH);
          ctx.quadraticCurveTo(houseX + (s + 0.5) * stripeW, awnY + awnH + 3, houseX + s * stripeW, awnY + awnH);
          ctx.closePath();
          ctx.fill();
        }

        // Climbing Ivy Leaves on Roof Edge
        ctx.fillStyle = '#15803d';
        for (let iv = 0; iv < 10; iv++) {
          const ix = houseX + iv * (houseW / 9);
          const iy = houseY + 18 + (iv % 2) * 4;
          ctx.beginPath();
          ctx.arc(ix, iy, 3.2, 0, Math.PI * 2);
          ctx.fill();
        }
      }

      // Soft Dawn Glow
      const sunX = width * 0.85;
      const sunY = height - 42;
      const sunGlow = ctx.createRadialGradient(sunX, sunY, 2, sunX, sunY, 45);
      sunGlow.addColorStop(0, 'rgba(254, 240, 138, 0.55)');
      sunGlow.addColorStop(0.35, 'rgba(251, 146, 60, 0.20)');
      sunGlow.addColorStop(1, 'transparent');
      ctx.fillStyle = sunGlow;
      ctx.beginPath();
      ctx.arc(sunX, sunY, 45, 0, Math.PI * 2);
      ctx.fill();

      // Garden Slope Base
      const hillGrad = ctx.createLinearGradient(0, height - 28, 0, height);
      hillGrad.addColorStop(0, '#1a3322');
      hillGrad.addColorStop(1, '#0e1f14');
      ctx.fillStyle = hillGrad;
      ctx.beginPath();
      ctx.moveTo(0, height);
      ctx.quadraticCurveTo(width * 0.2, height - 28, width * 0.45, height - 12);
      ctx.lineTo(width, height - 8);
      ctx.lineTo(width, height);
      ctx.closePath();
      ctx.fill();

      ctx.restore();
    }

    // 1. Lush Overhanging Sakura Canopy & Branches (Framed tightly in Top-Right Corner)
    function drawOverhangingSakuraBranch(ctx, width, height, alpha) {
      ctx.save();
      ctx.globalAlpha = alpha;

      // Keep branch confined to top-right corner to never obstruct central hero text
      const bSize = Math.min(width * 0.35, 340);

      // Layer 1: Gnarled Dark Wood Branch Skeleton
      ctx.strokeStyle = '#21101b';
      ctx.lineCap = 'round';
      ctx.lineJoin = 'round';

      // Main Top-Right Heavy Bough (Framing top-right edge)
      ctx.lineWidth = 8.5;
      ctx.beginPath();
      ctx.moveTo(width + 15, -10);
      ctx.bezierCurveTo(width - bSize * 0.30, bSize * 0.12, width - bSize * 0.55, bSize * 0.18, width - bSize * 0.82, bSize * 0.28);
      ctx.stroke();

      // Branch Bark Highlight
      ctx.strokeStyle = '#4a2036';
      ctx.lineWidth = 1.8;
      ctx.beginPath();
      ctx.moveTo(width + 15, -8);
      ctx.bezierCurveTo(width - bSize * 0.30, bSize * 0.13, width - bSize * 0.55, bSize * 0.19, width - bSize * 0.82, bSize * 0.29);
      ctx.stroke();

      // Upper Sub-Bough
      ctx.strokeStyle = '#261220';
      ctx.lineWidth = 5.0;
      ctx.beginPath();
      ctx.moveTo(width - bSize * 0.25, bSize * 0.10);
      ctx.bezierCurveTo(width - bSize * 0.40, bSize * 0.06, width - bSize * 0.58, bSize * 0.07, width - bSize * 0.72, bSize * 0.12);
      ctx.stroke();

      // Mid Drooping Bough
      ctx.lineWidth = 4.5;
      ctx.beginPath();
      ctx.moveTo(width - bSize * 0.45, bSize * 0.16);
      ctx.bezierCurveTo(width - bSize * 0.55, bSize * 0.24, width - bSize * 0.68, bSize * 0.30, width - bSize * 0.80, bSize * 0.36);
      ctx.stroke();

      // Fine Weeping Stems
      ctx.strokeStyle = '#381a2e';
      ctx.lineWidth = 1.8;
      ctx.beginPath();
      ctx.moveTo(width - bSize * 0.58, bSize * 0.07); ctx.lineTo(width - bSize * 0.66, bSize * 0.04);
      ctx.moveTo(width - bSize * 0.72, bSize * 0.12); ctx.lineTo(width - bSize * 0.80, bSize * 0.14);
      ctx.moveTo(width - bSize * 0.80, bSize * 0.36); ctx.lineTo(width - bSize * 0.88, bSize * 0.38);
      ctx.moveTo(width - bSize * 0.82, bSize * 0.28); ctx.lineTo(width - bSize * 0.94, bSize * 0.32);
      ctx.stroke();

      // Layer 3: Packed Bouquets of Sakura Blossoms Along the Top-Right Bough
      const bouquets = [
        { x: width - bSize * 0.10, y: bSize * 0.06, s: 1.25, c: 5 },
        { x: width - bSize * 0.22, y: bSize * 0.10, s: 1.30, c: 5 },
        { x: width - bSize * 0.34, y: bSize * 0.14, s: 1.35, c: 6 },

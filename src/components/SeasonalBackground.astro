      ctx.moveTo(w * 0.58, -h * 0.68); ctx.quadraticCurveTo(w * 0.65, -h * 0.65, w * 0.72, -h * 0.62);
      ctx.moveTo(w * 0.52, -h * 0.30); ctx.lineTo(w * 0.60, -h * 0.26);
      ctx.moveTo(w * 0.65, -h * 0.38); ctx.lineTo(w * 0.72, -h * 0.36);

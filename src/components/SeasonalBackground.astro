      ctx.globalAlpha = alpha;

      const h = Math.min(size, 660);
      const w = h * 0.46; // Strictly keep on left margin to never cross into center text

      // Layer 1: Gnarled Organic Trunk & Branching Anatomy
      ctx.fillStyle = '#21101b';
      ctx.beginPath();
      ctx.moveTo(-15, 0);
      ctx.quadraticCurveTo(w * 0.08, -h * 0.2, w * 0.06, -h * 0.45);
      ctx.lineTo(w * 0.14, -h * 0.45);
      ctx.quadraticCurveTo(w * 0.16, -h * 0.2, 18, 0);
      ctx.closePath();
      ctx.fill();

      // Trunk Texture Highlights
      ctx.strokeStyle = '#4a2036';
      ctx.lineWidth = 1.8;
      ctx.beginPath();
      ctx.moveTo(-4, -h * 0.05);
      ctx.quadraticCurveTo(w * 0.08, -h * 0.22, w * 0.07, -h * 0.42);
      ctx.stroke();

      ctx.lineCap = 'round';

          ctx.fillStyle = '#ffffff';
          ctx.beginPath();
          ctx.arc(0, -gR * 0.2, gR, Math.PI, 0);
          ctx.lineTo(gR, gR * 1.1);

          const folds = 4;
          for (let f = folds; f >= 0; f--) {
            const fx = ((f / folds) * 2 - 1) * gR;

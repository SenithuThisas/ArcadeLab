          gAura.addColorStop(0.5, 'rgba(192, 132, 252, 0.45)');
          gAura.addColorStop(1, 'transparent');
          ctx.fillStyle = gAura;
          ctx.beginPath();
          ctx.arc(0, 0, gR * 1.5, 0, Math.PI * 2);

    // ── Botanical Autumn Maple Tree & Leaf Helpers (Sep/Autumn) ──
    function drawMapleLeafShape(ctx, size, color, veinColor) {
      ctx.save();
      // Stem
      ctx.strokeStyle = veinColor || '#78350f';
      ctx.lineWidth = 1.0;
      ctx.beginPath();
      ctx.moveTo(0, 0);
      ctx.quadraticCurveTo(size * 0.05, size * 0.15, 0, size * 0.25);
      ctx.stroke();

      // Maple Leaf Blade Polygon with 5 lobes
      ctx.fillStyle = color;
      ctx.beginPath();
      ctx.moveTo(0, 0);

      // Left Basal Lobe
      ctx.lineTo(-size * 0.3, -size * 0.08);
      ctx.lineTo(-size * 0.55, -size * 0.18);
      ctx.lineTo(-size * 0.42, -size * 0.32);

      // Left Main Lobe
      ctx.lineTo(-size * 0.72, -size * 0.45);
      ctx.lineTo(-size * 0.78, -size * 0.65);
      ctx.lineTo(-size * 0.58, -size * 0.62);
      ctx.lineTo(-size * 0.62, -size * 0.78);
      ctx.lineTo(-size * 0.44, -size * 0.68);
      ctx.lineTo(-size * 0.28, -size * 0.55);

      // Center Main Lobe
      ctx.lineTo(-size * 0.25, -size * 0.75);
      ctx.lineTo(-size * 0.18, -size * 0.70);
      ctx.lineTo(0, -size * 1.0); // Top tip
      ctx.lineTo(size * 0.18, -size * 0.70);
      ctx.lineTo(size * 0.25, -size * 0.75);

      // Right Main Lobe
      ctx.lineTo(size * 0.28, -size * 0.55);
      ctx.lineTo(size * 0.44, -size * 0.68);
      ctx.lineTo(size * 0.62, -size * 0.78);
      ctx.lineTo(size * 0.58, -size * 0.62);
      ctx.lineTo(size * 0.78, -size * 0.65);
      ctx.lineTo(size * 0.72, -size * 0.45);

      // Right Basal Lobe
      ctx.lineTo(size * 0.42, -size * 0.32);
      ctx.lineTo(size * 0.55, -size * 0.18);
      ctx.lineTo(size * 0.3, -size * 0.08);
      ctx.closePath();
      ctx.fill();

      // Leaf Veins
      ctx.strokeStyle = veinColor || 'rgba(120, 53, 15, 0.45)';
      ctx.lineWidth = 0.7;
      ctx.beginPath();
      ctx.moveTo(0, 0); ctx.lineTo(0, -size * 0.85);
      ctx.moveTo(0, 0); ctx.lineTo(-size * 0.6, -size * 0.55);
      ctx.moveTo(0, 0); ctx.lineTo(size * 0.6, -size * 0.55);
      ctx.moveTo(0, 0); ctx.lineTo(-size * 0.38, -size * 0.18);
      ctx.moveTo(0, 0); ctx.lineTo(size * 0.38, -size * 0.18);
      ctx.stroke();

      ctx.restore();
    }

    // Classic Wooden Slat Park Bench (From Visual Reference)
    function drawParkBench(ctx, x, y, size, alpha, angle) {
      ctx.save();
      ctx.translate(x, y);
      if (angle) ctx.rotate(angle);
      ctx.globalAlpha = alpha || 0.95;

      const w = size;
      const h = size * 0.65;

      // Cast shadow on ground
      ctx.fillStyle = 'rgba(20, 10, 5, 0.45)';
      ctx.beginPath();
      ctx.ellipse(0, 2, w * 0.55, h * 0.15, 0, 0, Math.PI * 2);
      ctx.fill();

      // Dark Cast-Iron / Bronze Legs & Framework
      ctx.strokeStyle = '#29180d';
      ctx.lineWidth = Math.max(w * 0.045, 1.8);
      ctx.lineCap = 'round';
      ctx.lineJoin = 'round';

      // Left Leg
      ctx.beginPath();
      ctx.moveTo(-w * 0.42, 0);
      ctx.quadraticCurveTo(-w * 0.44, -h * 0.40, -w * 0.38, -h * 0.52);
      ctx.stroke();

      // Right Leg
      ctx.beginPath();
      ctx.moveTo(w * 0.42, 0);
      ctx.quadraticCurveTo(w * 0.44, -h * 0.40, w * 0.38, -h * 0.52);
      ctx.stroke();

      // Armrests
      ctx.lineWidth = Math.max(w * 0.035, 1.4);
      ctx.beginPath();
      ctx.moveTo(-w * 0.44, -h * 0.48);
      ctx.quadraticCurveTo(-w * 0.45, -h * 0.68, -w * 0.38, -h * 0.72);
      ctx.moveTo(w * 0.44, -h * 0.48);
      ctx.quadraticCurveTo(w * 0.45, -h * 0.68, w * 0.38, -h * 0.72);
      ctx.stroke();

      // Horizontal Slat Supports
      ctx.lineWidth = Math.max(w * 0.03, 1.2);
      ctx.beginPath();
      ctx.moveTo(-w * 0.40, -h * 0.48); ctx.lineTo(w * 0.40, -h * 0.48);
      ctx.stroke();

      // Warm Amber / Cedar Wood Slats
      const slatColors = ['#a16207', '#b45309', '#d97706', '#92400e', '#78350f'];

      // Seat Slats (3 horizontal slats)
      for (let s = 0; s < 3; s++) {
        const sy = -h * 0.46 + s * (h * 0.08);
        const sCol = slatColors[s % slatColors.length];
        ctx.fillStyle = sCol;
        ctx.beginPath();
        ctx.roundRect(-w * 0.46, sy, w * 0.92, h * 0.065, [2]);
        ctx.fill();

        // Slat woodgrain highlight
        ctx.strokeStyle = '#fef08a';
        ctx.lineWidth = 0.6;
        ctx.globalAlpha = (alpha || 0.95) * 0.4;
        ctx.beginPath();
        ctx.moveTo(-w * 0.44, sy + 1);
        ctx.lineTo(w * 0.44, sy + 1);
        ctx.stroke();
        ctx.globalAlpha = alpha || 0.95;
      }

      // Backrest Slats (3 horizontal slats)
      for (let b = 0; b < 3; b++) {
        const by = -h * 0.88 + b * (h * 0.12);
        const bCol = slatColors[(b + 1) % slatColors.length];
        ctx.fillStyle = bCol;
        ctx.beginPath();
        ctx.roundRect(-w * 0.46, by, w * 0.92, h * 0.09, [2]);
        ctx.fill();

        // Slat top highlight
        ctx.strokeStyle = '#fef08a';
        ctx.lineWidth = 0.7;
        ctx.globalAlpha = (alpha || 0.95) * 0.45;
        ctx.beginPath();
        ctx.moveTo(-w * 0.44, by + 1);
        ctx.lineTo(w * 0.44, by + 1);
        ctx.stroke();
        ctx.globalAlpha = alpha || 0.95;
      }

      ctx.restore();
    }

    // Autumn Park Promenade Avenue & Komorebi Walkway
    function drawAutumnParkAvenue(ctx, width, height, alpha, now) {
      ctx.save();
      ctx.globalAlpha = alpha;

      // 1. Distant Warm Forest Backdrop
      const bgGrad = ctx.createLinearGradient(0, height - 160, 0, height);
      bgGrad.addColorStop(0, 'rgba(64, 40, 16, 0.45)');
      bgGrad.addColorStop(0.5, 'rgba(45, 30, 12, 0.70)');
      bgGrad.addColorStop(1, 'rgba(28, 18, 8, 0.90)');
      ctx.fillStyle = bgGrad;

      ctx.beginPath();
      ctx.moveTo(0, height);
      ctx.lineTo(0, height - 100);
      ctx.quadraticCurveTo(width * 0.25, height - 140, width * 0.50, height - 120);
      ctx.quadraticCurveTo(width * 0.75, height - 150, width, height - 95);
      ctx.lineTo(width, height);
      ctx.closePath();
      ctx.fill();

      // Distant green/amber shrubbery layer at path horizon
      const shrubY = height - 75;
      const shrubGrad = ctx.createLinearGradient(0, shrubY - 40, 0, shrubY + 10);
      shrubGrad.addColorStop(0, '#1e3a1e');
      shrubGrad.addColorStop(0.6, '#142814');
      shrubGrad.addColorStop(1, '#0c1a0c');
      ctx.fillStyle = shrubGrad;

      for (let s = 0; s < 14; s++) {
        const sx = width * 0.26 + s * (width * 0.038);
        const sy = shrubY + Math.sin(s * 1.2) * 8;
        ctx.beginPath();
        ctx.arc(sx, sy, 18 + (s % 3) * 5, 0, Math.PI * 2);
        ctx.fill();
      }

      // 2. Perspective Autumn Walkway / Promenade
      const pathTopY = height - 68;
      const pathBotY = height;
      const pathTopW = Math.min(width * 0.16, 120);
      const pathBotW = Math.min(width * 0.44, 420);
      const centerX = width * 0.5;

      // Base Grass Lawns
      const grassGrad = ctx.createLinearGradient(0, pathTopY - 15, 0, height);
      grassGrad.addColorStop(0, '#1e3d1a');
      grassGrad.addColorStop(0.6, '#152b12');
      grassGrad.addColorStop(1, '#0e1d0c');
      ctx.fillStyle = grassGrad;

      // Left Grass
      ctx.beginPath();
      ctx.moveTo(0, pathTopY);
      ctx.lineTo(centerX - pathTopW * 0.5, pathTopY);
      ctx.lineTo(centerX - pathBotW * 0.5, pathBotY);
      ctx.lineTo(0, height);
      ctx.closePath();
      ctx.fill();

      // Right Grass
      ctx.beginPath();
      ctx.moveTo(width, pathTopY);
      ctx.lineTo(centerX + pathTopW * 0.5, pathTopY);
      ctx.lineTo(centerX + pathBotW * 0.5, pathBotY);
      ctx.lineTo(width, height);
      ctx.closePath();
      ctx.fill();

      // Walkway Paving in Lower Ground Zone
      const pathGrad = ctx.createLinearGradient(0, pathTopY, 0, pathBotY);
      pathGrad.addColorStop(0, '#78350f');
      pathGrad.addColorStop(0.35, '#9a3412');
      pathGrad.addColorStop(0.70, '#b45309');
      pathGrad.addColorStop(1, '#78350f');
      ctx.fillStyle = pathGrad;

      ctx.beginPath();
      ctx.moveTo(centerX - pathTopW * 0.5, pathTopY);
      ctx.lineTo(centerX + pathTopW * 0.5, pathTopY);
      ctx.lineTo(centerX + pathBotW * 0.5, pathBotY);
      ctx.lineTo(centerX - pathBotW * 0.5, pathBotY);
      ctx.closePath();
      ctx.fill();

      // 3. Wooden Park Benches along the Promenade (in lower ground area)
      // Distant Center Bench (At the clearing)
      drawParkBench(ctx, centerX, pathTopY - 2, 28, 0.88, 0);

      // Left Park Bench
      if (width > 500) {
        const leftBenchX = centerX - pathBotW * 0.38;
        const leftBenchY = pathBotY - 32;
        drawParkBench(ctx, leftBenchX, leftBenchY, 46, 0.95, -0.08);
      }

      // Right Park Bench
      if (width > 500) {
        const rightBenchX = centerX + pathBotW * 0.38;
        const rightBenchY = pathBotY - 32;
        drawParkBench(ctx, rightBenchX, rightBenchY, 46, 0.95, 0.08);
      }

      ctx.restore();
    }

    // Grand Autumn Maple Tree (Framed Strictly on Outer Side Margins)
    function drawAutumnMapleTree(ctx, x, y, size, alpha, flip, isBg) {
      ctx.save();
      ctx.translate(x, y);
      if (flip) {
        ctx.scale(-1, 1);
      }
      ctx.globalAlpha = alpha;

      const h = Math.min(size, 680);
      const w = h * 0.36; // Kept strictly on side margin to never cross into center text

      // Main Majestic Tree Trunk
      ctx.fillStyle = isBg ? '#180e0a' : '#23140e';
      ctx.beginPath();
      ctx.moveTo(-16, 0);
      ctx.quadraticCurveTo(w * 0.06, -h * 0.25, w * 0.05, -h * 0.50);
      ctx.quadraticCurveTo(w * 0.04, -h * 0.75, w * 0.08, -h * 1.02);
      ctx.lineTo(w * 0.16, -h * 1.02);
      ctx.quadraticCurveTo(w * 0.14, -h * 0.75, w * 0.15, -h * 0.50);
      ctx.quadraticCurveTo(w * 0.16, -h * 0.25, 20, 0);
      ctx.closePath();
      ctx.fill();

      // Trunk Texture Highlights
      if (!isBg) {
        ctx.strokeStyle = '#4a2818';
        ctx.lineWidth = 1.8;
        ctx.beginPath();
        ctx.moveTo(-4, -h * 0.05);
        ctx.quadraticCurveTo(w * 0.08, -h * 0.25, w * 0.07, -h * 0.48);
        ctx.stroke();
      }

      ctx.lineCap = 'round';
      ctx.lineJoin = 'round';

      // 1. Lower Main Bough
      ctx.strokeStyle = isBg ? '#180e0a' : '#23140e';
      ctx.lineWidth = isBg ? 6.5 : 8.5;
      ctx.beginPath();
      ctx.moveTo(w * 0.10, -h * 0.38);
      ctx.bezierCurveTo(w * 0.22, -h * 0.40, w * 0.36, -h * 0.44, w * 0.52, -h * 0.44);
      ctx.stroke();

      // Lower Sub-branches
      ctx.lineWidth = isBg ? 4.0 : 5.0;
      ctx.beginPath();
      ctx.moveTo(w * 0.26, -h * 0.41);
      ctx.quadraticCurveTo(w * 0.38, -h * 0.34, w * 0.54, -h * 0.36);
      ctx.moveTo(w * 0.48, -h * 0.44);
      ctx.quadraticCurveTo(w * 0.60, -h * 0.46, w * 0.72, -h * 0.42);

---
// SeasonalAudio.astro - Soft Procedural Web Audio Ambient Chime & Melody Engine for Seasonal Themes
---

<!-- Ambient Theme Music Floating Control -->
<div
  id="seasonal-audio-widget"
  class="fixed bottom-5 right-5 z-40 flex items-center gap-2"
>
  <button
    id="audio-toggle-btn"
    type="button"
    class="group flex items-center gap-2 px-3.5 py-2 rounded-full bg-[var(--color-surface)]/90 hover:bg-[var(--color-surface-2)] text-[var(--color-text)] border border-[var(--color-border)] hover:border-[var(--color-brand)] shadow-lg backdrop-blur-md transition-all duration-300 hover:scale-105 active:scale-95 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-[var(--color-brand)] cursor-pointer select-none"
    aria-label="Toggle ambient seasonal music"
    title="Toggle Theme Ambient Melody"
  >
    <!-- Audio Icon / Animated Equalizer Bars -->
    <div class="relative w-4 h-4 flex items-center justify-center">
      <!-- Equalizer Bars (When Playing) -->
      <div id="audio-eq-bars" class="hidden items-end justify-center gap-0.5 w-4 h-3.5">
        <span class="w-0.5 bg-[var(--color-brand)] rounded-full h-full animate-[eqBounce1_0.8s_ease-in-out_infinite]"></span>
        <span class="w-0.5 bg-[var(--color-brand)] rounded-full h-2/3 animate-[eqBounce2_0.6s_ease-in-out_infinite]"></span>
        <span class="w-0.5 bg-[var(--color-brand)] rounded-full h-4/5 animate-[eqBounce3_0.9s_ease-in-out_infinite]"></span>
        <span class="w-0.5 bg-[var(--color-brand)] rounded-full h-1/2 animate-[eqBounce1_0.7s_ease-in-out_infinite]"></span>
      </div>

      <!-- Mute Icon (When Off) -->
      <svg
        id="audio-mute-icon"
        class="w-4 h-4 text-[var(--color-muted)] group-hover:text-[var(--color-brand)] transition-colors"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="2"
        stroke-linecap="round"
        stroke-linejoin="round"
      >
        <polygon points="11 5 6 9 2 9 2 15 6 15 11 19 11 5"></polygon>
        <line x1="23" y1="9" x2="17" y2="15"></line>
        <line x1="17" y1="9" x2="23" y2="15"></line>
      </svg>
    </div>

    <span id="audio-status-label" class="text-xs font-mono font-medium text-[var(--color-muted)] group-hover:text-[var(--color-text)] transition-colors">
      Music Off
    </span>
  </button>
</div>

<style>
  @keyframes eqBounce1 {
    0%, 100% { height: 25%; }
    50% { height: 100%; }
  }
  @keyframes eqBounce2 {
    0%, 100% { height: 75%; }
    50% { height: 30%; }
  }
  @keyframes eqBounce3 {
    0%, 100% { height: 40%; }
    50% { height: 90%; }
  }
</style>


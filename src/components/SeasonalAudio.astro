      const serverKey = container ? container.getAttribute('data-active-theme') : null;
      if (serverKey && THEME_MAP[serverKey]) return serverKey;

      const docTheme = document.documentElement.getAttribute('data-season-theme');
      if (docTheme && THEME_MAP[docTheme]) return docTheme;

      const monthIdx = new Date().getMonth();
      const monthKey = ['jan', 'feb', 'mar', 'apr', 'may', 'jun', 'jul', 'aug', 'sep', 'oct', 'nov', 'dec'][monthIdx];
      return monthKey || 'sep';
    }

    const THEME_MAP = {
      jan: 'frost',
      feb: 'hearts',
      mar: 'sakura',
      apr: 'emerald',
      may: 'vesak',
      jun: 'synthwave',
      jul: 'abyss',
      aug: 'meteor',
      sep: 'hogwarts',
      autumn: 'hogwarts',
      hogwarts: 'hogwarts',
      oct: 'halloween',
      nov: 'harvest',
      dec: 'holiday'
    };

    function initAudio() {
      if (audioCtx) return;
      const AudioContextClass = window.AudioContext || window.webkitAudioContext;
      if (!AudioContextClass) return;

      audioCtx = new AudioContextClass();

      // Dynamics Compressor: gently tames sudden volume spikes and ensures velvety smooth dynamics
      compressor = audioCtx.createDynamicsCompressor();
      compressor.threshold.setValueAtTime(-24, audioCtx.currentTime);
      compressor.knee.setValueAtTime(25, audioCtx.currentTime);
      compressor.ratio.setValueAtTime(8, audioCtx.currentTime);
      compressor.attack.setValueAtTime(0.005, audioCtx.currentTime);
      compressor.release.setValueAtTime(0.20, audioCtx.currentTime);

      // Master Limiter / Gain Node (Pleasant, soft ambient level)
      masterGain = audioCtx.createGain();
      masterGain.gain.setValueAtTime(0.11, audioCtx.currentTime);

      compressor.connect(masterGain);
      masterGain.connect(audioCtx.destination);
    }

    // Play a single procedural instrument note (soft & warm)
    function playNote(freq, type, duration = 1.2, volume = 0.105) {
      if (!audioCtx || !masterGain || freq <= 0) return;
      const targetNode = compressor || masterGain;
      const now = audioCtx.currentTime;

      // Equal-loudness contour compensation: soften higher frequencies (>600Hz) so they never feel piercing
      let freqScale = 1.0;
      if (freq > 600) {
        freqScale = Math.max(0.60, 1.0 - ((freq - 600) / 1600) * 0.40);
      }
      const noteVol = volume * freqScale;

      // Primary Tone Oscillator
      const osc = audioCtx.createOscillator();
      const oscGain = audioCtx.createGain();

      // Harmonic Overtone Oscillator
      const overtone = audioCtx.createOscillator();
      const overtoneGain = audioCtx.createGain();

      // Low-pass Filter for warmth
      const filter = audioCtx.createBiquadFilter();
      filter.type = 'lowpass';

      if (type === 'jingle_celesta') {
        // Soft ringing Christmas / Hogwarts music box celesta
        osc.type = 'sine';
        overtone.type = 'sine';
        overtone.frequency.setValueAtTime(freq * 2.0, now);
        filter.frequency.setValueAtTime(Math.min(freq * 2.6, 4500), now);

        oscGain.gain.setValueAtTime(0.0001, now);
        oscGain.gain.linearRampToValueAtTime(noteVol * 0.85, now + 0.02);
        oscGain.gain.exponentialRampToValueAtTime(0.0001, now + duration);

        overtoneGain.gain.setValueAtTime(0.0001, now);
        overtoneGain.gain.linearRampToValueAtTime(noteVol * 0.20, now + 0.015);
        overtoneGain.gain.exponentialRampToValueAtTime(0.0001, now + duration * 0.5);
      } else if (type === 'koto') {
        // Japanese Koto string pluck: Warm gentle wooden body
        osc.type = 'sawtooth';
        overtone.type = 'sine';
        overtone.frequency.setValueAtTime(freq * 2.0, now);
        filter.frequency.setValueAtTime(freq * 2.0, now);

        oscGain.gain.setValueAtTime(0.0001, now);
        oscGain.gain.linearRampToValueAtTime(noteVol * 0.75, now + 0.01);
        oscGain.gain.exponentialRampToValueAtTime(0.0001, now + duration * 0.65);

        overtoneGain.gain.setValueAtTime(0.0001, now);
        overtoneGain.gain.linearRampToValueAtTime(noteVol * 0.18, now + 0.01);
        overtoneGain.gain.exponentialRampToValueAtTime(0.0001, now + duration * 0.35);
      } else if (type === 'synthwave_saw') {
        // Soft 80s Cyberwave saw synthesizer lead with mellow filter
        osc.type = 'sawtooth';
        overtone.type = 'triangle';
        overtone.frequency.setValueAtTime(freq * 1.004, now);
        filter.frequency.setValueAtTime(Math.min(freq * 2.2, 3200), now);

        oscGain.gain.setValueAtTime(0.0001, now);
        oscGain.gain.linearRampToValueAtTime(noteVol * 0.70, now + 0.02);
        oscGain.gain.exponentialRampToValueAtTime(0.0001, now + duration * 0.55);

        overtoneGain.gain.setValueAtTime(0.0001, now);
        overtoneGain.gain.linearRampToValueAtTime(noteVol * 0.18, now + 0.02);
        overtoneGain.gain.exponentialRampToValueAtTime(0.0001, now + duration * 0.55);
      } else if (type === 'kalimba') {
        // Warm resonant lo-fi kalimba tine
        osc.type = 'triangle';
        overtone.type = 'sine';
        overtone.frequency.setValueAtTime(freq * 3.0, now);
        filter.frequency.setValueAtTime(freq * 2.0, now);

        oscGain.gain.setValueAtTime(0.0001, now);
        oscGain.gain.linearRampToValueAtTime(noteVol * 0.75, now + 0.015);
        oscGain.gain.exponentialRampToValueAtTime(0.0001, now + duration * 0.70);

        overtoneGain.gain.setValueAtTime(0.0001, now);
        overtoneGain.gain.linearRampToValueAtTime(noteVol * 0.18, now + 0.015);
        overtoneGain.gain.exponentialRampToValueAtTime(0.0001, now + duration * 0.30);
      } else if (type === 'spooky_celesta') {
        // Eerie Gothic Music Box / Celesta for "This Is Halloween"
        osc.type = 'triangle';
        overtone.type = 'sine';
        overtone.frequency.setValueAtTime(freq * 2.0, now);
        filter.frequency.setValueAtTime(Math.min(freq * 2.6, 3800), now);
        filter.Q.setValueAtTime(1.1, now);

        oscGain.gain.setValueAtTime(0.0001, now);
        oscGain.gain.linearRampToValueAtTime(noteVol * 0.78, now + 0.012);
        oscGain.gain.exponentialRampToValueAtTime(0.0001, now + duration * 0.70);

        overtoneGain.gain.setValueAtTime(0.0001, now);
        overtoneGain.gain.linearRampToValueAtTime(noteVol * 0.18, now + 0.01);
        overtoneGain.gain.exponentialRampToValueAtTime(0.0001, now + duration * 0.40);
      } else if (type === 'zombie_rave_lead' || type === 'scooby_mystery' || type === 'bloody_synth') {
        // Smooth mellow spooky lead with warm lowpass filter
        osc.type = 'sawtooth';
        overtone.type = 'triangle';
        overtone.frequency.setValueAtTime(freq * 1.003, now);
        filter.frequency.setValueAtTime(Math.min(freq * 2.0, 2800), now);
        filter.Q.setValueAtTime(1.0, now);

        oscGain.gain.setValueAtTime(0.0001, now);
        oscGain.gain.linearRampToValueAtTime(noteVol * 0.65, now + 0.02);
        oscGain.gain.exponentialRampToValueAtTime(0.0001, now + duration * 0.60);

        overtoneGain.gain.setValueAtTime(0.0001, now);
        overtoneGain.gain.linearRampToValueAtTime(noteVol * 0.16, now + 0.02);
        overtoneGain.gain.exponentialRampToValueAtTime(0.0001, now + duration * 0.40);
      } else if (type === 'abyss_bubble') {
        // Aquatic bubbly marimba with pitch envelope
        osc.type = 'sine';
        overtone.type = 'triangle';
        osc.frequency.setValueAtTime(freq * 1.08, now);
        osc.frequency.exponentialRampToValueAtTime(freq, now + 0.04);
        filter.frequency.setValueAtTime(freq * 1.8, now);

        oscGain.gain.setValueAtTime(0.0001, now);
        oscGain.gain.linearRampToValueAtTime(noteVol * 0.75, now + 0.01);
        oscGain.gain.exponentialRampToValueAtTime(0.0001, now + duration * 0.55);

        overtoneGain.gain.setValueAtTime(0.0001, now);
        overtoneGain.gain.linearRampToValueAtTime(noteVol * 0.15, now + 0.01);
        overtoneGain.gain.exponentialRampToValueAtTime(0.0001, now + duration * 0.25);
      } else if (type === 'vesak_flute') {
        // Serene Eastern Bamboo Flute & Meditation Bells
        osc.type = 'sine';
        overtone.type = 'triangle';
        overtone.frequency.setValueAtTime(freq * 2.0, now);
        filter.frequency.setValueAtTime(freq * 2.2, now);
        filter.Q.setValueAtTime(0.8, now);

        oscGain.gain.setValueAtTime(0.0001, now);
        oscGain.gain.linearRampToValueAtTime(noteVol * 0.75, now + 0.04);
        oscGain.gain.exponentialRampToValueAtTime(0.0001, now + duration * 0.85);

        overtoneGain.gain.setValueAtTime(0.0001, now);
        overtoneGain.gain.linearRampToValueAtTime(noteVol * 0.18, now + 0.03);
        overtoneGain.gain.exponentialRampToValueAtTime(0.0001, now + duration * 0.50);
      } else if (type === 'flute_glock') {
        // Celtic flute / glockenspiel
        osc.type = 'triangle';
        overtone.type = 'sine';
        overtone.frequency.setValueAtTime(freq * 2.0, now);
        filter.frequency.setValueAtTime(freq * 2.2, now);

        oscGain.gain.setValueAtTime(0.0001, now);
        oscGain.gain.linearRampToValueAtTime(noteVol * 0.70, now + 0.02);
        oscGain.gain.exponentialRampToValueAtTime(0.0001, now + duration * 0.75);

        overtoneGain.gain.setValueAtTime(0.0001, now);
        overtoneGain.gain.linearRampToValueAtTime(noteVol * 0.16, now + 0.015);
        overtoneGain.gain.exponentialRampToValueAtTime(0.0001, now + duration * 0.35);
      } else {
        // Default ice bell / marimba
        osc.type = 'sine';
        overtone.type = 'sine';
        overtone.frequency.setValueAtTime(freq * 2.76, now);
        filter.frequency.setValueAtTime(Math.min(freq * 2.4, 4200), now);

        oscGain.gain.setValueAtTime(0.0001, now);
        oscGain.gain.linearRampToValueAtTime(noteVol * 0.75, now + 0.015);
        oscGain.gain.exponentialRampToValueAtTime(0.0001, now + duration);

        overtoneGain.gain.setValueAtTime(0.0001, now);
        overtoneGain.gain.linearRampToValueAtTime(noteVol * 0.18, now + 0.01);
        overtoneGain.gain.exponentialRampToValueAtTime(0.0001, now + duration * 0.45);
      }

      osc.frequency.setValueAtTime(freq, now);

      osc.connect(oscGain);
      overtone.connect(overtoneGain);

      oscGain.connect(filter);
      overtoneGain.connect(filter);

      filter.connect(targetNode);

      osc.start(now);
      overtone.start(now);

      osc.stop(now + duration + 0.1);
      overtone.stop(now + duration + 0.1);
    }

    // Play synthesized bassline (gentle warm acoustic tone)
    function playBass(freq, duration = 0.22, volume = 0.055) {
      if (!audioCtx || !masterGain || freq <= 0) return;
      const targetNode = compressor || masterGain;
      const now = audioCtx.currentTime;
      const osc = audioCtx.createOscillator();
      const g = audioCtx.createGain();
      const ftr = audioCtx.createBiquadFilter();

      osc.type = 'triangle';
      osc.frequency.setValueAtTime(freq, now);

      ftr.type = 'lowpass';
      ftr.frequency.setValueAtTime(Math.min(freq * 2.0, 350), now);
      ftr.frequency.exponentialRampToValueAtTime(Math.min(freq * 1.1, 200), now + duration);

      g.gain.setValueAtTime(0.0001, now);
      g.gain.linearRampToValueAtTime(volume, now + 0.02);
      g.gain.exponentialRampToValueAtTime(0.0001, now + duration);

      osc.connect(ftr);
      ftr.connect(g);
      g.connect(targetNode);

      osc.start(now);
      osc.stop(now + duration + 0.05);
    }

    // Play synthesized percussive drum hit (soft gentle acoustic taps)
    function playDrum(type, volume = 0.045) {
      if (!audioCtx || !masterGain) return;
      const targetNode = compressor || masterGain;
      const now = audioCtx.currentTime;

      if (type === 'kick') {
        const osc = audioCtx.createOscillator();
        const g = audioCtx.createGain();
        osc.type = 'sine';
        osc.frequency.setValueAtTime(80, now);
        osc.frequency.exponentialRampToValueAtTime(30, now + 0.07);

        g.gain.setValueAtTime(volume * 0.9, now);
        g.gain.exponentialRampToValueAtTime(0.0001, now + 0.10);

        osc.connect(g);
        g.connect(targetNode);
        osc.start(now);
        osc.stop(now + 0.12);
      } else if (type === 'snare' || type === 'clap') {
        const osc = audioCtx.createOscillator();
        const g = audioCtx.createGain();
        osc.type = 'triangle';
        osc.frequency.setValueAtTime(140, now);
        osc.frequency.exponentialRampToValueAtTime(60, now + 0.05);

        g.gain.setValueAtTime(volume * 0.5, now);
        g.gain.exponentialRampToValueAtTime(0.0001, now + 0.08);

        osc.connect(g);
        g.connect(targetNode);
        osc.start(now);
        osc.stop(now + 0.09);
      } else if (type === 'hihat') {
        const osc = audioCtx.createOscillator();
        const g = audioCtx.createGain();
        const ftr = audioCtx.createBiquadFilter();
        osc.type = 'square';
        osc.frequency.setValueAtTime(4500, now);

        ftr.type = 'bandpass';
        ftr.frequency.setValueAtTime(4000, now);

        g.gain.setValueAtTime(volume * 0.25, now);
        g.gain.exponentialRampToValueAtTime(0.0001, now + 0.04);

        osc.connect(ftr);
        ftr.connect(g);
        g.connect(targetNode);
        osc.start(now);
        osc.stop(now + 0.05);
      }
    }

    // Play subtle background chord pad
    function playChord(chordNotes, duration = 3.2) {
      if (!chordNotes || chordNotes.length === 0) return;
      const targetNode = compressor || masterGain;
      chordNotes.forEach(f => {
        if (!audioCtx || !masterGain || f <= 0) return;
        const now = audioCtx.currentTime;
        const osc = audioCtx.createOscillator();
        const g = audioCtx.createGain();
        const ftr = audioCtx.createBiquadFilter();

        osc.type = 'sine';
        osc.frequency.setValueAtTime(f, now);

        ftr.type = 'lowpass';
        ftr.frequency.setValueAtTime(f * 1.5, now);

        g.gain.setValueAtTime(0.0001, now);
        g.gain.linearRampToValueAtTime(0.016, now + 0.20);
        g.gain.exponentialRampToValueAtTime(0.0001, now + duration);

        osc.connect(g);
        g.connect(ftr);
        ftr.connect(targetNode);

        osc.start(now);
        osc.stop(now + duration + 0.1);
      });
    }

    // Step Sequencer Loop
    function tick() {
      if (!isPlaying) return;

      const visualTheme = THEME_MAP[currentThemeKey] || 'holiday';
      const preset = MELODIES[visualTheme] || MELODIES['holiday'];

      // 1. Lead Melody Note
      const notes = preset.notes;
      const noteFreq = notes[currentStep % notes.length];
      const synthType = preset.synthType;

      if (noteFreq > 0) {
        playNote(noteFreq, synthType, 1.4, 0.105);
      }

      // 2. Bassline Track (if defined)
      if (preset.bass && preset.bass.length > 0) {
        const bassFreq = preset.bass[currentStep % preset.bass.length];
        if (bassFreq > 0) {
          playBass(bassFreq, (preset.tempo * 1.2) / 1000, 0.055);
        }
      }

      // 3. Drum Track (if defined)
      if (preset.drums && preset.drums.length > 0) {
        const drumHit = preset.drums[currentStep % preset.drums.length];
        if (drumHit) {
          playDrum(drumHit, 0.045);
        }
      }

      // 4. Chord backing (default every 8 steps, or custom chordInterval per preset)
      const interval = preset.chordInterval || 8;
      if (currentStep % interval === 0 && preset.chords) {
        const chordIdx = Math.floor(currentStep / interval) % preset.chords.length;
        playChord(preset.chords[chordIdx], (preset.tempo * interval) / 1000);
      }

      currentStep++;
      stepTimer = setTimeout(tick, preset.tempo);
    }

    // ── Start / Stop Functions ───────────────────────────────────────────
    let activeAudioEl = null;

    function stopProceduralSynth() {
      clearTimeout(stepTimer);
      stepTimer = null;
      if (masterGain && audioCtx) {
        try {
          masterGain.gain.cancelScheduledValues(audioCtx.currentTime);
          masterGain.gain.setValueAtTime(0.0001, audioCtx.currentTime);
        } catch(e) {}
      }
    }

    function startProceduralSynth() {
      initAudio();
      if (!audioCtx) return;

      if (audioCtx.state === 'suspended') {
        audioCtx.resume();
      }

      if (masterGain) {
        masterGain.gain.cancelScheduledValues(audioCtx.currentTime);
        masterGain.gain.setValueAtTime(0.005, audioCtx.currentTime);
        masterGain.gain.linearRampToValueAtTime(0.11, audioCtx.currentTime + 0.35);
      }

      currentStep = 0;
      clearTimeout(stepTimer);
      tick();
    }

    function startAudio() {
      currentThemeKey = resolveCurrentTheme();
      stopProceduralSynth();

      isPlaying = true;
      updateUI();
      startProceduralSynth();
    }

    function stopAudio() {
      stopProceduralSynth();
      isPlaying = false;
      updateUI();
    }

    function toggleAudio() {
      if (isPlaying) {
        stopAudio();
        try { localStorage.setItem('arcadelab_ambient_audio', 'off'); } catch(e) {}
      } else {
        startAudio();
        try { localStorage.setItem('arcadelab_ambient_audio', 'on'); } catch(e) {}
      }
    }

    function updateUI() {
      const btn = document.getElementById('audio-toggle-btn');
      const eq = document.getElementById('audio-eq-bars');
      const mute = document.getElementById('audio-mute-icon');
      const label = document.getElementById('audio-status-label');

      const visualTheme = THEME_MAP[currentThemeKey] || 'holiday';
      const preset = MELODIES[visualTheme] || MELODIES['holiday'];

      if (isPlaying) {
        if (eq) { eq.classList.remove('hidden'); eq.classList.add('flex'); }
        if (mute) mute.classList.add('hidden');
        if (label) label.textContent = preset.title || 'Music On';
        if (btn) btn.classList.add('border-[var(--color-brand)]');
      } else {
        if (eq) { eq.classList.add('hidden'); eq.classList.remove('flex'); }
        if (mute) mute.classList.remove('hidden');
        if (label) label.textContent = 'Music Off';
        if (btn) btn.classList.remove('border-[var(--color-brand)]');
      }
    }

    // ── Setup Listeners ──────────────────────────────────────────────────
    function setupAudioWidget() {
      const btn = document.getElementById('audio-toggle-btn');
      if (btn && !btn._bound) {
        btn._bound = true;
        btn.addEventListener('click', (e) => {
          e.stopPropagation();
          toggleAudio();
        });
      }

      currentThemeKey = resolveCurrentTheme();
      updateUI();

      // Auto-resume if user left it on
      try {
        const pref = localStorage.getItem('arcadelab_ambient_audio');
        if (pref === 'on') {
          const unlockHandler = () => {
            if (!isPlaying) startAudio();
            window.removeEventListener('click', unlockHandler);
            window.removeEventListener('keydown', unlockHandler);
          };
          window.addEventListener('click', unlockHandler, { once: true });
          window.addEventListener('keydown', unlockHandler, { once: true });
        }
      } catch(e) {}

      // Listen for seasonal theme changes
      window.addEventListener('arcadelab-theme-change', (e) => {
        const newKey = e.detail && e.detail.themeKey;
        if (newKey && newKey !== currentThemeKey) {
          currentThemeKey = newKey;
          if (isPlaying) {
            startAudio();
          } else {
            updateUI();
          }
        }
      });
    }

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', setupAudioWidget);
    } else {
      setupAudioWidget();
    }
  })();
</script>
